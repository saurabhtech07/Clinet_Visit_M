@model ClientVisitManagement.Models.DailyReportViewModel
@{
    var grid = Model.Grid;
    bool showActions = Model.IsUserSummary || grid.Columns.Contains("DailyReportId");
    int start = grid.TotalRecords == 0 ? 0 : ((grid.CurrentPage - 1) * grid.PageSize) + 1;
    int end = Math.Min(grid.CurrentPage * grid.PageSize, grid.TotalRecords);
    int sr = start;

    string BuildUrl(int page, int pageSize, string? sort, string? dir)
    {
        var q = new List<string> { "page=" + page, "pageSize=" + pageSize };
        if (!string.IsNullOrWhiteSpace(grid.SearchTerm)) q.Add("search=" + Uri.EscapeDataString(grid.SearchTerm));
        if (Model.FilterAssignedTo.HasValue) q.Add("assignedTo=" + Model.FilterAssignedTo.Value);
        if (Model.FilterFrom.HasValue) q.Add("fromDate=" + Model.FilterFrom.Value.ToString("yyyy-MM-dd"));
        if (Model.FilterTo.HasValue) q.Add("toDate=" + Model.FilterTo.Value.ToString("yyyy-MM-dd"));
        if (!string.IsNullOrWhiteSpace(sort)) q.Add("sort=" + Uri.EscapeDataString(sort));
        if (!string.IsNullOrWhiteSpace(dir)) q.Add("direction=" + dir);
        return "/DailyReport?" + string.Join("&", q);
    }

    string DisplayName(string col) => col switch
    {
        "DailyReportId" => "Id",
        "ReportDate" => "Date",
        "AssignedName" => "Assigned To",
        "AssignedTo" => "Assigned To",
        "Visit" => "Visits",
        "NewLeads" => "New Leads",
        "TotalFollowUp" => "Total Follow Up",
        "InterestedLeads" => "Interested Leads",
        "ConvertedLeads" => "Converted Leads",
        "Summary" => "Work Summary",
        "Remark" => "Issues / Concerns",
        "EntryTime" => "Entry Time",
        "ModifiedOn" => "Modified On",
        "CreatedBy" => "Created By",
        _ => System.Text.RegularExpressions.Regex.Replace(col, "([a-z])([A-Z])", "$1 $2")
    };

    string Fmt(object? val)
    {
        if (val == null) return "";
        if (val is DateTime dt) return dt.TimeOfDay == TimeSpan.Zero ? dt.ToString("dd-MM-yyyy") : dt.ToString("dd-MM-yyyy hh:mm tt");
        if (val is decimal dc) return dc.ToString("N2");
        if (val is bool b) return b ? "Yes" : "No";
        return val.ToString() ?? "";
    }

    bool IsNumCol(string col) => col is "Calls" or "Visit" or "NewLeads" or "TotalFollowUp" or "InterestedLeads" or "ConvertedLeads";

    string NumBg(string col) => col switch
    {
        "NewLeads" => "background:#eef2ff;color:#4338ca;",
        "TotalFollowUp" => "background:#e0f2fe;color:#0369a1;",
        "InterestedLeads" => "background:#fef3c7;color:#b45309;",
        "ConvertedLeads" => "background:#dcfce7;color:#15803d;",
        _ => "background:#f1f5f9;color:#0f172a;"
    };
}

<style>
    /* Koi inner scroll nahi — poora table page par fit hota hai */
    .table-scroll-container { position: relative; }
    .drp-table thead th {
        position: sticky; top: 0; z-index: 10;
        font-size: 10px; font-weight: 700; letter-spacing: 0.3px;
        color: #64748b; text-transform: uppercase;
        background: #f8fafc !important;
        border-bottom: 1px solid #e2e8f0;
        padding: 7px 8px; white-space: normal; line-height: 1.15;
        box-shadow: 0 1px 0 #e2e8f0;
    }
    .drp-table tbody td { font-size: 12.5px; padding: 5px 8px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; background: #fff; overflow: hidden; }
    .drp-id-pill { background: #1e293b; color: #fff; padding: 2px 7px; border-radius: 6px; font-size: 10px; font-weight: 600; }
    .table-sort-link { color: #475569 !important; text-decoration: none; }
    .table-sort-link:hover { color: #0f172a !important; }
    .drp-grid-table { border-collapse: separate; border-spacing: 0; width: 100%; }
    .cell-clip { display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }
    .num-pill { display:inline-block; min-width:30px; text-align:center; padding:2px 8px; border-radius:7px; font-size:11.5px; font-weight:700; }
    .act-btn { width: 24px; height: 24px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 7px; font-size: 12px; }
    .drp-table tbody td.actions-cell { white-space: nowrap; }
    .drp-table tfoot td {
        background: #f8fafc; border-top: 1px solid #e2e8f0;
        font-size: 12px; padding: 6px 10px; position: sticky; bottom: 0; z-index: 9;
        box-shadow: 0 -1px 0 #e2e8f0;
    }
</style>

<div class="table-scroll-container">
    <table class="table mb-0 drp-table table-hover drp-grid-table">
        <thead>
            <tr>
                <th style="width:46px;">Sr.No</th>
                @foreach (var col in grid.Columns)
                {
                    var nextDir = (grid.SortColumn == col && grid.SortDirection == "ASC") ? "DESC" : "ASC";
                    <th>
                        <a class="table-sort-link ajax-dr-link" href="@BuildUrl(1, grid.PageSize, col, nextDir)">
                            @DisplayName(col)
                            @if (grid.SortColumn == col)
                            {
                                <i class="bi @(grid.SortDirection == "ASC" ? "bi-arrow-up" : "bi-arrow-down") ms-1"></i>
                            }
                            else
                            {
                                <i class="bi bi-arrow-down-up ms-1" style="opacity:0.3; font-size:11px;"></i>
                            }
                        </a>
                    </th>
                }
                @if (showActions)
                {
                    <th class="actions-col" style="width:90px;">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (grid.Rows.Any())
            {
                foreach (var row in grid.Rows)
                {
                    var id = row.ContainsKey("DailyReportId") ? row["DailyReportId"]?.ToString() : "";

                    <tr>
                        <td style="color:#64748b;">@sr</td>
                        @foreach (var col in grid.Columns)
                        {
                            object? val = row.ContainsKey(col) ? row[col] : null;
                            if (col == "DailyReportId")
                            {
                                <td><span class="drp-id-pill">@val</span></td>
                            }
                            else if (IsNumCol(col))
                            {
                                var n = val == null ? "0" : val.ToString();
                                <td><span class="num-pill" style="@NumBg(col)">@n</span></td>
                            }
                            else if (col == "AssignedName")
                            {
                                var t = Fmt(val);
                                <td class="fw-semibold" style="color:#0f172a;"><span class="cell-clip" title="@t">@t</span></td>
                            }
                            else
                            {
                                var t = Fmt(val);
                                <td><span class="cell-clip" title="@t">@t</span></td>
                            }
                        }
                        @if (showActions)
                        {
                            <td class="actions-cell">
                                @if (Model.IsUserSummary)
                                {
                                    var uid = row.ContainsKey("UserId") ? row["UserId"]?.ToString() : "";
                                    var dayVal = row.ContainsKey("ReportDate") ? row["ReportDate"] : null;
                                    var dayStr = dayVal is DateTime drow
                                        ? drow.ToString("yyyy-MM-dd")
                                        : (!string.IsNullOrWhiteSpace(dayVal?.ToString())
                                            ? Convert.ToDateTime(dayVal).ToString("yyyy-MM-dd")
                                            : Model.SummaryDay.ToString("yyyy-MM-dd"));
                                    var viewUrl = "/DailyReport/UserDetails?userId=" + uid + "&date=" + dayStr;
                                    <a href="@viewUrl" class="btn btn-light border act-btn dr-view-btn" data-url="@viewUrl" title="View"><i class="bi bi-eye"></i></a>
                                }
                                else
                                {
                                    <a href="/DailyReport/Details/@id" class="btn btn-light border act-btn dr-view-btn" data-id="@id" title="View"><i class="bi bi-eye"></i></a>
                                }
                            </td>
                        }
                    </tr>
                    sr++;
                }
            }
            else
            {
                <tr><td colspan="@(grid.Columns.Count + (showActions ? 2 : 1))" class="text-center text-muted py-5">No records found</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center p-2 border-top bg-white" style="border-radius:0 0 14px 14px;">
    <div class="d-flex align-items-center gap-2">
        <select id="drPageSize" class="form-select form-select-sm" style="width:70px; border-radius:8px;">
            <option value="10" selected="@(grid.PageSize == 10)">10</option>
            <option value="20" selected="@(grid.PageSize == 20)">20</option>
            <option value="50" selected="@(grid.PageSize == 50)">50</option>
            <option value="100" selected="@(grid.PageSize == 100)">100</option>
        </select>
        <span style="font-size:12px; color:#64748b;">records per page</span>
    </div>
    <div style="font-size:12px; color:#64748b;">Showing @start to @end of @grid.TotalRecords entries</div>
    <div class="d-flex gap-1">
        @if (grid.CurrentPage > 1)
        {
            <a class="btn btn-sm btn-light border ajax-dr-link" href="@BuildUrl(grid.CurrentPage - 1, grid.PageSize, grid.SortColumn, grid.SortDirection)">Previous</a>
        }
        else
        {
            <button class="btn btn-sm btn-light border" disabled>Previous</button>
        }
        @for (int p = 1; p <= grid.TotalPages; p++)
        {
            if (p == grid.CurrentPage)
            {
                <span class="btn btn-sm" style="background:#0f172a; color:#fff;">@p</span>
            }
            else
            {
                <a class="btn btn-sm btn-light border ajax-dr-link" href="@BuildUrl(p, grid.PageSize, grid.SortColumn, grid.SortDirection)">@p</a>
            }
        }
        @if (grid.CurrentPage < grid.TotalPages)
        {
            <a class="btn btn-sm btn-light border ajax-dr-link" href="@BuildUrl(grid.CurrentPage + 1, grid.PageSize, grid.SortColumn, grid.SortDirection)">Next</a>
        }
        else
        {
            <button class="btn btn-sm btn-light border" disabled>Next</button>
        }
    </div>
</div>
