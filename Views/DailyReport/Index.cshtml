@model ClientVisitManagement.Models.DailyReportViewModel
@{
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }

    var statusOptions = DailyReportViewModel.StatusOptions;

    var fStatus = Model.FilterStatus;
    var fAssignedTo = Model.FilterAssignedTo;
    var fFrom = Model.FilterFrom?.ToString("yyyy-MM-dd");
    var fTo = Model.FilterTo?.ToString("yyyy-MM-dd");
}

<style>
    .drp-kpi-card{background:#fff;border-radius:12px;border:1px solid #eef2f7;padding:12px 14px;height:76px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 1px 2px rgba(0,0,0,0.04)}
    .drp-kpi-label{font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;margin-bottom:2px;letter-spacing:0.5px}
    .drp-kpi-value{font-size:22px;font-weight:800;color:#0f172a;line-height:1}
    .drp-kpi-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:16px;flex-shrink:0}
    .drp-toolbar{background:#fff;border-radius:14px;border:1px solid #eef2f7;padding:14px 18px}
    .drp-input{height:36px;font-size:13px;border-radius:9px;background:#f8fafc;border:1px solid #e2e8f0}
    .drp-input:focus{background:#fff;border-color:#cbd5e1;box-shadow:none}
    .drp-search{position:relative}
    .drp-search i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:14px}
    .drp-search input{padding-left:34px}
    .drp-date{display:flex;align-items:center;gap:5px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:9px;padding:0 9px;height:36px}
    .drp-date span{font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase}
    .drp-date input{border:0;background:transparent;font-size:12.5px;color:#0f172a;outline:none;width:106px}
    .drp-table-card{background:#fff;border-radius:14px;border:1px solid #eef2f7;overflow:hidden}
    .btn-drp-dark{background:#0f172a;color:#fff;border-radius:10px;font-size:13px;padding:9px 16px}
    @@media print{
      .drp-kpi-card,.drp-toolbar,.drp-date,.drp-search{display:none!important}
      .drp-table-card{border:none;overflow:visible!important}
      .table-scroll-container{max-height:none!important;overflow:visible!important;height:auto!important}
      .drp-table thead th{position:static!important}
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">Daily Report</h4>
    <a href="/DailyReport/Create" class="btn btn-drp-dark"><i class="bi bi-plus-circle me-1"></i> Add Daily Report</a>
</div>
@Html.AntiForgeryToken()

<!-- 4 CARDS -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="drp-kpi-card">
            <div>
                <div class="drp-kpi-label">Total Reports</div>
                <div class="drp-kpi-value">@Model.TotalReports</div>
            </div>
            <div class="drp-kpi-icon" style="background:#2563eb;"><i class="bi bi-clipboard-data-fill"></i></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="drp-kpi-card">
            <div>
                <div class="drp-kpi-label">Total Calls</div>
                <div class="drp-kpi-value">@Model.TotalCalls</div>
            </div>
            <div class="drp-kpi-icon" style="background:#3b82f6;"><i class="bi bi-telephone-fill"></i></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="drp-kpi-card">
            <div>
                <div class="drp-kpi-label">Total Visits</div>
                <div class="drp-kpi-value">@Model.TotalVisits</div>
            </div>
            <div class="drp-kpi-icon" style="background:#10b981;"><i class="bi bi-signpost-split-fill"></i></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="drp-kpi-card">
            <div>
                <div class="drp-kpi-label">New Leads</div>
                <div class="drp-kpi-value" style="color:#4338ca;">@Model.TotalNewLeads</div>
            </div>
            <div class="drp-kpi-icon" style="background:#8b5cf6;"><i class="bi bi-person-plus-fill"></i></div>
        </div>
    </div>
</div>

<!-- FILTER TOOLBAR -->
<div class="drp-toolbar mb-3">
    <div class="row g-2">
        <div class="col-md-6">
            <div class="drp-search">
                <i class="bi bi-search"></i>
                <input type="text" id="drSearch" value="@Model.Grid.SearchTerm" class="form-control drp-input" placeholder="Search summary / remark / user..." autocomplete="off" />
            </div>
        </div>
        <div class="col-md-3">
            <select id="drStatus" class="form-select drp-input" title="Status">
                <option value="">All Status</option>
                @foreach (var s in statusOptions)
                {
                    <option value="@s" selected="@(fStatus == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select id="drAssigned" class="form-select drp-input" title="Assigned To">
                <option value="">All Users</option>
                @foreach (var u in Model.Users)
                {
                    var nm = string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName;
                    <option value="@u.UserId" selected="@(fAssignedTo.HasValue && fAssignedTo.Value == u.UserId)">@nm</option>
                }
            </select>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
        <div class="drp-date" title="Report Date — From">
            <span>From</span>
            <input type="date" id="drFrom" value="@fFrom" />
        </div>
        <div class="drp-date" title="Report Date — To">
            <span>To</span>
            <input type="date" id="drTo" value="@fTo" />
        </div>

        <button id="drClear" class="btn btn-light border" style="border-radius:9px; font-size:13px; height:36px;">
            <i class="bi bi-x-circle me-1"></i>Clear
        </button>

        <div class="ms-auto">
            <div class="dropdown">
                <button class="btn btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                        style="border-radius:9px; font-size:13px; height:36px;">
                    <i class="bi bi-download me-1"></i> Export
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li><a id="drExport" class="dropdown-item" href="/DailyReport/ExportExcel"><i class="bi bi-file-earmark-excel me-2 text-success"></i>Excel</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="javascript:void(0);" onclick="window.print();"><i class="bi bi-printer me-2"></i>Print</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- TABLE -->
<div class="drp-table-card">
    <div id="drTable">
        @await Html.PartialAsync("_DailyReportTable", Model)
    </div>
</div>

<script>
    (function () {
        function el(id) { return document.getElementById(id); }

        function buildUrl(page) {
            var p = new URLSearchParams();
            p.append("page", page);
            p.append("pageSize", (el("drPageSize") && el("drPageSize").value) || 10);
            var s = el("drSearch"); if (s && s.value.trim()) p.append("search", s.value.trim());
            var st = el("drStatus"); if (st && st.value) p.append("status", st.value);
            var as = el("drAssigned"); if (as && as.value) p.append("assignedTo", as.value);
            var fd = el("drFrom"); if (fd && fd.value) p.append("fromDate", fd.value);
            var td = el("drTo"); if (td && td.value) p.append("toDate", td.value);
            return "/DailyReport?" + p.toString();
        }

        function updateExport() {
            var ex = el("drExport");
            if (ex) ex.href = "/DailyReport/ExportExcel" + buildUrl(1).substring("/DailyReport".length);
        }

        function loadTable(url) {
            fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                .then(function (r) { if (!r.ok) throw new Error("Failed to load daily reports."); return r.text(); })
                .then(function (html) {
                    var t = el("drTable");
                    if (t) t.innerHTML = html;
                    updateExport();
                })
                .catch(function (e) { console.error("Daily report table error:", e); });
        }

        window.refreshCurrentTable = function () { loadTable(buildUrl(1)); };

        window.drMarkDone = function (id, btn) {
            if (btn) btn.disabled = true;
            Ajax.post("/DailyReport/MarkDone/" + id, new FormData())
                .then(function (d) {
                    Ajax.toast(d.message || "Report done.", "success");
                    loadTable(buildUrl(1));
                })
                .catch(function (e) { if (btn) btn.disabled = false; Ajax.toast(e.message, "error"); });
        };

        // Delegated handlers only once (AJAX-nav safe)
        window.__drNav = window.__drNav || {};
        if (!window.__drNav.delegates) {
            window.__drNav.delegates = true;

            document.addEventListener("click", function (e) {
                var link = e.target.closest(".ajax-dr-link");
                if (!link) return;
                e.preventDefault();
                loadTable(link.getAttribute("href"));
            });

            document.addEventListener("change", function (e) {
                if (e.target.id !== "drPageSize") return;
                loadTable(buildUrl(1));
            });
        }

        var timer = null;
        var search = el("drSearch");
        if (search) {
            search.addEventListener("input", function () {
                clearTimeout(timer);
                timer = setTimeout(function () { loadTable(buildUrl(1)); }, 300);
            });
        }

        ["drStatus", "drAssigned", "drFrom", "drTo"].forEach(function (id) {
            var node = el(id);
            if (node) node.addEventListener("change", function () { loadTable(buildUrl(1)); });
        });

        var clear = el("drClear");
        if (clear) {
            clear.addEventListener("click", function () {
                ["drSearch", "drStatus", "drAssigned", "drFrom", "drTo"].forEach(function (id) {
                    var node = el(id);
                    if (node) node.value = "";
                });
                loadTable(buildUrl(1));
            });
        }

        updateExport();
    })();
</script>
