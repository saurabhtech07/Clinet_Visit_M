@model ClientVisitManagement.Models.DailyReportViewModel
@{
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }

    var fAssignedTo = Model.FilterAssignedTo;
}

<style>
    .drp-kpi-card{background:#fff;border-radius:10px;border:1px solid #eef2f7;padding:8px 12px;height:60px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 1px 2px rgba(0,0,0,0.04)}
    .drp-kpi-label{font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;margin-bottom:1px;letter-spacing:0.4px}
    .drp-kpi-value{font-size:18px;font-weight:800;color:#0f172a;line-height:1}
    .drp-kpi-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;flex-shrink:0}
    .drp-toolbar{background:#fff;border-radius:12px;border:1px solid #eef2f7;padding:10px 12px}
    .drp-input{height:32px;font-size:12.5px;border-radius:9px;background:#f8fafc;border:1px solid #e2e8f0;padding-top:4px;padding-bottom:4px}
    .drp-input:focus{background:#fff;border-color:#cbd5e1;box-shadow:none}
    .drp-search{position:relative}
    .drp-search i{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:13px}
    .drp-search input{padding-left:30px}
    .drp-date{display:flex;align-items:center;gap:5px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:9px;padding:0 8px;height:32px}
    .drp-date span{font-size:9.5px;font-weight:700;color:#64748b;text-transform:uppercase}
    .drp-date input{border:0;background:transparent;font-size:12px;color:#0f172a;outline:none;width:100px}
    .drp-table-card{background:#fff;border-radius:12px;border:1px solid #eef2f7;overflow:hidden}
    .btn-drp-dark{background:#0f172a;color:#fff;border-radius:10px;font-size:13px;padding:9px 16px}
    @@media print{
      .drp-kpi-card,.drp-toolbar,.drp-date,.drp-search{display:none!important}
      .drp-table-card{border:none;overflow:visible!important}
      .table-scroll-container{max-height:none!important;overflow:visible!important;height:auto!important}
      .drp-table thead th{position:static!important}
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="fw-bold mb-0">Daily Report</h4>
</div>
@Html.AntiForgeryToken()

<!-- CARDS -->
<div class="row g-2 mb-2">
    <div class="col-6 col-md-4">
        <div class="drp-kpi-card">
            <div>
                <div class="drp-kpi-label">Total Leads</div>
                <div class="drp-kpi-value">@Model.TotalLeads</div>
            </div>
            <div class="drp-kpi-icon" style="background:#2563eb;"><i class="bi bi-person-lines-fill"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="drp-kpi-card">
            <div>
                <div class="drp-kpi-label">Total Leads Today</div>
                <div class="drp-kpi-value" style="color:#7c3aed;">@Model.TotalLeadsToday</div>
            </div>
            <div class="drp-kpi-icon" style="background:#7c3aed;"><i class="bi bi-lightning-charge-fill"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="drp-kpi-card">
            <div>
                <div class="drp-kpi-label">Total Follow Up (Today)</div>
                <div class="drp-kpi-value" style="color:#0369a1;">@Model.TotalFollowUps</div>
            </div>
            <div class="drp-kpi-icon" style="background:#0ea5e9;"><i class="bi bi-arrow-repeat"></i></div>
        </div>
    </div>
</div>

<!-- FILTER TOOLBAR (compact single row) -->
<div class="drp-toolbar mb-2">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="drp-search" style="flex:1 1 220px; min-width:180px;">
            <i class="bi bi-search"></i>
            <input type="text" id="drSearch" value="@Model.Grid.SearchTerm" class="form-control drp-input" placeholder="Search user..." autocomplete="off" />
        </div>

        <select id="drAssigned" class="form-select drp-input" style="width:170px;" title="Assigned To">
            <option value="">All Users</option>
            @foreach (var u in Model.Users)
            {
                var nm = string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName;
                <option value="@u.UserId" selected="@(fAssignedTo.HasValue && fAssignedTo.Value == u.UserId)">@nm</option>
            }
        </select>

        <button id="drClear" class="btn btn-light border" style="border-radius:9px; font-size:12.5px; height:32px;">
            <i class="bi bi-x-circle me-1"></i>Clear
        </button>

        <div class="dropdown ms-auto">
            <button class="btn btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                    style="border-radius:9px; font-size:12.5px; height:32px;">
                <i class="bi bi-download me-1"></i> Export
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a id="drExport" class="dropdown-item" href="/DailyReport/ExportExcel"><i class="bi bi-file-earmark-excel me-2 text-success"></i>Excel</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="javascript:void(0);" onclick="window.printTable('drTable','Daily Report');"><i class="bi bi-printer me-2"></i>Print</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- TABLE -->
<div class="drp-table-card">
    <div id="drTable">
        @await Html.PartialAsync("_DailyReportTable", Model)
    </div>
</div>

<!-- VIEW POPUP -->
<div class="modal fade" id="drViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="drViewModalContent"></div>
    </div>
</div>

<script>
    (function () {
        function el(id) { return document.getElementById(id); }

        function buildUrl(page) {
            var p = new URLSearchParams();
            p.append("page", page);
            p.append("pageSize", (el("drPageSize") && el("drPageSize").value) || 10);
            var s = el("drSearch"); if (s && s.value.trim()) p.append("search", s.value.trim());
            var as = el("drAssigned"); if (as && as.value) p.append("assignedTo", as.value);
            return "/DailyReport?" + p.toString();
        }

        function updateExport() {
            var ex = el("drExport");
            if (ex) ex.href = "/DailyReport/ExportExcel" + buildUrl(1).substring("/DailyReport".length);
        }

        function loadTable(url) {
            fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                .then(function (r) { if (!r.ok) throw new Error("Failed to load daily reports."); return r.text(); })
                .then(function (html) {
                    var t = el("drTable");
                    if (t) t.innerHTML = html;
                    updateExport();
                })
                .catch(function (e) { console.error("Daily report table error:", e); });
        }

        window.refreshCurrentTable = function () { loadTable(buildUrl(1)); };

        // Delegated handlers only once (AJAX-nav safe)
        window.__drNav = window.__drNav || {};
        if (!window.__drNav.delegates) {
            window.__drNav.delegates = true;

            document.addEventListener("click", function (e) {
                var link = e.target.closest(".ajax-dr-link");
                if (!link) return;
                e.preventDefault();
                loadTable(link.getAttribute("href"));
            });

            document.addEventListener("click", function (e) {
                var btn = e.target.closest(".dr-view-btn");
                if (!btn) return;
                e.preventDefault();

                var url = btn.getAttribute("data-url") || ("/DailyReport/Details?id=" + encodeURIComponent(btn.getAttribute("data-id") || ""));
                var content = document.getElementById("drViewModalContent");
                var modalEl = document.getElementById("drViewModal");
                if (!content || !modalEl) return;

                content.innerHTML = '<div class="modal-body text-center py-5"><div class="spinner-border text-secondary" role="status"></div><div class="mt-2 small text-muted">Loading report...</div></div>';
                bootstrap.Modal.getOrCreateInstance(modalEl).show();

                fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                    .then(function (r) { if (!r.ok) throw new Error("Failed to load report."); return r.text(); })
                    .then(function (html) { content.innerHTML = html; })
                    .catch(function (err) {
                        content.innerHTML = '<div class="modal-body text-center py-5 text-danger">' + (err && err.message ? err.message : "Failed to load report.") + '</div><div class="modal-footer"><button type="button" class="btn btn-dark" data-bs-dismiss="modal">Close</button></div>';
                    });
            });

            document.addEventListener("change", function (e) {
                if (e.target.id !== "drPageSize") return;
                loadTable(buildUrl(1));
            });
        }

        var timer = null;
        var search = el("drSearch");
        if (search) {
            search.addEventListener("input", function () {
                clearTimeout(timer);
                timer = setTimeout(function () { loadTable(buildUrl(1)); }, 300);
            });
        }

        ["drAssigned"].forEach(function (id) {
            var node = el(id);
            if (node) node.addEventListener("change", function () { loadTable(buildUrl(1)); });
        });

        var clear = el("drClear");
        if (clear) {
            clear.addEventListener("click", function () {
                ["drSearch", "drAssigned"].forEach(function (id) {
                    var node = el(id);
                    if (node) node.value = "";
                });
                loadTable(buildUrl(1));
            });
        }

        updateExport();
    })();
</script>
