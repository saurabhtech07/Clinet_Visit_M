@model DailySupportDashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}
<style>
 .stat-card{border-radius:12px;border:0;box-shadow:0 3px 12px rgba(0,0,0,0.06);}
 .icon-box{width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:white;font-size:17px;}
 .filter-card{border-radius:12px;border:0;box-shadow:0 3px 12px rgba(0,0,0,0.06);}
 .search-box{border-radius:8px;height:38px;font-size:12px;}
 .table-card{border-radius:12px;border:0;box-shadow:0 4px 20px rgba(0,0,0,0.06);overflow:visible;}
 /* SINGLE SCROLLER ONLY - DOUBLE HATA DIYA */
 #tableContainer{
   max-height: none;
   overflow: visible;
 }
 #tableContainer table thead th{
   position: sticky;
   top: 0;
   z-index: 10;
   background: #f8fafc !important;
   color: #475569 !important;
   font-size: 10px;
   font-weight: 700;
   text-transform: uppercase;
   cursor: pointer;
   white-space: nowrap;
   padding: 12px 10px !important;
   border-bottom: 1px solid #e2e8f0 !important;
 }
 #tableContainer table thead th:hover{ background: #f1f5f9 !important; }
 .sort-icon{font-size:11px;margin-left:5px;opacity:0.6}
 th.active .sort-icon{opacity:1}
 /* scrollbar styling - single */
 ::-webkit-scrollbar{ width:8px; height:8px; }
 ::-webkit-scrollbar-thumb{ background:#cbd5e1; border-radius:4px; }
</style>
<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="fw-bold mb-0">Daily Support System</h4>
    <div class="d-flex gap-2">
        <a href="/Client/Create" class="btn btn-light border" style="border-radius:8px;height:38px;font-size:13px;">+ New Customer</a>
        <a href="/DailySupport/Create" class="btn btn-dark px-3" style="border-radius:8px;height:38px;font-size:13px;">+ New Call Entry</a>
    </div>
</div>
<div class="row g-2 mb-3">
    <div class="col-md-3"><div class="card stat-card"><div class="card-body d-flex justify-content-between align-items-center p-3"><div><p class="text-muted mb-1" style="font-size:9px;font-weight:700;">TODAY CALLS</p><h4>@Model.TodayCalls</h4><small class="text-muted" style="font-size:10px;">Total @Model.TotalCalls calls</small></div><div class="icon-box" style="background:#f59e0b;"><i class="bi bi-telephone-fill"></i></div></div></div></div>
    <div class="col-md-3"><div class="card stat-card"><div class="card-body d-flex justify-content-between align-items-center p-3"><div><p class="text-muted mb-1" style="font-size:9px;font-weight:700;">OPEN CALLS</p><h4 class="text-danger">@Model.OpenCalls</h4><small class="text-danger" style="font-size:10px;">Need action</small></div><div class="icon-box" style="background:#ef4444;"><i class="bi bi-exclamation-circle-fill"></i></div></div></div></div>
    <div class="col-md-3"><div class="card stat-card"><div class="card-body d-flex justify-content-between align-items-center p-3"><div><p class="text-muted mb-1" style="font-size:9px;font-weight:700;">CLOSED TODAY</p><h4 class="text-success">@Model.ClosedToday</h4><small class="text-success" style="font-size:10px;">Done today</small></div><div class="icon-box" style="background:#10b981;"><i class="bi bi-check-circle-fill"></i></div></div></div></div>
    <div class="col-md-3"><div class="card stat-card"><div class="card-body d-flex justify-content-between align-items-center p-3"><div><p class="text-muted mb-1" style="font-size:9px;font-weight:700;">PENDING</p><h4 style="color:#8b5cf6;">@Model.PendingCalls</h4><small class="text-muted" style="font-size:10px;">In Progress</small></div><div class="icon-box" style="background:#8b5cf6;"><i class="bi bi-hourglass-split"></i></div></div></div></div>
</div>
<div class="card filter-card mb-3"><div class="card-body p-3"><div class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label" style="font-size:10px;font-weight:700;color:#64748b;">SEARCH TICKET / CUSTOMER / MOBILE</label><div class="input-group"><span class="input-group-text bg-white border-end-0" style="border-radius:8px 0 0 8px;"><i class="bi bi-search"></i></span><input type="text" id="dssSearch" value="@Model.SearchTerm" class="form-control border-start-0 search-box" placeholder="Ticket, customer, mobile..." /></div></div><div class="col-md-2"><label class="form-label" style="font-size:10px;font-weight:700;color:#64748b;">FROM DATE</label><input type="date" id="fromDate" value="@Model.FromDate" class="form-control search-box" /></div><div class="col-md-2"><label class="form-label" style="font-size:10px;font-weight:700;color:#64748b;">TO DATE</label><input type="date" id="toDate" value="@Model.ToDate" class="form-control search-box" /></div>
<div class="col-md-3 d-flex justify-content-end gap-2 align-items-end">
<a href="/DailySupport" class="btn btn-light border px-4" style="border-radius:8px;height:38px;font-size:13px;">Clear</a>
<div class="dropdown">
<button class="btn btn-dark dropdown-toggle px-3" style="border-radius:8px;height:38px;font-size:13px;" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-download me-1"></i> Export</button>
<ul class="dropdown-menu dropdown-menu-end">
<li><a class="dropdown-item" href="#" onclick="exportPrint()" style="font-size:13px"><i class="bi bi-printer me-2"></i>Print</a></li>
<li><a class="dropdown-item" href="#" onclick="exportCSV()" style="font-size:13px"><i class="bi bi-filetype-csv me-2"></i>CSV</a></li>
<li><a class="dropdown-item" href="#" onclick="exportExcel()" style="font-size:13px"><i class="bi bi-file-earmark-excel me-2"></i>Excel</a></li>
</ul>
</div>
</div></div></div></div>
<div class="card table-card"><div id="tableContainer">@await Html.PartialAsync("_CallTable", Model.TicketTable)</div></div>

<script>
function loadTable(){
  var s=document.getElementById('dssSearch').value;
  var f=document.getElementById('fromDate').value;
  var t=document.getElementById('toDate').value;
  fetch(`/DailySupport/Index?search=${s}&fromDate=${f}&toDate=${t}`,{headers:{'X-Requested-With':'XMLHttpRequest'}})
  .then(r=>r.text()).then(h=>{document.getElementById('tableContainer').innerHTML=h; attachSorting();});
}
document.getElementById('dssSearch')?.addEventListener('keyup',loadTable);
document.getElementById('fromDate')?.addEventListener('change',loadTable);
document.getElementById('toDate')?.addEventListener('change',loadTable);
var sortState={};
function attachSorting(){
  const table=document.querySelector("#tableContainer table"); if(!table) return;
  const ths=table.querySelectorAll("thead th");
  ths.forEach((th,idx)=>{
    if(th.innerText.trim().toLowerCase()==='action') return;
    if(!th.querySelector(".sort-icon")) th.innerHTML=th.innerText+' <span class="sort-icon">↕</span>';
    th.onclick=function(){
      let dir=sortState[idx]==='asc'?'desc':'asc'; sortState[idx]=dir;
      ths.forEach(x=>{x.classList.remove('active'); let ic=x.querySelector('.sort-icon'); if(ic) ic.textContent='↕';});
      th.classList.add('active'); th.querySelector('.sort-icon').textContent=dir==='asc'?'↑':'↓';
      let tbody=table.tBodies[0]; let rows=Array.from(tbody.rows);
      rows.sort((a,b)=>{
        let aVal=a.cells[idx]?.innerText.trim().toLowerCase()||''; let bVal=b.cells[idx]?.innerText.trim().toLowerCase()||'';
        let aNum=parseFloat(aVal), bNum=parseFloat(bVal);
        if(!isNaN(aNum)&&!isNaN(bNum)) return dir==='asc'?aNum-bNum:bNum-aNum;
        let aDate=Date.parse(aVal), bDate=Date.parse(bVal);
        if(!isNaN(aDate)&&!isNaN(bDate)) return dir==='asc'?aDate-bDate:bDate-aDate;
        return dir==='asc'?aVal.localeCompare(bVal):bVal.localeCompare(aVal);
      });
      rows.forEach(r=>tbody.appendChild(r));
    };
  });
}
attachSorting();
function getTable(){return document.querySelector("#tableContainer table");}
function exportCSV(){let table=getTable(); if(!table) return; let csv=[]; table.querySelectorAll("tr").forEach(tr=>{let row=[]; tr.querySelectorAll("th,td").forEach(td=>{if(td.innerText.trim().toLowerCase()==='action') return; row.push('"'+td.innerText.replace(/"/g,'""')+'"');}); if(row.length) csv.push(row.join(","));}); let blob=new Blob([csv.join("\n")],{type:"text/csv"}); let a=document.createElement("a"); a.href=URL.createObjectURL(blob); a.download="DailySupport_"+new Date().toISOString().slice(0,10)+".csv"; a.click();}
function exportExcel(){let table=getTable(); if(!table) return; let blob=new Blob(['\ufeff'+table.outerHTML],{type:"application/vnd.ms-excel"}); let a=document.createElement("a"); a.href=URL.createObjectURL(blob); a.download="DailySupport_"+new Date().toISOString().slice(0,10)+".xls"; a.click();}
function exportPrint(){let table=getTable(); if(!table) return; let w=window.open("","","width=1100,height=800"); w.document.write("<html><head><title>Daily Support</title><link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'><style>table{font-size:12px} th{position:static !important}</style></head><body class='p-3'><h5>Daily Support - "+new Date().toLocaleDateString()+"</h5>"+table.outerHTML+"</body></html>"); w.document.close(); w.focus(); setTimeout(()=>{w.print(); w.close();},500);}
</script>
