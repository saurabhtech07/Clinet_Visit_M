// ---- Re-Assign: button click -> user dropdown -> confirm ----
(function () {
  var usersCache = null;

  var dssReassignRec = null, dssReassignListening = false;
  function setReassignDictationButton(text) {
    var b = document.getElementById("dssReassignDictationBtn");
    if (b) b.innerHTML = text === "Pause" ? '<i class="bi bi-pause-fill me-1"></i>Pause' : '<i class="bi bi-mic-fill me-1"></i>Speak';
  }
  window.stopReassignDictation = function () {
    if (dssReassignRec) { try { dssReassignRec.stop(); } catch (e) {} }
    dssReassignListening = false;
    setReassignDictationButton("Speak");
  };
  window.toggleReassignDictation = function () {
    var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR) { alert("Voice not supported"); return; }
    var reason = document.getElementById("dssReassignReason");
    if (!reason) return;
    if (!dssReassignListening) {
      dssReassignRec = new SR();
      dssReassignRec.continuous = true;
      dssReassignRec.interimResults = true;
      dssReassignRec.lang = "en-IN";
      dssReassignRec.onresult = function (e) {
        var text = "";
        for (var i = e.resultIndex; i < e.results.length; i++) {
          if (e.results[i].isFinal) text += e.results[i][0].transcript;
        }
        if (text) reason.value = (reason.value ? reason.value + " " : "") + text;
      };
      dssReassignRec.onend = function () {
        dssReassignListening = false;
        setReassignDictationButton("Speak");
      };
      try { dssReassignRec.start(); dssReassignListening = true; setReassignDictationButton("Pause"); }
      catch (e) { dssReassignListening = false; setReassignDictationButton("Speak"); }
    } else {
      window.stopReassignDictation();
    }
  };

  function fillUsers(sel) {
    var keep = sel.querySelector('option[value=""]');
    sel.innerHTML = "";
    if (keep) sel.appendChild(keep);
    (usersCache || []).forEach(function (u) {
      var o = document.createElement("option");
      o.value = u.id; o.textContent = u.name;
      sel.appendChild(o);
    });
  }

  document.addEventListener("click", function (e) {
    var btn = e.target.closest(".ticket-reassign-btn");
    if (!btn) return;
    var id = btn.getAttribute("data-id");
    var hid = document.getElementById("dssReassignId");
    if (hid) hid.value = id;
    var rea = document.getElementById("dssReassignReason");
    if (rea) rea.value = "";
    if (window.stopReassignDictation) window.stopReassignDictation();
    var sel = document.getElementById("dssReassignUser");
    if (!sel) return;
    sel.value = "";
    if (usersCache) { fillUsers(sel); }
    else {
      fetch("/DailySupport/GetEngineers", { headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
        .then(function (list) { usersCache = list || []; fillUsers(sel); })
        .catch(function () { if (window.Ajax && Ajax.toast) Ajax.toast("Users ki list load nahi hui.", "error"); });
    }
    var m = document.getElementById("dssReassignModal");
    if (m && window.bootstrap) bootstrap.Modal.getOrCreateInstance(m).show();
  });

  document.addEventListener("hidden.bs.modal", function (e) {
    if (e.target && e.target.id === "dssReassignModal" && window.stopReassignDictation) window.stopReassignDictation();
  });

  document.addEventListener("submit", function (e) {
    var form = e.target;
    /* NOTE: form.id use mat karo - form ke andar <input name="id"> hone se
       form.id input element return karta hai, string nahi. Isliye getAttribute. */
    if (!form || form.getAttribute("id") !== "dssReassignForm") return;
    e.preventDefault();
    var sel = document.getElementById("dssReassignUser");
    if (!sel || !sel.value) { if (window.Ajax && Ajax.toast) Ajax.toast("Pehle user select karein.", "error"); return; }
    var btn = document.getElementById("dssReassignSave");
    if (btn) { btn.disabled = true; btn.textContent = "Saving…"; }
    if (window.Ajax && Ajax.post) {
      Ajax.post("/DailySupport/Reassign", new FormData(form))
        .then(function (data) {
          if (btn) { btn.disabled = false; btn.textContent = "Confirm Re-Assign"; }
          if (data && data.success === false) { if (window.Ajax && Ajax.toast) Ajax.toast(data.message || "Re-assign fail.", "error"); return; }
          var m2 = document.getElementById("dssReassignModal");
          if (m2 && window.bootstrap) bootstrap.Modal.getOrCreateInstance(m2).hide();
          if (window.Ajax && Ajax.toast) Ajax.toast(data.message || "Ticket re-assign ho gaya.", "success");
          if (typeof dssRefreshAfterChange === "function") dssRefreshAfterChange();
          else if (typeof loadTable === "function") loadTable();
        })
        .catch(function (err) {
          if (btn) { btn.disabled = false; btn.textContent = "Confirm Re-Assign"; }
          if (window.Ajax && Ajax.toast) Ajax.toast(err.message || "Re-assign fail.", "error");
        });
    } else {
      fetch("/DailySupport/Reassign", { method: "POST", body: new FormData(form), headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(function(r){return r.json();})
        .then(function(data){
          if (btn) { btn.disabled = false; btn.textContent = "Confirm Re-Assign"; }
          if (!data || data.success === false) { alert(data && data.message ? data.message : "Re-assign fail."); return; }
          var m2 = document.getElementById("dssReassignModal");
          if (m2 && window.bootstrap) bootstrap.Modal.getOrCreateInstance(m2).hide();
          alert(data.message || "Ticket re-assign ho gaya.");
          if (typeof dssRefreshAfterChange === "function") dssRefreshAfterChange();
          else if (typeof loadTable === "function") loadTable();
        })
        .catch(function(err){
          if (btn) { btn.disabled = false; btn.textContent = "Confirm Re-Assign"; }
          alert(err.message || "Re-assign fail.");
        });
    }
  });
})();

// ---- Change status ----
(function () {
  document.addEventListener("click", function (e) {
    var btn = e.target.closest(".ticket-status-btn");
    if (!btn) return;
    var id = document.getElementById("dssStatusId");
    var status = document.getElementById("dssStatusValue");
    if (id) id.value = btn.getAttribute("data-id") || "";
    if (status) status.value = btn.getAttribute("data-status") || "Open";
    var modal = document.getElementById("dssStatusModal");
    if (modal && window.bootstrap) bootstrap.Modal.getOrCreateInstance(modal).show();
  });

  document.addEventListener("submit", function (e) {
    var form = e.target;
    if (!form || form.getAttribute("id") !== "dssStatusForm") return;
    e.preventDefault();
    var save = document.getElementById("dssStatusSave");
    if (save) { save.disabled = true; save.textContent = "Saving..."; }
    var request = window.Ajax && Ajax.post
      ? Ajax.post("/DailySupport/UpdateStatus", new FormData(form))
      : fetch("/DailySupport/UpdateStatus", { method: "POST", body: new FormData(form), headers: { "X-Requested-With": "XMLHttpRequest" } }).then(function (r) { return r.json(); });
    request.then(function (data) {
      if (save) { save.disabled = false; save.textContent = "Update Status"; }
      if (data && data.success === false) { if (window.Ajax && Ajax.toast) Ajax.toast(data.message || "Status update failed.", "error"); return; }
      var modal = document.getElementById("dssStatusModal");
      if (modal && window.bootstrap) bootstrap.Modal.getOrCreateInstance(modal).hide();
      if (window.Ajax && Ajax.toast) Ajax.toast(data.message || "Status updated.", "success");
      if (typeof dssRefreshAfterChange === "function") dssRefreshAfterChange(); else if (typeof loadTable === "function") loadTable();
    }).catch(function (err) {
      if (save) { save.disabled = false; save.textContent = "Update Status"; }
      if (window.Ajax && Ajax.toast) Ajax.toast(err.message || "Status update failed.", "error");
    });
  });
})();

function dssFmtLabel(k) { return String(k).replace(/([a-z])([A-Z])/g, "$1 $2"); }
function dssEsc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;"); }

function dssBuildRows(obj, skip) {
  if (!obj) return '<div class="text-muted" style="font-size:12px;">No data</div>';
  var html = "";
  for (var k in obj) {
    if (skip.indexOf(k) > -1) continue;
    var v = obj[k]; if (v === null || v === undefined || v === "") v = "-";
    if (String(k).toLowerCase().indexOf("date") > -1 && v !== "-") { try { v = new Date(v).toLocaleString(); } catch (err) { } }
    html += '<div class="dss-row"><span>' + dssEsc(dssFmtLabel(k)) + '</span><span>' + dssEsc(v) + '</span></div>';
  }
  return html || '<div class="text-muted" style="font-size:12px;">No data</div>';
}

window.openTicketDetails = function (id, focusComments) {
  var modalEl = document.getElementById("dssTicketModal");
  if (!modalEl || !id) return;
  // Comment section ke liye current ticket id modal par save karo.
  modalEl.setAttribute("data-ticket-id", String(id));
  var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
  var titleEl = document.getElementById("dssTicketModalTitle");
  var bodyEl = document.getElementById("dssTicketModalBody");
  var editEl = document.getElementById("dssTicketModalEdit");

  titleEl.textContent = "Loading…";
  bodyEl.innerHTML = '<div class="text-center p-5"><div class="spinner-border text-dark"></div></div>';
  // Edit link me filters bhi - Edit karke wapas aane par filter na ude
  if (editEl) editEl.href = "/DailySupport/Edit/" + id + "?" + dssQuery(dssCurrentPage, dssPageSize, false);
  if (focusComments) {
    modalEl.addEventListener("shown.bs.modal", function () {
      var commentInput = document.getElementById("dssCommentText");
      if (commentInput) commentInput.focus();
    }, { once: true });
  }
  modal.show();

  fetch("/DailySupport/GetDetails?id=" + encodeURIComponent(id) + "&single=true", { headers: { "X-Requested-With": "XMLHttpRequest" } })
    .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
    .then(function (data) {
      var t = data.ticket || {}, c = data.customer || {}, h = data.history || [], audit = data.audit || [];
      titleEl.textContent = ((t.TicketNo || "") + (t.CompanyName ? " - " + t.CompanyName : "")).replace(/[\u0000-\u001F\u007F-\u009F]/g, "");
      var skip = ["SupportId", "ClientId", "CustomerID", "UserId", "VisitTypeId", "AssignedTo", "CallerName", "Description", "CompanyName"];

      function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;"); }
      var fieldLabels = { AssignedTo: "Assigned To", ClientId: "Customer", Status: "Status", Priority: "Priority", Issue: "Issue", Description: "Description", Solution: "Solution", Mobile: "Mobile", CallerName: "Caller Name", Category: "Category", Channel: "Channel", CallType: "Call Type" };

      // Audit trail: kaun banaya / kisne kya kab edit kiya (time + naam ke saath)
      // NOTE: Ek save par saare changed fields ki alag-alag rows banti hain (same user + same time).
      // Re-assign + edit bhi same time par ho to sab EK hi row me dikhte hain.
      var auditGroups = [];
      function isChangeAction(x) { return x === "Edited" || x === "Reassigned"; }
      audit.forEach(function (a) {
        var t = a.ChangedOn ? new Date(a.ChangedOn).getTime() : 0;
        var whoName = a.ChangedByName || a.ChangedBy || "-";
        var last = auditGroups.length ? auditGroups[auditGroups.length - 1] : null;
        // Same user + lagbhag same time (2 sec andar) + dono change actions = ek hi row
        if (last && isChangeAction(a.Action) && isChangeAction(last.action) &&
            (last.who || "") === (whoName || "") &&
            Math.abs(t - last.firstTime) <= 2000) {
          last.items.push(a);
          if (t > last.lastTime) last.lastTime = t;
        } else {
          auditGroups.push({ action: a.Action, who: whoName, firstTime: t, lastTime: t, items: [a] });
        }
      });

      var auditHtml = auditGroups.length
        ? auditGroups.map(function (g) {
            var when = g.firstTime ? new Date(g.lastTime).toLocaleString() : "-";
            var who = g.who || "-";
            if (g.action === "Created") {
              return "<tr><td style='white-space:nowrap;font-size:11px;'>" + when + "</td>" +
                "<td style='white-space:nowrap;font-size:11px;'><b>" + esc(who) + "</b></td>" +
                "<td style='font-size:11px;'><span class='badge' style='background:#dcfce7;color:#166534;'>Created</span> New ticket created</td>" +
                "<td style='font-size:11px;color:#94a3b8;'>-</td></tr>";
            }
            // Ek hi row me: Re-Assign + Edited (jo bhi us time par hua) ke saare changes
            var hasReassign = false, hasEdit = false, gReason = "";
            for (var gi = 0; gi < g.items.length; gi++) {
              if (g.items[gi].Action === "Reassigned") hasReassign = true; else hasEdit = true;
              if (!gReason && g.items[gi].Reason) gReason = g.items[gi].Reason;
            }
            var changes = g.items.map(function (a) {
              var label = fieldLabels[a.FieldName] || a.FieldName || "Field";
              return "<b>" + esc(label) + "</b>: " +
                (a.OldValue ? "<span class='text-danger text-decoration-line-through'>" + esc(a.OldValue) + "</span> → " : "") +
                "<span class='text-success'>" + esc(a.NewValue || "-") + "</span>";
            }).join("<br>");
            var badgeText = hasReassign && hasEdit
              ? "Re-Assigned + Edited"
              : (hasReassign ? "Re-Assigned" : (g.items.length > 1 ? "Edited (" + g.items.length + " changes)" : "Edited"));
            var badgeStyle = hasReassign
              ? "background:#fef3c7;color:#92400e;"
              : "background:#e0e7ff;color:#3730a3;";
            return "<tr><td style='white-space:nowrap;font-size:11px;'>" + when + "</td>" +
              "<td style='white-space:nowrap;font-size:11px;'><b>" + esc(who) + "</b></td>" +
              "<td style='font-size:11px;'><span class='badge' style='" + badgeStyle + "'>" + badgeText + "</span> " + changes + "</td>" +
              "<td style='font-size:11px;'>" + (gReason ? "<span class='fst-italic'>" + esc(gReason) + "</span>" : "<span class='text-muted'>-</span>") + "</td></tr>";
          }).join("")
        : "<tr><td colspan='4' class='text-center text-muted'>No history</td></tr>";

      bodyEl.innerHTML =
        "<div class='p-3'>" +
          "<div class='row g-2 mb-2'>" +
            "<div class='col-md-6'><div class='modal-info h-100'><div class='dss-modal-sec'>Ticket Info</div>" + dssBuildRows(t, skip) + "</div></div>" +
            "<div class='col-md-6'><div class='modal-info h-100'><div class='dss-modal-sec'>Customer Info</div>" + dssBuildRows(c, ["ClientId"]) + "</div></div>" +
          "</div>" +
          "<div class='modal-info'><div class='dss-modal-sec'>History (Created & Edits)</div>" +
            "<table class='table table-sm mb-0' style='font-size:12px;'><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Reason</th></tr></thead><tbody>" + auditHtml + "</tbody></table>" +
          "</div>" +
        "</div>";
    })
    .catch(function (err) {
      bodyEl.innerHTML = "<div class='p-4 text-danger text-center'>Failed to load: " + err.message + "</div>";
    });
};
</script>

<script>
/* =========================================================================
   TICKET COMMENTS - self-contained block.
   No existing function or markup was touched.
   - Comments load when the ticket details popup opens
   - Post -> /DailySupport/AddComment (reply goes to the assigned user)
   - No delete/edit (permanent record)
   ========================================================================= */
(function () {
  var wrap   = document.getElementById("dssCommentsWrap");
  if (!wrap) return;
  var modalEl = document.getElementById("dssTicketModal");
  var listEl  = document.getElementById("dssCommentsList");
  var inputEl = document.getElementById("dssCommentText");
  var postBtn = document.getElementById("dssCommentPost");
  var speakBtn = document.getElementById("dssCommentSpeak");
  var clearBtn = document.getElementById("dssCommentClear");
  var replyEl = document.getElementById("dssCommentReplyTo");
  var countEl = document.getElementById("dssCommentCount");
  var currentId = null;
  var commentRec = null, commentListening = false;

  function setSpeakButton(text) {
    if (speakBtn) speakBtn.innerHTML = text === "Pause" ? '<i class="bi bi-pause-fill me-1"></i>Pause' : '<i class="bi bi-mic-fill me-1"></i>Speak';
  }
  function stopCommentDictation() {
    if (commentRec) { try { commentRec.stop(); } catch (e) {} }
    commentListening = false;
    setSpeakButton("Speak");
  }
  function toggleCommentDictation() {
    var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR) { if (window.Ajax) Ajax.toast("Is browser me voice input support nahi hai. Chrome/Edge use karein.", "error"); return; }
    if (!inputEl) return;
    if (!commentListening) {
      commentRec = new SR();
      commentRec.continuous = true;
      commentRec.interimResults = true;
      commentRec.lang = "en-IN";
      commentRec.onresult = function (e) {
        var text = "";
        for (var i = e.resultIndex; i < e.results.length; i++) if (e.results[i].isFinal) text += e.results[i][0].transcript;
        if (text) { inputEl.value = (inputEl.value ? inputEl.value + " " : "") + text.trim(); inputEl.focus(); }
      };
      commentRec.onerror = function (e) { if (window.Ajax) Ajax.toast("Voice error: " + e.error, "error"); };
      commentRec.onend = function () { commentListening = false; setSpeakButton("Speak"); };
      try { commentRec.start(); commentListening = true; setSpeakButton("Pause"); }
      catch (e) { commentListening = false; setSpeakButton("Speak"); }
    } else stopCommentDictation();
  }

  function esc(s) {
    return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;")
      .replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }
  function fmt(v) { if (!v) return ""; try { return new Date(v).toLocaleString(); } catch (e) { return String(v); } }

  /* Ticket id comes from the Edit link href (/DailySupport/Edit/<id>),
     which openTicketDetails sets before modal.show(). No existing function touched. */
  function ticketId() {
    var modal = document.getElementById("dssTicketModal");
    var savedId = modal ? (modal.getAttribute("data-ticket-id") || "") : "";
    if (/^\d+$/.test(savedId)) return savedId;
    var a = document.getElementById("dssTicketModalEdit");
    var h = a ? (a.getAttribute("href") || "") : "";
    var m = h.match(/\/DailySupport\/Edit\/(\d+)/);
    return m ? m[1] : null;
  }

  function render(list) {
    if (!listEl) return;
    list = list || [];
    if (countEl) countEl.textContent = list.length ? "(" + list.length + ")" : "";
    if (!list.length) {
      listEl.innerHTML = "";
      listEl.style.display = "none";
      return;
    }
    listEl.style.display = "";
    listEl.innerHTML = list.map(function (c) {
      var to = c.ReplyToName ? ' <span style="color:#0e7490;">&rarr; ' + esc(c.ReplyToName) + '</span>' : '';
      return '<div style="padding:4px 3px;border-bottom:1px dashed #e8edf3;">' +
        '<div style="font-size:9.5px;color:#64748b;"><b style="color:#0f172a;">' + esc(c.CreatedByName || "User") + '</b> &middot; ' + esc(fmt(c.CreatedOn)) + to + '</div>' +
        '<div style="font-size:11.5px;color:#0f172a;white-space:pre-wrap;line-height:1.35;">' + esc(c.CommentText) + '</div>' +
        '</div>';
    }).join("");
    listEl.scrollTop = listEl.scrollHeight;
  }

  function load(id) {
    if (!listEl) return;
    if (!id) { render([]); if (replyEl) replyEl.textContent = ""; return; }
    listEl.style.display = "";
    listEl.innerHTML = '<div class="text-muted" style="font-size:10.5px;padding:6px;">Loading&hellip;</div>';
    fetch("/DailySupport/GetComments?id=" + encodeURIComponent(id), { headers: { "X-Requested-With": "XMLHttpRequest" } })
      .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
      .then(function (d) {
        if (replyEl) replyEl.textContent = (d && d.assignedToName) ? ("Reply to: " + d.assignedToName) : "No user assigned";
        render(d && d.comments);
      })
      .catch(function (e) {
        if (listEl) { listEl.style.display = ""; listEl.innerHTML = '<div class="text-danger" style="font-size:10.5px;padding:6px;">' + esc(e.message) + '</div>'; }
      });
  }

  function post() {
    if (!currentId) { if (window.Ajax) Ajax.toast("Ticket not found.", "error"); return; }
    var txt = (inputEl && inputEl.value || "").trim();
    if (!txt) { if (window.Ajax) Ajax.toast("Please write a comment first.", "error"); if (inputEl) inputEl.focus(); return; }
    if (!window.Ajax || !Ajax.post) { if (window.Ajax) Ajax.toast("Comment helper not loaded.", "error"); return; }
    postBtn.disabled = true; postBtn.textContent = "Posting…";
    var fd = new FormData();
    fd.append("id", currentId);
    fd.append("comment", txt);
    Ajax.post("/DailySupport/AddComment", fd)
      .then(function (d) {
        postBtn.disabled = false; postBtn.textContent = "Post";
        if (!d || d.success === false) { Ajax.toast((d && d.message) || "Could not save comment.", "error"); return; }
        if (inputEl) inputEl.value = "";
        Ajax.toast(d.message || "Comment added.", "success");
        load(currentId);
      })
      .catch(function (err) {
        postBtn.disabled = false; postBtn.textContent = "Post";
        Ajax.toast((err && err.message) || "Could not save comment.", "error");
      });
  }

  if (modalEl) {
    modalEl.addEventListener("show.bs.modal", function () {
      currentId = ticketId();
      stopCommentDictation();
      if (inputEl) inputEl.value = "";
      if (replyEl) replyEl.textContent = "";
      load(currentId);
    });
  }
  if (postBtn) postBtn.addEventListener("click", post);
  if (speakBtn) speakBtn.addEventListener("click", toggleCommentDictation);
  if (clearBtn) clearBtn.addEventListener("click", function () { if (inputEl) inputEl.value = ""; });
  if (modalEl) modalEl.addEventListener("hidden.bs.modal", stopCommentDictation);
  if (inputEl) inputEl.addEventListener("keydown", function (e) {
    if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) { e.preventDefault(); post(); }
  });
})();
</script>
