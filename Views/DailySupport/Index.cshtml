@model DailySupportDashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}
<style>
 .stat-card{background:#fff;border:1px solid #eef2f7;border-radius:10px;padding:8px 12px;display:flex;justify-content:space-between;align-items:center;height:60px;box-shadow:0 1px 2px rgba(0,0,0,.04);}
 .stat-label{font-size:9px;font-weight:700;color:#64748b;letter-spacing:.4px;text-transform:uppercase;line-height:1.2;margin-bottom:1px;}
 .stat-value{font-size:18px;font-weight:800;color:#0f172a;line-height:1;margin-top:1px;}
 .stat-sub{font-size:9.5px;color:#6c757d;margin-top:1px;}
 .icon-box{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;flex-shrink:0;}
 .filter-card{border-radius:12px;border:0;box-shadow:0 3px 12px rgba(0,0,0,0.06);}
 .filter-card .form-label{margin-bottom:3px;}
 .search-box{border-radius:8px;height:30px;font-size:12.5px;}
 .table-card{border-radius:12px;border:0;box-shadow:0 4px 20px rgba(0,0,0,0.06);overflow:visible;}
 /* SINGLE SCROLLER ONLY - DOUBLE HATA DIYA */
 #tableContainer{
   max-height: none;
   overflow: visible;
 }
 #tableContainer table thead th{
   position: sticky;
   top: 0;
   z-index: 10;
   background: #f8fafc !important;
   color: #475569 !important;
   font-size: 10px;
   font-weight: 700;
   text-transform: uppercase;
   cursor: pointer;
   white-space: normal;
   padding: 7px 8px !important;
   line-height: 1.15;
   border-bottom: 1px solid #e2e8f0 !important;
 }
 #tableContainer table thead th:hover{ background: #f1f5f9 !important; }
 .sort-icon{font-size:11px;margin-left:5px;opacity:0.6}
 th.active .sort-icon{opacity:1}
 /* scrollbar styling - single */
 ::-webkit-scrollbar{ width:8px; height:8px; }
 ::-webkit-scrollbar-thumb{ background:#cbd5e1; border-radius:4px; }
 /* Ticket details popup (grid ka View option) */
 .dss-modal-sec{font-size:10px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px;}
 #dssTicketModal .modal-body{background:#f8fafc;max-height:72vh;overflow-y:auto;}
 #dssTicketModal .modal-info{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 12px;}
 #dssTicketModal .dss-row{display:flex;justify-content:space-between;gap:10px;margin-bottom:6px;font-size:12px;}
 #dssTicketModal .dss-row span:first-child{color:#6b7280;}
 #dssTicketModal .dss-row span:last-child{font-weight:500;text-align:right;}
  /* View popup - compact (sirf size, content same) */
  #dssTicketModal .modal-dialog{max-width:820px;width:calc(100vw - 32px);}
  #dssTicketModal .modal-header{padding:8px 14px !important;}
  #dssTicketModal .modal-title{font-size:12.5px;}
  #dssTicketModal .modal-body{max-height:calc(100vh - 135px);}
  #dssTicketModal .modal-footer{padding:6px 12px !important;}
  #dssTicketModal .modal-footer .btn{font-size:12px;padding:3px 10px;}
  #dssTicketModal .modal-info{padding:8px 10px;border-radius:8px;}
  #dssTicketModal .dss-modal-sec{margin-bottom:4px;font-size:9.5px;}
  #dssTicketModal .dss-row{font-size:11.5px;margin-bottom:4px;gap:8px;}
  #dssTicketModal table th,#dssTicketModal table td{padding:3px 6px;font-size:11px;}
  #dssTicketModal table thead th{font-size:10px;text-transform:uppercase;color:#6b7280;}
  @@media(max-width:700px){#dssTicketModal .modal-dialog{max-width:100%;width:calc(100vw - 12px);margin:.4rem auto;}}
</style>
<div class="d-flex justify-content-between align-items-center mb-1">
    <h4 class="fw-bold mb-0" style="font-size:16px;letter-spacing:-0.01em;">Daily Support System</h4>
    <div class="d-flex gap-1">
        <a href="/Client/Create" data-no-modal class="btn btn-light border" style="border-radius:6px;height:28px;padding:0 10px;font-size:11.5px;display:inline-flex;align-items:center;justify-content:center;line-height:1;" onclick="event.preventDefault(); window.loadPage('/Client/Create', 'New Customer');">+ New Customer</a>
        <a href="/DailySupport/Create" data-no-modal class="btn btn-dark" style="border-radius:6px;height:28px;padding:0 10px;font-size:11.5px;display:inline-flex;align-items:center;justify-content:center;line-height:1;" onclick="event.preventDefault(); window.loadPage('/DailySupport/Create', 'New Call Entry');">+ New Call Entry</a>
    </div>
</div>
<div class="row g-2 mb-2">
    <div class="col-md-3"><div class="stat-card"><div><div class="stat-label">Today Calls</div><div class="stat-value">@Model.TodayCalls</div><div class="stat-sub">Total @Model.TotalCalls calls</div></div><div class="icon-box" style="background:#f59e0b;"><i class="bi bi-telephone-fill"></i></div></div></div>
    <div class="col-md-3"><div class="stat-card"><div><div class="stat-label">Open Calls</div><div class="stat-value" style="color:#dc3545;">@Model.OpenCalls</div><div class="stat-sub" style="color:#dc3545;">Need action</div></div><div class="icon-box" style="background:#ef4444;"><i class="bi bi-exclamation-circle-fill"></i></div></div></div>
    <div class="col-md-3"><div class="stat-card"><div><div class="stat-label">Closed Today</div><div class="stat-value" style="color:#198754;">@Model.ClosedToday</div><div class="stat-sub" style="color:#198754;">Done today</div></div><div class="icon-box" style="background:#10b981;"><i class="bi bi-check-circle-fill"></i></div></div></div>
    <div class="col-md-3"><div class="stat-card"><div><div class="stat-label">Pending</div><div class="stat-value" style="color:#6f42c1;">@Model.PendingCalls</div><div class="stat-sub">In Progress</div></div><div class="icon-box" style="background:#8b5cf6;"><i class="bi bi-hourglass-split"></i></div></div></div>
</div>
<div class="card filter-card mb-2"><div class="card-body" style="padding:8px 10px;"><div class="row g-2 align-items-end"><div class="col-12 col-md-6 col-lg-2"><label class="form-label" style="font-size:9px;font-weight:700;color:#64748b;margin-bottom:3px;">SEARCH</label><div class="input-group"><span class="input-group-text bg-white border-end-0" style="border-radius:8px 0 0 8px;padding:4px 8px;"><i class="bi bi-search"></i></span><input type="text" id="dssSearch" value="@Model.SearchTerm" class="form-control border-start-0 search-box" placeholder="Ticket, mobile..." /></div></div><div class="col-6 col-md-3 col-lg-2"><label class="form-label" style="font-size:9px;font-weight:700;color:#64748b;margin-bottom:3px;">STATUS</label><select id="dssStatus" class="form-select search-box">
<option value="">All Status</option>
@foreach(var st in new[]{"Open","In Progress","On Hold","Pending","Closed"}){<option value="@st" selected="@(string.Equals(Model.FilterStatus,st,System.StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@st</option>}
</select></div><div class="col-6 col-md-3 col-lg-2"><label class="form-label" style="font-size:9px;font-weight:700;color:#64748b;margin-bottom:3px;">USER</label><select id="dssUser" class="form-select search-box">
<option value="">All Users</option>
@foreach(var u in Model.Users){var uid=u.ContainsKey("UserId")?(u["UserId"]?.ToString()??""):"";var uname=u.ContainsKey("FullName")?(u["FullName"]?.ToString()??""):"";<option value="@uid" selected="@(uid==Model.FilterUser ? "selected" : null)">@uname</option>}
</select></div><div class="col-6 col-md-3 col-lg-2"><label class="form-label" style="font-size:9px;font-weight:700;color:#64748b;margin-bottom:3px;">FROM DATE</label><input type="date" id="fromDate" value="@Model.FromDate" class="form-control search-box" /></div><div class="col-6 col-md-3 col-lg-2"><label class="form-label" style="font-size:9px;font-weight:700;color:#64748b;margin-bottom:3px;">TO DATE</label><input type="date" id="toDate" value="@Model.ToDate" class="form-control search-box" /></div>
<div class="col-12 col-md-6 col-lg-2 d-flex justify-content-end gap-2 align-items-end" style="flex-wrap:nowrap;">
<a href="/DailySupport" class="btn btn-light border px-2" style="border-radius:8px;height:30px;font-size:12px;" onclick="event.preventDefault(); clearFilters();">Clear</a>
<div class="dropdown">
<button class="btn btn-dark dropdown-toggle px-2" style="border-radius:8px;height:30px;font-size:12px;" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-download me-1"></i> Export</button>
<ul class="dropdown-menu dropdown-menu-end">
<li><a class="dropdown-item" href="#" onclick="exportPrint()" style="font-size:12.5px"><i class="bi bi-printer me-2"></i>Print</a></li>
<li><a class="dropdown-item" href="#" onclick="exportCSV()" style="font-size:12.5px"><i class="bi bi-filetype-csv me-2"></i>CSV</a></li>
<li><a class="dropdown-item" href="#" onclick="exportExcel()" style="font-size:12.5px"><i class="bi bi-file-earmark-excel me-2"></i>Excel</a></li>
</ul>
</div>
</div></div></div></div>
<div id="tableContainer">@await Html.PartialAsync("_CallTable", Model.TicketTable)</div>

<script>
/* ============================================================
   Daily Support grid - pagination (grid ke upar wali bar)
   ============================================================ */
var dssCurrentPage = @Model.TicketTable.CurrentPage;
var dssPageSize = @Model.TicketTable.PageSize;

function dssGet(id){ var e=document.getElementById(id); return e ? e.value : ''; }
function dssFilters(){
  return {
    search: (dssGet('dssSearch')||'').trim(),
    fromDate: dssGet('fromDate'),
    toDate: dssGet('toDate'),
    status: dssGet('dssStatus'),
    user: dssGet('dssUser')
  };
}
/* partial=1 -> server sirf grid ka partial (table + pagination bar) bhejta hai */
function dssQuery(page,pageSize,partial){
  var f=dssFilters(); var p=new URLSearchParams();
  if(partial) p.append('partial','1');
  p.append('page',page||1);
  p.append('pageSize',pageSize||dssPageSize||10);
  if(f.search) p.append('search',f.search);
  if(f.fromDate) p.append('fromDate',f.fromDate);
  if(f.toDate) p.append('toDate',f.toDate);
  if(f.status) p.append('status',f.status);
  if(f.user) p.append('user',f.user);
  return p.toString();
}
function dssRender(html){
  var box=document.getElementById('tableContainer'); if(!box) return;
  box.innerHTML=html;
  // Server page/pageSize clamp kar chuka hota hai - nayi values yahan se padho
  var tb=box.querySelector('.dss-grid-toolbar');
  if(tb) dssCurrentPage=parseInt(tb.getAttribute('data-current-page'))||1;
  var sel=box.querySelector('.dss-page-size');
  if(sel) dssPageSize=parseInt(sel.value)||dssPageSize||10;
  attachSorting(); attachPager();
}
function dssLoad(page,pageSize,scroll){
  dssCurrentPage=page||1;
  dssPageSize=pageSize||dssPageSize||10;
  fetch('/DailySupport/Index?'+dssQuery(dssCurrentPage,dssPageSize,true),{headers:{'X-Requested-With':'XMLHttpRequest'}})
  .then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.text(); })
  .then(function(h){
    dssRender(h);
    // URL sync - refresh / back-forward par wahi page khule
    try{ history.replaceState(null,'','/DailySupport?'+dssQuery(dssCurrentPage,dssPageSize,false)); }catch(e){}
    if(scroll){
      // Pagination bar ab grid ke NICHE hai - isliye table ka TOP target karo,
      // warna page change karne par grid ke bottom par scroll ho jayega.
      var tc=document.getElementById('tableContainer');
      if(tc) window.scrollTo({top:tc.getBoundingClientRect().top+window.pageYOffset-70,behavior:'smooth'});
    }
  })
  .catch(function(e){ Ajax.toast(e.message,'error'); });
}
/* Filter badalne par hamesha page 1 */
function loadTable(){ dssLoad(1,dssPageSize,false); }
/* Pager button */
function goPage(p,ps){ dssLoad(p||1,ps||dssPageSize,true); }
function attachPager(){
  document.querySelectorAll('#tableContainer .dss-page').forEach(function(a){
    a.onclick=function(e){ e.preventDefault(); goPage(parseInt(this.getAttribute('data-page')),dssPageSize); };
  });
  document.querySelectorAll('#tableContainer .dss-page-size').forEach(function(sel){
    sel.onchange=function(){ goPage(1,parseInt(this.value)); };
  });
}
var sortState={};
function parseDssDate(v){
  if(!v) return NaN;
  var s=String(v).trim().toLowerCase();
  // dd-MM-yy hh:mm tt ya dd-mm-yyyy
  var m=s.match(/(\d{1,2})[-\/](\d{1,2})[-\/](\d{2,4})(?:\s+(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(am|pm)?)?/);
  if(m){
    var dd=parseInt(m[1],10), mm=parseInt(m[2],10)-1, yy=parseInt(m[3],10);
    if(yy<100) yy+=2000;
    var hh=0, mi=0, ss=0, ap=m[7];
    if(m[4]){ hh=parseInt(m[4],10); if(ap==='pm'&&hh<12) hh+=12; if(ap==='am'&&hh===12) hh=0; }
    if(m[5]) mi=parseInt(m[5],10);
    if(m[6]) ss=parseInt(m[6],10);
    var d=new Date(yy,mm,dd,hh,mi,ss);
    return isNaN(d.getTime())?NaN:d.getTime();
  }
  var d2=Date.parse(v);
  return isNaN(d2)?NaN:d2;
}

function attachSorting(){
  const table=document.querySelector("#tableContainer table"); if(!table) return;
  const ths=table.querySelectorAll("thead th");
  ths.forEach((th,idx)=>{
    if(th.innerText.trim().toLowerCase()==='action') return;
    if(!th.querySelector(".sort-icon")) th.innerHTML=th.innerText+' <span class="sort-icon">↕</span>';
    th.onclick=function(){
      let dir=sortState[idx]==='asc'?'desc':'asc'; sortState[idx]=dir;
      ths.forEach(x=>{x.classList.remove('active'); let ic=x.querySelector('.sort-icon'); if(ic) ic.textContent='↕';});
      th.classList.add('active'); th.querySelector('.sort-icon').textContent=dir==='asc'?'↑':'↓';
      let tbody=table.tBodies[0]; let rows=Array.from(tbody.rows);
      rows.sort((a,b)=>{
        if(!a.cells[idx]||!b.cells[idx]) return 0;
        let aVal=a.cells[idx]?.innerText.replace(/\s+/g,' ').trim()||''; 
        let bVal=b.cells[idx]?.innerText.replace(/\s+/g,' ').trim()||'';
        // date first
        let aDate=parseDssDate(aVal), bDate=parseDssDate(bVal);
        if(!isNaN(aDate)&&!isNaN(bDate)) return dir==='asc'?aDate-bDate:bDate-aDate;
        // number
        let aNum=parseFloat(aVal.replace(/,/g,'')), bNum=parseFloat(bVal.replace(/,/g,''));
        if(!isNaN(aNum)&&!isNaN(bNum)&&aVal.replace(/[^0-9.-]/g,'')!==''&&bVal.replace(/[^0-9.-]/g,'')!=='') return dir==='asc'?aNum-bNum:bNum-aNum;
        // string
        return dir==='asc'?aVal.localeCompare(bVal):bVal.localeCompare(aVal);
      });
      rows.forEach(r=>tbody.appendChild(r));
    };
  });
}
attachSorting(); attachPager();
function getTable(){return document.querySelector("#tableContainer table");}
function exportCSV(){
  // POORA filtered data download karo - server ka logic use
  var f=dssFilters();
  var p=new URLSearchParams();
  if(f.search) p.append('search',f.search);
  if(f.fromDate) p.append('fromDate',f.fromDate);
  if(f.toDate) p.append('toDate',f.toDate);
  if(f.status) p.append('status',f.status);
  if(f.user) p.append('user',f.user);
  p.append('export','csv');
  window.location.href='/DailySupport/Index?'+p.toString();
}
function exportExcel(){
  var f=dssFilters();
  var p=new URLSearchParams();
  if(f.search) p.append('search',f.search);
  if(f.fromDate) p.append('fromDate',f.fromDate);
  if(f.toDate) p.append('toDate',f.toDate);
  if(f.status) p.append('status',f.status);
  if(f.user) p.append('user',f.user);
  p.append('export','excel');
  window.location.href='/DailySupport/Index?'+p.toString();
}
function exportPrint(){
  // Current grid ka print (user ne jo dekha hai wahi print ho)
  let table=getTable(); if(!table) return;
  let clone=table.cloneNode(true);
  clone.querySelectorAll('button,a.btn').forEach(function(el){ el.outerHTML=el.textContent.trim(); });
  let w=window.open("","","width=1100,height=800");
  w.document.write("<html><head><title>Daily Support</title><link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'><style>body{font-family:Segoe UI,Arial,sans-serif;font-size:12px}table{font-size:11.5px}th,td{padding:4px 6px}th{position:static !important;background:#f8fafc}</style></head><body class='p-3'><h5>Daily Support - "+new Date().toLocaleDateString()+"</h5>"+clone.outerHTML+"</body></html>");
  w.document.close(); w.focus(); setTimeout(()=>{w.print(); w.close();},600);
}
/* Filter change events */
var dssSearchTimer=null;
document.getElementById('dssSearch')?.addEventListener('keyup',function(){
  clearTimeout(dssSearchTimer);
  dssSearchTimer=setTimeout(function(){ loadTable(); },400);
});
document.getElementById('fromDate')?.addEventListener('change',loadTable);
document.getElementById('toDate')?.addEventListener('change',loadTable);
document.getElementById('dssStatus')?.addEventListener('change',loadTable);
document.getElementById('dssUser')?.addEventListener('change',loadTable);
function clearFilters(){
  var s=document.getElementById('dssSearch'); if(s) s.value='';
  var f=document.getElementById('fromDate'); if(f) f.value='';
  var t=document.getElementById('toDate'); if(t) t.value='';
  var st=document.getElementById('dssStatus'); if(st) st.value='';
  var u=document.getElementById('dssUser'); if(u) u.value='';
  loadTable();
}
</script>

<!-- ===== Ticket details popup (grid me Ticket No / Action -> View se khulta hai) ===== -->
<div class="modal fade" id="dssTicketModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content" style="border-radius:12px;overflow:hidden;">
      <div class="modal-header" style="background:#0f172a;color:#fff;padding:8px 14px;">
        <h6 class="modal-title mb-0" id="dssTicketModalTitle" style="font-weight:700;font-size:12.5px;">Ticket Details</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0" id="dssTicketModalBody">
        <div class="text-center p-5"><div class="spinner-border text-dark"></div></div>
      </div>
      <div class="modal-footer py-1">
        <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Close</button>
        <a href="#" id="dssTicketModalEdit" data-no-modal class="btn btn-sm" style="background:#0f172a;color:#fff;" onclick="event.preventDefault(); var h=this.getAttribute('href'); if(h && h!=='#') window.loadPage(h, 'Edit Call');">Open Edit Form</a>
      </div>
    </div>
  </div>
</div>

<!-- ===== Re-Assign popup (kaam na kar pao to kisi aur user ko do) ===== -->
<div class="modal fade" id="dssReassignModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" style="max-width:470px;">
    <form id="dssReassignForm" class="modal-content" style="border-radius:14px;overflow:hidden;">
      @Html.AntiForgeryToken()
      <input type="hidden" name="id" id="dssReassignId" value="" />
      <div class="modal-header" style="background:#0f172a;color:#fff;padding:10px 16px;">
        <h6 class="modal-title mb-0" style="font-weight:700;font-size:13px;"><i class="bi bi-arrow-left-right me-1"></i> Re-Assign Ticket</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-3" style="background:#f8fafc;">
        <div class="mb-2">
          <label class="form-label" style="font-size:10px;font-weight:700;color:#64748b;">KISKO ASSIGN KARNA HAI *</label>
          <select class="form-select form-select-sm" id="dssReassignUser" name="assignedTo" required style="border-radius:8px;height:34px;font-size:12.5px;">
            <option value="">— User select karein —</option>
          </select>
        </div>
        <div class="mb-0">
          <label class="form-label" style="font-size:10px;font-weight:700;color:#64748b;">REASON (optional)</label>
          <textarea class="form-control form-control-sm" id="dssReassignReason" name="reason" rows="2" maxlength="300" placeholder="Jaise: main busy hoon / chutti par hoon..." style="border-radius:8px;font-size:12.5px;"></textarea>
        </div>
        <div class="form-text" style="font-size:10.5px;">Ticket us user ko mil jayegi. Reason history me record hoga.</div>
      </div>
      <div class="modal-footer py-2 bg-white">
        <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-sm" style="background:#0f172a;color:#fff;" id="dssReassignSave">Confirm Re-Assign</button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  document.addEventListener("click", function (e) {
    var btn = e.target.closest(".ticket-view-btn");
    if (!btn) return;
    e.preventDefault();
    if (typeof window.openTicketDetails === "function") window.openTicketDetails(btn.getAttribute("data-id"));
  });
})();

// ---- Re-Assign: button click -> user dropdown -> confirm ----
(function () {
  var usersCache = null;

  function fillUsers(sel) {
    var keep = sel.querySelector('option[value=""]');
    sel.innerHTML = "";
    if (keep) sel.appendChild(keep);
    (usersCache || []).forEach(function (u) {
      var o = document.createElement("option");
      o.value = u.id; o.textContent = u.name;
      sel.appendChild(o);
    });
  }

  document.addEventListener("click", function (e) {
    var btn = e.target.closest(".ticket-reassign-btn");
    if (!btn) return;
    e.preventDefault();
    var id = btn.getAttribute("data-id");
    var hid = document.getElementById("dssReassignId");
    if (hid) hid.value = id;
    var rea = document.getElementById("dssReassignReason");
    if (rea) rea.value = "";
    var sel = document.getElementById("dssReassignUser");
    if (!sel) return;
    sel.value = "";
    if (usersCache) { fillUsers(sel); }
    else {
      fetch("/DailySupport/GetEngineers", { headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
        .then(function (list) { usersCache = list || []; fillUsers(sel); })
        .catch(function () { if (window.Ajax && Ajax.toast) Ajax.toast("Users ki list load nahi hui.", "error"); });
    }
    var m = document.getElementById("dssReassignModal");
    if (m && window.bootstrap) bootstrap.Modal.getOrCreateInstance(m).show();
  });

  document.addEventListener("submit", function (e) {
    var form = e.target;
    if (!form || form.id !== "dssReassignForm") return;
    e.preventDefault();
    var sel = document.getElementById("dssReassignUser");
    if (!sel || !sel.value) { if (window.Ajax && Ajax.toast) Ajax.toast("Pehle user select karein.", "error"); return; }
    var btn = document.getElementById("dssReassignSave");
    if (btn) { btn.disabled = true; btn.textContent = "Saving…"; }
    if (window.Ajax && Ajax.post) {
      Ajax.post("/DailySupport/Reassign", new FormData(form))
        .then(function (data) {
          if (btn) { btn.disabled = false; btn.textContent = "Confirm Re-Assign"; }
          if (data && data.success === false) { if (window.Ajax && Ajax.toast) Ajax.toast(data.message || "Re-assign fail.", "error"); return; }
          var m2 = document.getElementById("dssReassignModal");
          if (m2 && window.bootstrap) bootstrap.Modal.getOrCreateInstance(m2).hide();
          if (window.Ajax && Ajax.toast) Ajax.toast(data.message || "Ticket re-assign ho gaya.", "success");
          if (typeof loadTable === "function") loadTable();
        })
        .catch(function (err) {
          if (btn) { btn.disabled = false; btn.textContent = "Confirm Re-Assign"; }
          if (window.Ajax && Ajax.toast) Ajax.toast(err.message || "Re-assign fail.", "error");
        });
    } else {
      fetch("/DailySupport/Reassign", { method: "POST", body: new FormData(form), headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(function(r){return r.json();})
        .then(function(data){
          if (btn) { btn.disabled = false; btn.textContent = "Confirm Re-Assign"; }
          if (!data || data.success === false) { alert(data && data.message ? data.message : "Re-assign fail."); return; }
          var m2 = document.getElementById("dssReassignModal");
          if (m2 && window.bootstrap) bootstrap.Modal.getOrCreateInstance(m2).hide();
          alert(data.message || "Ticket re-assign ho gaya.");
          if (typeof loadTable === "function") loadTable();
        })
        .catch(function(err){
          if (btn) { btn.disabled = false; btn.textContent = "Confirm Re-Assign"; }
          alert(err.message || "Re-assign fail.");
        });
    }
  });
})();

function dssFmtLabel(k) { return String(k).replace(/([a-z])([A-Z])/g, "$1 $2"); }
function dssEsc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;"); }

function dssBuildRows(obj, skip) {
  if (!obj) return '<div class="text-muted" style="font-size:12px;">No data</div>';
  var html = "";
  for (var k in obj) {
    if (skip.indexOf(k) > -1) continue;
    var v = obj[k]; if (v === null || v === undefined || v === "") v = "-";
    if (String(k).toLowerCase().indexOf("date") > -1 && v !== "-") { try { v = new Date(v).toLocaleString(); } catch (err) { } }
    html += '<div class="dss-row"><span>' + dssEsc(dssFmtLabel(k)) + '</span><span>' + dssEsc(v) + '</span></div>';
  }
  return html || '<div class="text-muted" style="font-size:12px;">No data</div>';
}

window.openTicketDetails = function (id) {
  var modalEl = document.getElementById("dssTicketModal");
  if (!modalEl || !id) return;
  var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
  var titleEl = document.getElementById("dssTicketModalTitle");
  var bodyEl = document.getElementById("dssTicketModalBody");
  var editEl = document.getElementById("dssTicketModalEdit");

  titleEl.textContent = "Loading…";
  bodyEl.innerHTML = '<div class="text-center p-5"><div class="spinner-border text-dark"></div></div>';
  if (editEl) editEl.href = "/DailySupport/Edit/" + id;
  modal.show();

  fetch("/DailySupport/GetDetails?id=" + encodeURIComponent(id) + "&single=true", { headers: { "X-Requested-With": "XMLHttpRequest" } })
    .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
    .then(function (data) {
      var t = data.ticket || {}, c = data.customer || {}, h = data.history || [], audit = data.audit || [];
      titleEl.textContent = ((t.TicketNo || "") + (t.CompanyName ? " - " + t.CompanyName : "")).replace(/[\u0000-\u001F\u007F-\u009F]/g, "");
      var skip = ["SupportId", "ClientId", "CustomerID", "UserId", "VisitTypeId", "AssignedTo", "CallerName", "Description", "CompanyName"];

      function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;"); }
      var fieldLabels = { AssignedTo: "Assigned To", ClientId: "Customer", Status: "Status", Priority: "Priority", Issue: "Issue", Description: "Description", Solution: "Solution", Mobile: "Mobile", CallerName: "Caller Name", Category: "Category", Channel: "Channel", CallType: "Call Type" };

      // Audit trail: kaun banaya / kisne kya kab edit kiya (time + naam ke saath)
      // NOTE: Ek save par saare changed fields ki alag-alag rows banti hain (same user + same time).
      // Re-assign + edit bhi same time par ho to sab EK hi row me dikhte hain.
      var auditGroups = [];
      function isChangeAction(x) { return x === "Edited" || x === "Reassigned"; }
      audit.forEach(function (a) {
        var t = a.ChangedOn ? new Date(a.ChangedOn).getTime() : 0;
        var whoName = a.ChangedByName || a.ChangedBy || "-";
        var last = auditGroups.length ? auditGroups[auditGroups.length - 1] : null;
        // Same user + lagbhag same time (2 sec andar) + dono change actions = ek hi row
        if (last && isChangeAction(a.Action) && isChangeAction(last.action) &&
            (last.who || "") === (whoName || "") &&
            Math.abs(t - last.firstTime) <= 2000) {
          last.items.push(a);
          if (t > last.lastTime) last.lastTime = t;
        } else {
          auditGroups.push({ action: a.Action, who: whoName, firstTime: t, lastTime: t, items: [a] });
        }
      });

      var auditHtml = auditGroups.length
        ? auditGroups.map(function (g) {
            var when = g.firstTime ? new Date(g.lastTime).toLocaleString() : "-";
            var who = g.who || "-";
            if (g.action === "Created") {
              return "<tr><td style='white-space:nowrap;font-size:11px;'>" + when + "</td>" +
                "<td style='white-space:nowrap;font-size:11px;'><b>" + esc(who) + "</b></td>" +
                "<td style='font-size:11px;'><span class='badge' style='background:#dcfce7;color:#166534;'>Created</span> New ticket created</td>" +
                "<td style='font-size:11px;color:#94a3b8;'>-</td></tr>";
            }
            // Ek hi row me: Re-Assign + Edited (jo bhi us time par hua) ke saare changes
            var hasReassign = false, hasEdit = false, gReason = "";
            for (var gi = 0; gi < g.items.length; gi++) {
              if (g.items[gi].Action === "Reassigned") hasReassign = true; else hasEdit = true;
              if (!gReason && g.items[gi].Reason) gReason = g.items[gi].Reason;
            }
            var changes = g.items.map(function (a) {
              var label = fieldLabels[a.FieldName] || a.FieldName || "Field";
              return "<b>" + esc(label) + "</b>: " +
                (a.OldValue ? "<span class='text-danger text-decoration-line-through'>" + esc(a.OldValue) + "</span> → " : "") +
                "<span class='text-success'>" + esc(a.NewValue || "-") + "</span>";
            }).join("<br>");
            var badgeText = hasReassign && hasEdit
              ? "Re-Assigned + Edited"
              : (hasReassign ? "Re-Assigned" : (g.items.length > 1 ? "Edited (" + g.items.length + " changes)" : "Edited"));
            var badgeStyle = hasReassign
              ? "background:#fef3c7;color:#92400e;"
              : "background:#e0e7ff;color:#3730a3;";
            return "<tr><td style='white-space:nowrap;font-size:11px;'>" + when + "</td>" +
              "<td style='white-space:nowrap;font-size:11px;'><b>" + esc(who) + "</b></td>" +
              "<td style='font-size:11px;'><span class='badge' style='" + badgeStyle + "'>" + badgeText + "</span> " + changes + "</td>" +
              "<td style='font-size:11px;'>" + (gReason ? "<span class='fst-italic'>" + esc(gReason) + "</span>" : "<span class='text-muted'>-</span>") + "</td></tr>";
          }).join("")
        : "<tr><td colspan='4' class='text-center text-muted'>No history</td></tr>";

      bodyEl.innerHTML =
        "<div class='p-3'>" +
          "<div class='row g-2 mb-2'>" +
            "<div class='col-md-6'><div class='modal-info h-100'><div class='dss-modal-sec'>Ticket Info</div>" + dssBuildRows(t, skip) + "</div></div>" +
            "<div class='col-md-6'><div class='modal-info h-100'><div class='dss-modal-sec'>Customer Info</div>" + dssBuildRows(c, ["ClientId"]) + "</div></div>" +
          "</div>" +
          "<div class='modal-info'><div class='dss-modal-sec'>History (Created & Edits)</div>" +
            "<table class='table table-sm mb-0' style='font-size:12px;'><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Reason</th></tr></thead><tbody>" + auditHtml + "</tbody></table>" +
          "</div>" +
        "</div>";
    })
    .catch(function (err) {
      bodyEl.innerHTML = "<div class='p-4 text-danger text-center'>Failed to load: " + err.message + "</div>";
    });
};
</script>
