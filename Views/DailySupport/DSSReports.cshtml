@* @using ClientVisitManagement.Models
@model DSSReportViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "DSS Reports";
}
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    .card-dss{border:1px solid #e5e7f0;border-radius:12px;background:#fff;box-shadow:0 1px 6px rgba(0,0,0,0.04);}
    .label-dss{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6b7280;margin-bottom:4px;display:block;}
    .input-dss{font-size:13px;border-radius:8px;border:1px solid #e5e7eb;padding:6px 10px;height:36px;}
    .input-dss:focus{border-color:#2563eb;box-shadow:0 0 0 2px rgba(37,99,235,0.12);}
    .btn-dss-light{background:#fff;border:1px solid #e5e7eb;border-radius:8px;font-size:13px;font-weight:600;padding:6px 14px;}
    .table-dss thead th{font-size:11px;text-transform:uppercase;letter-spacing:0.05em;color:#6b7280;background:#f9fafb;font-weight:700;padding:10px 12px;white-space:nowrap;border-bottom:1px solid #f3f4f6;position:sticky;top:0;z-index:10;cursor:pointer;}
    .table-dss tbody td{font-size:13px;padding:10px 12px;border-bottom:1px solid #f9fafb;}
    .table-dss tbody tr:hover{background:#f8fafc;}
    .badge-pri-Urgent{background:#fee2e2;color:#dc2626;border:1px solid #fecaca;border-radius:5px;font-size:11px;padding:3px 7px;font-weight:600;}
    .badge-pri-High{background:#ffedd5;color:#ea580c;border:1px solid #fed7aa;border-radius:5px;font-size:11px;padding:3px 7px;font-weight:600;}
    .badge-pri-Medium{background:#fef3c7;color:#d97706;border:1px solid #fde68a;border-radius:5px;font-size:11px;padding:3px 7px;font-weight:600;}
    .badge-pri-Low{background:#dcfce7;color:#16a34a;border:1px solid #bbf7d0;border-radius:5px;font-size:11px;padding:3px 7px;font-weight:600;}
    .table-scroll{max-height:600px;overflow-y:auto;overflow-x:auto;}
    .table-scroll::-webkit-scrollbar{width:5px;height:5px;}
    .table-scroll::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:10px;}
</style>

<div style="max-width:1450px;margin:0 auto;padding:8px 12px;">
    <!-- COMPACT HEADER - No extra text -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="fw-bold mb-0" style="font-size:18px;letter-spacing:-0.02em;">DSS Reports - Detailed Report</h4>
        <div class="d-flex gap-2">
            <a href="/DailySupport/ExportExcel?fromDate=@Model.FromDate&toDate=@Model.ToDate&status=@Model.FilterStatus&priority=@Model.FilterPriority&search=@Model.SearchTerm" class="btn-dss-light text-decoration-none"><i class="bi bi-file-earmark-excel me-1"></i> Excel</a>
            <a href="/DailySupport" class="btn-dss-light text-decoration-none">Back</a>
        </div>
    </div>

    <div class="card-dss p-3 mb-3">
        <form method="get" id="autoFilterForm">
            <div class="row g-2">
                <div class="col-6 col-lg-2">
                    <label class="label-dss">From Date</label>
                    <input type="date" name="fromDate" value="@Model.FromDate" class="form-control input-dss auto-filter" />
                </div>
                <div class="col-6 col-lg-2">
                    <label class="label-dss">To Date</label>
                    <input type="date" name="toDate" value="@Model.ToDate" class="form-control input-dss auto-filter" />
                </div>
                <div class="col-6 col-lg-2">
                    <label class="label-dss">Status</label>
                    <select name="status" class="form-select input-dss auto-filter">
                        <option value="">All Status</option>
                        <option value="Open" selected="@(Model.FilterStatus=="Open" ? "selected" : null)">Open</option>
                        <option value="In Progress" selected="@(Model.FilterStatus=="In Progress" ? "selected" : null)">In Progress</option>
                        <option value="On Hold" selected="@(Model.FilterStatus=="On Hold" ? "selected" : null)">On Hold</option>
                        <option value="Closed" selected="@(Model.FilterStatus=="Closed" ? "selected" : null)">Closed</option>
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="label-dss">Priority</label>
                    <select name="priority" class="form-select input-dss auto-filter">
                        <option value="">All Priority</option>
                        <option value="Urgent" selected="@(Model.FilterPriority=="Urgent" ? "selected" : null)">Urgent</option>
                        <option value="High" selected="@(Model.FilterPriority=="High" ? "selected" : null)">High</option>
                        <option value="Medium" selected="@(Model.FilterPriority=="Medium" ? "selected" : null)">Medium</option>
                        <option value="Low" selected="@(Model.FilterPriority=="Low" ? "selected" : null)">Low</option>
                    </select>
                </div>
                <div class="col-8 col-lg-3">
                    <label class="label-dss">Search</label>
                    <input type="text" name="search" id="search" value="@Model.SearchTerm" class="form-control input-dss auto-filter-search" placeholder="Ticket, Mobile, Issue..." />
                </div>
                <div class="col-4 col-lg-1 d-flex align-items-end gap-2">
                    <a href="/DailySupport/DSSReports" class="btn-dss-light text-decoration-none w-100 text-center">Reset</a>
                </div>
            </div>
            <div class="mt-2 text-end" style="font-size:11px;color:#6b7280;">Total: <b class="text-dark">@Model.TotalCalls</b> • <span id="filterStatus">Showing @Model.Calls.Count</span></div>
        </form>
    </div>

    <div class="card-dss overflow-hidden">
        <div class="px-3 py-2 border-bottom d-flex justify-content-between">
            <span class="fw-semibold" style="font-size:13px;">Detailed Calls - @Model.Calls.Count Records</span>
            <small class="text-muted" style="font-size:11px;">Click header to sort</small>
        </div>
        <div class="table-scroll">
            <table class="table table-dss mb-0" id="reportTable">
                <thead>
                    <tr>
                        <th onclick="sortTable(0)">Ticket No</th>
                        <th onclick="sortTable(1)">Date & Time</th>
                        <th>Customer</th>
                        <th>Mobile</th>
                        <th>Issue</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Assigned</th>
                        <th>Age</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Calls != null && Model.Calls.Any())
                    {
                        foreach (var c in Model.Calls)
                        {
                            var dateVal = c.ContainsKey("SupportDate") ? c["SupportDate"] : null;
                            DateTime dateIn = ClientVisitManagement.AppTime.Now; if(dateVal!=null){try{dateIn=Convert.ToDateTime(dateVal);}catch{}}
                            var ageing = (ClientVisitManagement.AppTime.Now - dateIn).Days;
                            var priority = c.ContainsKey("Priority") ? c["Priority"]?.ToString() : "Medium";
                            var status = c.ContainsKey("Status") ? c["Status"]?.ToString() : "Open";
                            var ticketNo = c.ContainsKey("TicketNo") ? c["TicketNo"]?.ToString() : "";
                            var company = c.ContainsKey("CompanyName") ? c["CompanyName"]?.ToString() : (c.ContainsKey("ClientName") ? c["ClientName"]?.ToString() : "");
                            var mobile = c.ContainsKey("Mobile") ? c["Mobile"]?.ToString() : "";
                            var problem = c.ContainsKey("Issue") ? c["Issue"]?.ToString() : "";
                            var assigned = c.ContainsKey("AssignedToName") ? c["AssignedToName"]?.ToString() : (c.ContainsKey("AssignedName") ? c["AssignedName"]?.ToString() : "");
                            var callId = c.ContainsKey("SupportId") ? c["SupportId"]?.ToString() : "";
                            <tr>
                                <td><span style="background:#111827;color:#fff;padding:3px 7px;border-radius:5px;font-size:11px;font-weight:700;">@ticketNo</span></td>
                                <td><span style="font-size:12px;">@dateIn.ToString("dd-MM-yy hh:mm tt")</span></td>
                                <td style="font-size:13px;font-weight:500;">@company</td>
                                <td>@mobile</td>
                                <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@problem">@problem</td>
                                <td><span class="badge-pri-@priority">@priority</span></td>
                                <td><span class="badge bg-light border text-dark" style="border-radius:12px;font-size:11px;">@status</span></td>
                                <td style="font-size:12px;">@assigned</td>
                                <td>@(ageing==0 ? "Today" : ageing+"d")</td>
                                <td><a href="/DailySupport/Edit/@callId" class="btn btn-sm border bg-white" style="width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:6px;"><i class="bi bi-eye" style="font-size:12px;"></i></a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="10" class="text-center text-muted p-4">No records</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
let sortDir={};
function sortTable(i){
    const tb=document.getElementById('reportTable').tBodies[0];
    const rows=Array.from(tb.rows);
    const dir=sortDir[i]==='asc'?'desc':'asc'; sortDir[i]=dir;
    rows.sort((a,b)=>{let av=a.cells[i]?.innerText||'',bv=b.cells[i]?.innerText||'';return dir==='asc'?av.localeCompare(bv):bv.localeCompare(av);});
    rows.forEach(r=>tb.appendChild(r));
}
document.addEventListener('DOMContentLoaded',function(){
    const form=document.getElementById('autoFilterForm');
    document.querySelectorAll('.auto-filter').forEach(el=>{el.addEventListener('change',()=>form.submit());});
    const s=document.getElementById('search'); let t;
    if(s){
        s.addEventListener('input',function(){
            clearTimeout(t);
            t=setTimeout(()=>{ if(s.value.length>=2 || s.value.length===0) form.submit(); },500);
        });
        s.addEventListener('keydown',function(e){ if(e.key==='Enter'){e.preventDefault(); form.submit();} });
    }
});
</script> *@


@using ClientVisitManagement.Models
@model DSSReportViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
    ViewData["Title"] = "DSS Reports";
    int totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalCalls / Model.PageSize) : 1;
    if(totalPages==0) totalPages=1;
    // Current page ko valid range me rakho + "Showing X to Y" sahi nikale
    int curPage = Model.CurrentPage<1 ? 1 : (Model.CurrentPage>totalPages ? totalPages : Model.CurrentPage);
    int showingFrom = Model.TotalCalls==0 ? 0 : ((curPage-1)*Model.PageSize)+1;
    int showingTo = Math.Min(curPage*Model.PageSize, Model.TotalCalls);
}
<style>
    .card-dss{border:1px solid #e5e7f0;border-radius:12px;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,0.04);}
    .label-dss{font-size:10px;font-weight:700;text-transform:uppercase;color:#6b7280;margin-bottom:4px;display:block;}
    .input-dss{font-size:13px;border-radius:8px;border:1px solid #e5e7eb;height:36px;padding:6px 10px;}
    .btn-dss-light{background:#fff;border:1px solid #e5e7eb;border-radius:8px;font-size:13px;font-weight:600;padding:6px 14px;}
    .btn-export{background:#111827;color:#fff;border-radius:8px;font-size:13px;font-weight:600;padding:7px 16px;border:0;display:flex;align-items:center;gap:6px;}
    .dropdown-export{position:relative;display:inline-block;}
    .dropdown-menu-export{position:absolute;right:0;top:100%;margin-top:6px;min-width:180px;background:#fff;border:1px solid #e5e7eb;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,0.12);padding:6px;z-index:100;display:none;}
    .dropdown-menu-export.show{display:block;}
    .dropdown-item-export{display:flex;align-items:center;gap:10px;padding:9px 12px;font-size:13px;font-weight:500;border-radius:8px;cursor:pointer;color:#111827;text-decoration:none;width:100%;border:0;background:transparent;text-align:left;}
    .dropdown-item-export:hover{background:#f9fafb;}
    .badge-pri-Urgent{background:#fee2e2;color:#dc2626;border:1px solid #fecaca;border-radius:5px;font-size:11px;padding:3px 7px;font-weight:600;}
    .badge-pri-High{background:#ffedd5;color:#ea580c;border:1px solid #fed7aa;border-radius:5px;font-size:11px;padding:3px 7px;font-weight:600;}
    .badge-pri-Medium{background:#fef3c7;color:#d97706;border:1px solid #fde68a;border-radius:5px;font-size:11px;padding:3px 7px;font-weight:600;}
    .badge-pri-Low{background:#dcfce7;color:#16a34a;border:1px solid #bbf7d0;border-radius:5px;font-size:11px;padding:3px 7px;font-weight:600;}
    .controls-bar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;padding:10px 14px;font-size:12px;background:#fff;border:1px solid #e5e7f0;border-top:0;border-radius:0 0 12px 12px;}
    .page-size-select{height:34px;border-radius:8px;font-size:13px;padding:5px 12px;border:1px solid #e5e7eb;background:#fff;min-width:75px;cursor:pointer;}
    .table-wrapper{border:1px solid #e5e7f0;border-bottom:0;border-radius:12px 12px 0 0;background:#fff;overflow:hidden;position:relative;}
    .table-scroll{height:calc(100vh - 255px);min-height:420px;max-height:none;overflow:auto;}
    .table-dss{width:100%;border-collapse:collapse;margin:0;table-layout:auto;}
    .table-dss thead th{font-size:11px;text-transform:uppercase;color:#6b7280;background:#f9fafb !important;font-weight:700;padding:8px 8px;white-space:nowrap;border-bottom:2px solid #e5e7eb;position:sticky;top:0;z-index:10;}
    .table-dss tbody td{font-size:12.5px;padding:6px 8px;border-bottom:1px solid #f3f4f6;background:#fff;white-space:normal;overflow-wrap:anywhere;vertical-align:middle;max-width:190px;}
    .table-dss tbody td.issue-col{max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
    .page-btn{width:34px;height:34px;border-radius:8px;border:1px solid #e5e7eb;background:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;cursor:pointer;}
    .page-btn.active{background:#111827;color:#fff;border-color:#111827;}
    .page-btn:disabled{opacity:.35;cursor:not-allowed;}
    .page-box{height:34px;min-width:120px;display:flex;align-items:center;justify-content:center;gap:5px;padding:0 14px;border:1px solid #e5e7eb;border-radius:8px;background:#f9fafb;font-size:13px;color:#374151;white-space:nowrap;}
    .loading-overlay{position:absolute;inset:0;background:rgba(255,255,255,.75);display:none;align-items:center;justify-content:center;z-index:30;}
    .loading-overlay.show{display:flex;}
    /* Report View popup - compact */
    #detailModal .modal-dialog{max-width:860px;width:calc(100vw - 32px);}
    #detailModal .modal-content{border-radius:12px;}
    #detailModal .modal-header{padding:8px 14px;}
    #detailModal .modal-title{font-size:13px;}
    #detailModal .modal-body{padding:0;max-height:calc(100vh - 140px);overflow-y:auto;}
    #detailModal .modal-footer{padding:6px 12px;}
    #detailModal .modal-footer .btn{font-size:12px;padding:3px 10px;}
    #detailModal .nav-tabs .nav-link{padding:4px 10px;font-size:12px;border-radius:6px 6px 0 0;}
    #detailModal .tab-content{padding:8px;}
    #detailModal .tab-pane .table th,#detailModal .tab-pane .table td{padding:3px 6px;font-size:11px;}
    #detailModal .tab-pane .table thead th{font-size:10px;text-transform:uppercase;color:#6b7280;}
    @@media(max-width:700px){#detailModal .modal-dialog{max-width:100%;width:calc(100vw - 12px);margin:.4rem auto;}}
</style>

<div style="max-width:1450px;margin:0 auto;padding:8px 12px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="fw-bold mb-0" style="font-size:18px;">DSS Reports - Detailed Report <small class="text-muted" style="font-size:11px;font-weight:400;margin-left:10px;"><span class="spinner-border spinner-border-sm d-none" id="loadingSpinner" style="width:12px;height:12px;"></span> <span id="statusText">Auto - No refresh</span></small></h4>
        <div class="d-flex gap-2">
            <div class="dropdown-export" id="exportDropdown">
                <button class="btn-export" id="exportBtn"><i class="bi bi-download"></i> Export <i class="bi bi-chevron-down" style="font-size:10px;"></i></button>
                <div class="dropdown-menu-export" id="exportMenu">
                    <button class="dropdown-item-export" id="printBtn"><i class="bi bi-printer"></i> Print Report</button>
                    <a class="dropdown-item-export" id="excelBtn" href="#"><i class="bi bi-file-earmark-excel" style="color:#16a34a;"></i> Export to Excel</a>
                </div>
            </div>
            <a href="/DailySupport" class="btn-dss-light text-decoration-none">Back</a>
        </div>
    </div>

    <div class="card-dss p-3 mb-3">
        <form id="autoFilterForm" onsubmit="return false;">
            <input type="hidden" id="pageInput" value="@Model.CurrentPage" />
            <div class="row g-2">
                <div class="col-6 col-lg-2"><label class="label-dss">From Date</label><input type="date" id="fromDate" value="@Model.FromDate" class="form-control input-dss auto-filter" /></div>
                <div class="col-6 col-lg-2"><label class="label-dss">To Date</label><input type="date" id="toDate" value="@Model.ToDate" class="form-control input-dss auto-filter" /></div>
                <div class="col-6 col-lg-2"><label class="label-dss">Status</label><select id="status" class="form-select input-dss auto-filter"><option value="">All Status</option><option value="Open" selected="@(Model.FilterStatus=="Open" ? "selected" : null)">Open</option><option value="In Progress" selected="@(Model.FilterStatus=="In Progress" ? "selected" : null)">In Progress</option><option value="On Hold" selected="@(Model.FilterStatus=="On Hold" ? "selected" : null)">On Hold</option><option value="Closed" selected="@(Model.FilterStatus=="Closed" ? "selected" : null)">Closed</option></select></div>
                <div class="col-6 col-lg-2"><label class="label-dss">Priority</label><select id="priority" class="form-select input-dss auto-filter"><option value="">All Priority</option><option value="Urgent" selected="@(Model.FilterPriority=="Urgent" ? "selected" : null)">Urgent</option><option value="High" selected="@(Model.FilterPriority=="High" ? "selected" : null)">High</option><option value="Medium" selected="@(Model.FilterPriority=="Medium" ? "selected" : null)">Medium</option><option value="Low" selected="@(Model.FilterPriority=="Low" ? "selected" : null)">Low</option></select></div>
                <div class="col-8 col-lg-3"><label class="label-dss">Search</label><input type="text" id="search" value="@Model.SearchTerm" class="form-control input-dss" placeholder="Ticket, Mobile, Issue..." /></div>
                <div class="col-4 col-lg-1 d-flex align-items-end"><a href="#" id="resetBtn" class="btn-dss-light text-decoration-none w-100 text-center">Reset</a></div>
            </div>
        </form>
    </div>

    <div id="printArea">
        <div class="table-wrapper" id="tableWrapper">
            <div class="loading-overlay" id="loadingOverlay"><div class="spinner-border text-dark"></div></div>
            <div class="table-scroll" id="tableScroll">
                <table class="table table-dss mb-0" id="reportTable">
                    <thead>
                        <tr>
                            <th>Ticket No</th>
                            <th>Date & Time</th>
                            <th>Customer</th>
                            <th>Mobile</th>
                            <th>Issue</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Assigned</th>
                            <th>Age</th>
                            <th class="actions-col no-print" style="width:70px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        @foreach (var c in Model.Calls)
                        {
                            var dateVal = c.ContainsKey("SupportDate") ? c["SupportDate"] : null;
                            DateTime dateIn = ClientVisitManagement.AppTime.Now; if(dateVal!=null){try{dateIn=Convert.ToDateTime(dateVal);}catch{}}
                            var ageing = (ClientVisitManagement.AppTime.Now - dateIn).Days;
                            var priority = c.ContainsKey("Priority") ? c["Priority"]?.ToString() : "Medium";
                            var status = c.ContainsKey("Status") ? c["Status"]?.ToString() : "Open";
                            var ticketNo = c.ContainsKey("TicketNo") ? c["TicketNo"]?.ToString() : "";
                            var company = c.ContainsKey("CompanyName") ? c["CompanyName"]?.ToString() : (c.ContainsKey("ClientName") ? c["ClientName"]?.ToString() : "");
                            var mobile = c.ContainsKey("Mobile") ? c["Mobile"]?.ToString() : "";
                            var problem = c.ContainsKey("Issue") ? c["Issue"]?.ToString() : "";
                            var assigned = c.ContainsKey("AssignedToName") ? c["AssignedToName"]?.ToString() : (c.ContainsKey("AssignedName") ? c["AssignedName"]?.ToString() : "");
                            var callId = c.ContainsKey("SupportId") ? c["SupportId"]?.ToString() : "";
                            <tr>
                                <td><span style="background:#111827;color:#fff;padding:4px 8px;border-radius:6px;font-size:11px;font-weight:700;">@ticketNo</span></td>
                                <td style="font-size:12px;">@dateIn.ToString("dd-MM-yy hh:mm tt")</td>
                                <td style="font-weight:500;">@company</td>
                                <td>@mobile</td>
                                <td class="issue-col" title="@problem">@problem</td>
                                <td><span class="badge-pri-@priority">@priority</span></td>
                                <td><span class="badge bg-light border text-dark" style="border-radius:20px;font-size:11px;">@status</span></td>
                                <td style="font-size:12px;">@assigned</td>
                                <td>@(ageing==0 ? "Today" : ageing+"d")</td>
                                <td class="actions-cell no-print">
                                    <button type="button" class="btn btn-sm border bg-white view-btn" data-id="@callId" style="width:30px;height:30px;display:flex;align-items:center;justify-content:center;border-radius:8px;">
                                        <i class="bi bi-eye" style="font-size:13px;"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- ===== PAGINATION - grid ke NEECHE (bottom side) ===== -->
    <div class="controls-bar">
        <div class="d-flex align-items-center gap-2"><span>Show</span><select id="pageSizeSelect" class="page-size-select"><option value="10" selected="@(Model.PageSize==10 ? "selected" : null)">10</option><option value="25" selected="@(Model.PageSize==25 ? "selected" : null)">25</option><option value="50" selected="@(Model.PageSize==50 ? "selected" : null)">50</option><option value="100" selected="@(Model.PageSize==100 ? "selected" : null)">100</option></select><span>entries</span></div>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="text-muted" id="tableInfo">Total: <b class="text-dark">@Model.TotalCalls</b></div>
            <div style="font-size:12px;color:#6b7280;" id="showingInfo">Showing @showingFrom to @showingTo of @Model.TotalCalls</div>
        </div>
        <div class="d-flex gap-2 align-items-center" id="pageNumbers">
            <button class="page-btn" id="prevBtn" @(curPage<=1 ? "disabled" : "") title="Previous page"><i class="bi bi-chevron-left"></i></button>
            <div class="page-box">Page <b id="infoPage">@curPage</b> of <b id="infoTotalPages">@totalPages</b></div>
            <button class="page-btn" id="nextBtn" @(curPage>=totalPages ? "disabled" : "") title="Next page"><i class="bi bi-chevron-right"></i></button>
        </div>
    </div>
</div>

<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content" style="border-radius:16px;overflow:hidden;">
      <div class="modal-header" style="background:#111827;color:#fff;padding:14px 18px;">
        <h6 class="modal-title mb-0" id="modalTicketNo" style="font-weight:700;">Ticket Details</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0" id="modalBody">
        <div class="text-center p-5"><div class="spinner-border text-dark"></div></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Close</button>
        <a href="#" id="modalEditLink" class="btn btn-sm" style="background:#111827;color:#fff;">Open Full Form</a>
      </div>
    </div>
  </div>
</div>

<script>
var currentPage = @Model.CurrentPage; var currentPageSize = @Model.PageSize;
function buildQuery(page, partial){
    const params = new URLSearchParams();
    // partial=1 -> server sirf grid ka partial (rows) bhejta hai
    if(partial) params.set('partial','1');
    params.set('fromDate', document.getElementById('fromDate').value || '');
    params.set('toDate', document.getElementById('toDate').value || '');
    params.set('status', document.getElementById('status').value || '');
    params.set('priority', document.getElementById('priority').value || '');
    params.set('search', document.getElementById('search').value || '');
    params.set('page', page || currentPage);
    params.set('pageSize', currentPageSize);
    return params.toString();
}
function updateExcelLink(){ document.getElementById('excelBtn').href = '/DailySupport/ExportExcel?' + buildQuery(1,false); }
function loadData(page){
    if(page) currentPage = page;
    const query = buildQuery(currentPage,true);
    document.getElementById('loadingOverlay').classList.add('show');
    fetch('/DailySupport/DSSReports?' + query, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(async r => {
        const total = r.headers.get('X-Total-Calls') || 0;
        const tPages = r.headers.get('X-Total-Pages') || 1;
        const cPage = r.headers.get('X-Current-Page') || 1;
        const from = r.headers.get('X-Showing-From') || 1;
        const to = r.headers.get('X-Showing-To') || 0;
        const html = await r.text();
        document.getElementById('tableBody').innerHTML = html;
        currentPage = parseInt(cPage);
        // tableInfo sirf Total dikhata hai; page number alag "page-box" me hota hai
        document.getElementById('tableInfo').innerHTML = `Total: <b>${total}</b>`;
        document.getElementById('showingInfo').innerText = `Showing ${from} to ${to} of ${total}`;
        const div = document.getElementById('pageNumbers');
        div.innerHTML =
            `<button class="page-btn" id="prevBtn" ${currentPage<=1?'disabled':''} title="Previous page"><i class="bi bi-chevron-left"></i></button>`+
            `<div class="page-box">Page <b>${currentPage}</b> of <b>${tPages}</b></div>`+
            `<button class="page-btn" id="nextBtn" ${currentPage>=tPages?'disabled':''} title="Next page"><i class="bi bi-chevron-right"></i></button>`;
        updateExcelLink();
    }).catch(e=>{ Ajax.toast('Could not load report data.','error'); console.error(e); })
      .finally(()=>{ document.getElementById('loadingOverlay').classList.remove('show'); });
}
function fmtLabel(k){
    var map={AssignedTo:'Assigned To',AssignedToName:'Assigned To',ClientId:'Customer',SupportId:'Support ID',CustomerID:'Customer ID',Status:'Status',Priority:'Priority',Issue:'Issue',Description:'Description',Solution:'Solution',Mobile:'Mobile',CallerName:'Caller Name',Category:'Category',Channel:'Channel',CallType:'Call Type',SupportDate:'Support Date',TicketNo:'Ticket No',CreatedOn:'Created On',CompanyName:'Company'};
    if(map[k]) return map[k];
    return k.replace(/([a-z])([A-Z])/g,'$1 $2');
}
function esc(v){ return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
function fmtDate(v){ if(v===null||v===undefined||v==='') return '-'; var d=(v instanceof Date)?v:new Date(v); return isNaN(d.getTime()) ? String(v) : d.toLocaleString(); }
function buildRows(obj, skip){
    if(!obj) return '<div class="text-muted p-2" style="font-size:12px;">No data</div>';
    var html='';
    for(var k in obj){
        if(skip && skip.indexOf(k)>=0) continue;
        var v=obj[k]; if(v===null||v===undefined||v==='') v='-';
        if(v!=='-' && (k.toLowerCase().indexOf('date')>=0 || k==='CreatedOn')) v=fmtDate(v);
        html += '<div class="d-flex justify-content-between mb-2" style="gap:12px;"><span style="font-size:12px;color:#6b7280;white-space:nowrap;">'+esc(fmtLabel(k))+':</span><span style="font-size:12px;font-weight:500;text-align:right;word-break:break-word;">'+esc(v)+'</span></div>';
    }
    return html || '<div class="text-muted p-2" style="font-size:12px;">No data</div>';
}
function ticketBadge(no,id){
    if(!no) return '<span class="text-muted">-</span>';
    if(!id) return '<span style="background:#111827;color:#fff;padding:2px 7px;border-radius:5px;font-size:11px;font-weight:700;">'+esc(no)+'</span>';
    return '<button type="button" onclick="openDetailModal('+id+')" title="Ye ticket kholo" style="background:#111827;color:#fff;border:0;padding:2px 7px;border-radius:5px;font-size:11px;font-weight:700;cursor:pointer;">'+esc(no)+'</button>';
}
function priBadge(p){
    var ok=['Urgent','High','Medium','Low'].indexOf(p)>=0;
    return ok ? '<span class="badge-pri-'+esc(p)+'">'+esc(p)+'</span>' : '<span>'+esc(p||'-')+'</span>';
}
function statusPill(s){
    return '<span class="badge bg-light border text-dark" style="border-radius:20px;font-size:11px;white-space:nowrap;">'+esc(s||'-')+'</span>';
}
// Same user + ~same time (2 sec) + change actions = ek hi row
function groupAudit(rows, withTicket){
    rows=rows||[];
    var sorted=rows.slice().sort(function(a,b){
        var ta=a.ChangedOn?new Date(a.ChangedOn).getTime():0, tb=b.ChangedOn?new Date(b.ChangedOn).getTime():0;
        if(ta!==tb) return ta-tb;
        return (a.HistoryId||0)-(b.HistoryId||0);
    });
    var groups=[];
    sorted.forEach(function(a){
        var t=a.ChangedOn?new Date(a.ChangedOn).getTime():0;
        var last=groups.length?groups[groups.length-1]:null;
        var change=(a.Action==='Edited'||a.Action==='Reassigned');
        var lastChange=last && (last.action==='Edited'||last.action==='Reassigned');
        var sameTicket=!withTicket || (last && String(last.supportId)===String(a.SupportId));
        if(last && change && lastChange && sameTicket && (last.who||'')===(a.ChangedByName||'') && Math.abs(t-last.firstTime)<=2000){
            last.items.push(a);
            if(t>last.lastTime) last.lastTime=t;
        } else {
            groups.push({action:a.Action,who:a.ChangedByName,firstTime:t,lastTime:t,items:[a],supportId:a.SupportId,ticketNo:a.TicketNo});
        }
    });
    return groups;
}
function auditTable(rows, withTicket, emptyText){
    var groups=groupAudit(rows, withTicket);
    if(!groups.length) return '<div class="text-muted p-3" style="font-size:12px;">'+esc(emptyText||'No history')+'</div>';
    groups.reverse(); // latest first
    var head='<tr><th>Time</th>'+(withTicket?'<th>Ticket</th>':'')+'<th>User</th><th>Action</th><th>Reason</th></tr>';
    var body=groups.map(function(g){
        var when=fmtDate(g.lastTime?new Date(g.lastTime):null);
        var who='<b>'+esc(g.who||'-')+'</b>';
        var tcell=withTicket?'<td style="white-space:nowrap;">'+ticketBadge(g.ticketNo,g.supportId)+'</td>':'';
        if(g.action==='Created'){
            return '<tr><td style="white-space:nowrap;font-size:11px;">'+when+'</td>'+tcell+'<td style="white-space:nowrap;font-size:11px;">'+who+'</td><td style="font-size:11px;"><span class="badge" style="background:#dcfce7;color:#166534;">Created</span> New ticket created</td><td style="font-size:11px;color:#94a3b8;">-</td></tr>';
        }
        var hasReassign=false, hasEdit=false, reason='';
        g.items.forEach(function(a){
            if(a.Action==='Reassigned') hasReassign=true; else hasEdit=true;
            if(!reason && a.Reason) reason=a.Reason;
        });
        var changes=g.items.map(function(a){
            var label=fmtLabel(a.FieldName||'');
            var oldV=a.OldValue ? '<span style="color:#dc2626;text-decoration:line-through;">'+esc(a.OldValue)+'</span> → ' : '';
            return '<b>'+esc(label)+'</b>: '+oldV+'<span style="color:#16a34a;">'+esc(a.NewValue||'-')+'</span>';
        }).join('<br>');
        var badgeText = hasReassign && hasEdit ? 'Re-Assigned + Edited' : (hasReassign ? 'Re-Assigned' : 'Edited ('+g.items.length+' change'+(g.items.length>1?'s':'')+')');
        var badgeStyle = hasReassign ? 'background:#fef3c7;color:#92400e;' : 'background:#e0e7ff;color:#3730a3;';
        return '<tr><td style="white-space:nowrap;font-size:11px;">'+when+'</td>'+tcell+'<td style="white-space:nowrap;font-size:11px;">'+who+'</td><td style="font-size:11px;"><span class="badge" style="'+badgeStyle+'">'+badgeText+'</span> '+changes+'</td><td style="font-size:11px;">'+(reason?'<span class="fst-italic">'+esc(reason)+'</span>':'<span class="text-muted">-</span>')+'</td></tr>';
    }).join('');
    return '<div class="table-responsive" style="max-height:220px;overflow:auto;"><table class="table table-sm mb-0" style="font-size:12px;"><thead style="position:sticky;top:0;background:#f9fafb;z-index:2;">'+head+'</thead><tbody>'+body+'</tbody></table></div>';
}
function clientCallsTable(rows){
    if(!rows || !rows.length) return '<div class="text-muted p-3" style="font-size:12px;">Is client ki koi call nahi mili.</div>';
    var body=rows.map(function(c){
        var age=null; if(c.SupportDate){ var d=new Date(c.SupportDate); if(!isNaN(d.getTime())) age=Math.floor((Date.now()-d.getTime())/86400000); }
        return '<tr><td style="white-space:nowrap;">'+ticketBadge(c.TicketNo,c.SupportId)+'</td><td style="font-size:12px;white-space:nowrap;">'+esc(fmtDate(c.SupportDate))+'</td><td title="'+esc(c.Issue)+'"><span style="display:inline-block;max-width:230px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:bottom;">'+esc(c.Issue||'-')+'</span></td><td>'+priBadge(c.Priority)+'</td><td>'+statusPill(c.Status)+'</td><td style="font-size:12px;white-space:nowrap;">'+esc(c.AssignedToName||'-')+'</td><td style="white-space:nowrap;">'+(age===null?'-':(age<=0?'Today':age+'d'))+'</td></tr>';
    }).join('');
    return '<div class="table-responsive" style="max-height:220px;overflow:auto;"><table class="table table-sm mb-0" style="font-size:12px;"><thead style="position:sticky;top:0;background:#f9fafb;z-index:2;"><tr><th>Ticket</th><th>Date</th><th>Issue</th><th>Priority</th><th>Status</th><th>Assigned</th><th>Age</th></tr></thead><tbody>'+body+'</tbody></table></div>';
}
var dssDetailModal=null;
function openDetailModal(id){
    var modalEl=document.getElementById('detailModal');
    if(!dssDetailModal) dssDetailModal=new bootstrap.Modal(modalEl);
    document.getElementById('modalTicketNo').innerText='Loading...';
    document.getElementById('modalBody').innerHTML='<div class="text-center p-5"><div class="spinner-border text-dark"></div></div>';
    document.getElementById('modalEditLink').href='/DailySupport/Edit/'+id;
    dssDetailModal.show();
    fetch('/DailySupport/GetDetails?id='+encodeURIComponent(id)+'&includeAudit=true&includeClientHistory=true',{headers:{'X-Requested-With':'XMLHttpRequest'}})
    .then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
    .then(function(data){
        var t=data.ticket||{}, c=data.customer||{}, audit=data.audit||[], calls=data.clientHistory||[], activity=data.clientAudit||[];
        document.getElementById('modalTicketNo').innerText=(t.TicketNo||'')+(t.CompanyName?' - '+t.CompanyName:(c.ClientName?' - '+c.ClientName:''));
        var ticketSkip=['SupportId','ClientId','CustomerID','AssignedTo','CompanyName'];
        var groupsCount=groupAudit(activity,true).length;
        var hasClient=!!(c && (c.ClientId!==undefined || c.ClientName));
        var html='<ul class="nav nav-tabs px-3 pt-2" role="tablist">'+
            '<li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#dssTabDetails" type="button">Details</button></li>'+
            '<li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#dssTabTicketHist" type="button">Ticket History'+(audit.length?' ('+audit.length+')':'')+'</button></li>'+
            '<li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#dssTabClient" type="button">Client Calls'+(calls.length?' ('+calls.length+')':'')+'</button></li>'+
            '<li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#dssTabActivity" type="button">Client Activity'+(groupsCount?' ('+groupsCount+')':'')+'</button></li>'+
            '</ul><div class="tab-content p-2">'+
            '<div class="tab-pane fade show active" id="dssTabDetails">'+
                '<div class="row g-2">'+
                    '<div class="col-md-6"><div style="border:1px solid #e5e7eb;border-radius:10px;padding:8px;"><div style="font-size:10px;font-weight:700;color:#6b7280;margin-bottom:5px;">Ticket Info</div>'+buildRows(t,ticketSkip)+'</div></div>'+
                    '<div class="col-md-6"><div style="border:1px solid #e5e7eb;border-radius:10px;padding:8px;"><div style="font-size:10px;font-weight:700;color:#6b7280;margin-bottom:5px;">Customer Info</div>'+(hasClient?buildRows(c,['ClientId']):'<div class="text-muted" style="font-size:12px;">Is ticket se koi client linked nahi hai.</div>')+'</div></div>'+
                '</div>'+
            '</div>'+
            '<div class="tab-pane fade" id="dssTabTicketHist"><div style="border:1px solid #e5e7eb;border-radius:10px;padding:8px;"><div style="font-size:10px;font-weight:700;color:#6b7280;margin-bottom:5px;">Is Ticket Ki History (Created &amp; Edits)</div>'+auditTable(audit,false,'Is ticket par abhi tak koi change nahi hua.')+'</div></div>'+
            '<div class="tab-pane fade" id="dssTabClient"><div style="border:1px solid #e5e7eb;border-radius:10px;padding:8px;"><div style="font-size:10px;font-weight:700;color:#6b7280;margin-bottom:5px;">Client Ki Saari Calls (Total '+calls.length+')</div>'+clientCallsTable(calls)+'</div></div>'+
            '<div class="tab-pane fade" id="dssTabActivity"><div style="border:1px solid #e5e7eb;border-radius:10px;padding:8px;"><div style="font-size:10px;font-weight:700;color:#6b7280;margin-bottom:5px;">Client Activity Timeline - kab kya hua (Total '+groupsCount+' events)</div>'+auditTable(activity,true,'Is client ke tickets par abhi tak koi change nahi hua.')+'</div></div>'+
            '</div>';
        document.getElementById('modalBody').innerHTML=html;
    })
    .catch(function(err){ console.error('GetDetails failed:',err); document.getElementById('modalBody').innerHTML='<div class="p-4 text-danger text-center">Failed to load: '+esc(err.message)+'</div>'; });
}
(function initOnLoad(){
    updateExcelLink();
    const exportBtn=document.getElementById('exportBtn'), exportMenu=document.getElementById('exportMenu');
    exportBtn.addEventListener('click', e=>{ e.stopPropagation(); exportMenu.classList.toggle('show'); });
    document.addEventListener('click', ()=>exportMenu.classList.remove('show'));
    document.getElementById('printBtn').addEventListener('click', e=>{
        e.preventDefault(); exportMenu.classList.remove('show');
        // CLEAN PRINT - sirf grid print ho (pagination / action column nahi),
        // title me active filters chalein taaki print identify ho sake
        const parts=[];
        const sd=document.getElementById('fromDate').value, ed=document.getElementById('toDate').value,
              st=document.getElementById('status').value, pr=document.getElementById('priority').value,
              sq=document.getElementById('search').value.trim();
        if(sd||ed) parts.push('Date: '+(sd||'...')+' to '+(ed||'...'));
        if(st) parts.push('Status: '+st);
        if(pr) parts.push('Priority: '+pr);
        if(sq) parts.push('Search: '+sq);
        const info=document.getElementById('showingInfo');
        if(info) parts.push(info.innerText.trim());
        window.printTable('printArea', 'DSS Reports'+(parts.length? ' ('+parts.join(' | ')+')' : ''));
    });
    document.querySelectorAll('.auto-filter').forEach(el=>el.addEventListener('change',()=>{currentPage=1;loadData(1);}));
    const s=document.getElementById('search'); let t; if(s){ s.addEventListener('input',()=>{ clearTimeout(t); t=setTimeout(()=>{currentPage=1;loadData(1);},500); }); }
    document.getElementById('pageSizeSelect').addEventListener('change', function(){ currentPageSize=parseInt(this.value); currentPage=1; loadData(1); });
    document.getElementById('pageNumbers').addEventListener('click', e=>{
        const prev=e.target.closest('#prevBtn'), next=e.target.closest('#nextBtn');
        if(prev && currentPage>1) loadData(currentPage-1);
        else if(next) loadData(currentPage+1);
    });
    document.getElementById('tableBody').addEventListener('click', e=>{
        const btn=e.target.closest('.view-btn'); if(btn){ const id=btn.getAttribute('data-id'); if(id) openDetailModal(id); }
    });
    document.getElementById('resetBtn').addEventListener('click', e=>{ e.preventDefault(); ['fromDate','toDate','status','priority','search'].forEach(id=>document.getElementById(id).value=''); currentPage=1; loadData(1); });
})();
</script>
