@model DailySupportGridViewModel
@{
    var hideCols = new HashSet<string>(StringComparer.OrdinalIgnoreCase){ "USERID","VISITTYPEID","SUPPORTID","CUSTOMERID" };
    var fixedKeys = new[] { "TicketNo","SupportDate","ClientName","Mobile","Channel","Category","Priority","AssignedName","Status" };
    // CallerName / Description grid se hata diye - ab sirf ek ISSUE column (DB: Issue) dikhta hai
    var extraCols = Model.Columns.Where(c =>!fixedKeys.Contains(c, StringComparer.OrdinalIgnoreCase) &&!hideCols.Contains(c) && c!="CompanyName" && c!="AssignedTo" && c!="ClientId" && c!="CallType" && c!="CreatedOn" && c!="CallerName" && c!="Description" ).ToList();

    // ---- Pagination numbers (server side - hamesha sahi) ----
    int pageSize = Model.PageSize>0 ? Model.PageSize : 10;
    int totalPages = Model.TotalRecords>0 ? (int)Math.Ceiling(Model.TotalRecords/(double)pageSize) : 1;
    if(totalPages<1) totalPages=1;
    int current = Model.CurrentPage<1 ? 1 : (Model.CurrentPage>totalPages ? totalPages : Model.CurrentPage);
    int showingFrom = Model.TotalRecords==0 ? 0 : ((current-1)*pageSize)+1;
    int showingTo = Math.Min(current*pageSize, Model.TotalRecords);
    // Page numbers ka window (ClientVisit jaisa: current-2 .. current+2)
    int pageStart=Math.Max(1,current-2);
    int pageEnd=Math.Min(totalPages,current+2);

    // Pager ka link - filters bhi saath me, taaki reload / copy-link par
    // bhi wahi page khule (JS na chale to bhi kaam kare)
    // Qs() sirf query string deta hai - Edit link bhi isi se banta hai, taaki
    // Edit karke wapas aane par filter na ude (page + pageSize + filters).
    string Qs(int p){
        var qs=new List<string>{ "page="+p, "pageSize="+pageSize };
        if(!string.IsNullOrWhiteSpace(Model.SearchTerm)) qs.Add("search="+Uri.EscapeDataString(Model.SearchTerm));
        if(!string.IsNullOrWhiteSpace(Model.FromDate)) qs.Add("fromDate="+Uri.EscapeDataString(Model.FromDate));
        if(!string.IsNullOrWhiteSpace(Model.ToDate)) qs.Add("toDate="+Uri.EscapeDataString(Model.ToDate));
        if(!string.IsNullOrWhiteSpace(Model.FilterStatus)) qs.Add("status="+Uri.EscapeDataString(Model.FilterStatus));
        if(!string.IsNullOrWhiteSpace(Model.FilterUser)) qs.Add("user="+Uri.EscapeDataString(Model.FilterUser));
        // "My Work" mode ka flag - Edit link + pagination me chalta rahega
        if(Model.IsMyWork) qs.Add("mywork=1");
        return string.Join("&",qs);
    }
    string BuildUrl(int p){ return (string.IsNullOrWhiteSpace(Model.BaseUrl)?"/DailySupport":Model.BaseUrl)+"?"+Qs(p); }

    // ---- STATUS badge ka colour (Closed=green, Open=red, In Progress=purple, On Hold=orange) ----
    string StatusBadgeClass(string s){
        var k=(s??"").Trim().ToLowerInvariant();
        switch(k){
            case "closed": case "resolved": case "complete": case "completed": return "badge-dss-closed";
            case "open": case "new": case "pending": return "badge-dss-open";
            case "in progress": case "inprogress": case "in-process": return "badge-dss-progress";
            case "on hold": case "onhold": case "hold": return "badge-dss-hold";
            default: return "badge-dss-other";
        }
    }
}
<style>.table-card{border-radius:12px;border:0;box-shadow:0 4px 20px rgba(0,0,0,0.06);overflow:visible;}.table-container{max-height:58vh;overflow-y:auto;overflow-x:auto;border-radius:12px 12px 0 0;}.table-container thead th{position:sticky!important;top:0!important;z-index:20!important;background:#f8fafc!important;box-shadow:0 1px 0 #e2e8f0;}.table thead th{font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.3px;padding:7px 8px!important;white-space:normal;line-height:1.15;border:0;}.table tbody td{padding:5px 8px;vertical-align:middle;font-size:12.5px;border-color:#f1f5f9;background:white;}.badge-ticket{background:#0f172a;color:white;padding:2px 7px;border-radius:6px;font-weight:700;font-size:9.5px;}.badge-cat{background:#e0f2fe;color:#0284c7;padding:3px 7px;border-radius:6px;font-size:10px;font-weight:700;}.cell-clip{display:inline-block;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:bottom;}.badge-ticket.ticket-view-btn{border:0;cursor:pointer;font-family:inherit;}.row-actions{display:flex;gap:4px;}
/* ===== PAGINATION - ClientVisit jaisa, grid ke NICHE (bottom side) ===== */
/* Pagination bar ko table se thoda neeche (12px gap) - chipka hua na lage */
.dss-grid-toolbar{margin-top:12px;}
/* Page scroll karte waqt ye section (Showing X to Y of Z entries) viewport ke NICHE chipka rahe */
.dss-grid-toolbar{position:sticky;bottom:0;z-index:30;border-radius:0 0 12px 12px;box-shadow:0 -1px 3px rgba(15,23,42,.06);}
.dss-grid-toolbar .dss-page-size{width:70px;height:30px;border-radius:8px;background:#fff;font-size:12px;}
/* ===== STATUS BADGE COLORS ===== */
.badge-dss-closed{background:#198754;color:#fff;}
.badge-dss-open{background:#dc3545;color:#fff;}
.badge-dss-progress{background:#6f42c1;color:#fff;}
.badge-dss-hold{background:#f59e0b;color:#3b2f00;}
.badge-dss-other{background:#64748b;color:#fff;}
.dss-grid-toolbar .dss-showing{font-size:12px;color:#64748b;}
.dss-grid-toolbar .dss-label{font-size:12px;color:#6c757d;}
</style>
<div class="card table-card"><div class="card-body p-0">
<div class="table-container"><table class="table table-hover mb-0 align-middle" id="dssTable"><thead><tr><th>TICKET NO</th><th>DATE & TIME</th><th>CLIENT [ID]</th><th>MOBILE</th><th>CHANNEL / TYPE</th><th>CATEGORY</th><th>PRIORITY</th><th>ASSIGNED</th><th>STATUS</th>@foreach(var ex in extraCols){<th>@ex.ToUpper()</th>}<th>ACTION</th></tr></thead><tbody>
@foreach(var row in Model.Rows){
    var ticket=row.ContainsKey("TicketNo")?row["TicketNo"]?.ToString():""; var clientId=row.ContainsKey("ClientId")?row["ClientId"]?.ToString():""; var clientName=row.ContainsKey("ClientName")?row["ClientName"]?.ToString():row.ContainsKey("CompanyName")?row["CompanyName"]?.ToString():""; var mobile=row.ContainsKey("Mobile")?row["Mobile"]?.ToString():""; var channel=row.ContainsKey("Channel")?row["Channel"]?.ToString():""; var callType=row.ContainsKey("CallType")?row["CallType"]?.ToString():""; var cat=row.ContainsKey("Category")?row["Category"]?.ToString():""; var pri=row.ContainsKey("Priority")?row["Priority"]?.ToString():""; var assigned=row.ContainsKey("AssignedName") && !string.IsNullOrWhiteSpace(row["AssignedName"]?.ToString())?row["AssignedName"]?.ToString():(row.ContainsKey("AssignedTo") && !string.IsNullOrWhiteSpace(row["AssignedTo"]?.ToString())?row["AssignedTo"]?.ToString():"Unassigned"); var statusRaw=row.ContainsKey("Status")?row["Status"]?.ToString():""; var status=string.IsNullOrWhiteSpace(statusRaw)?"Open":statusRaw.Trim(); var statusCls=StatusBadgeClass(status); var date=row.ContainsKey("SupportDate")?row["SupportDate"]:row.ContainsKey("CreatedOn")?row["CreatedOn"]:null; var id=row.ContainsKey("SupportId")?row["SupportId"]?.ToString():""; var editUrl="/DailySupport/Edit/"+id+"?"+Qs(current);
    <tr><td><button type="button" class="badge-ticket ticket-view-btn" data-id="@id" title="View full details">@ticket</button></td><td><small>@(date!=null?Convert.ToDateTime(date).ToString("dd-MM-yy hh:mm tt"):"")</small></td><td><div class="fw-bold" style="font-size:11.5px;line-height:1.2;">@clientName</div><small class="text-muted" style="font-size:10px;">[ID:@clientId]</small></td><td class="fw-bold">@mobile</td><td><small>@channel / @callType</small></td><td><span class="badge-cat">@cat</span></td><td><span class="badge bg-light border text-dark" style="font-size:10px;">@pri</span></td><td><small>@assigned</small></td><td><span class="badge @statusCls" style="font-size:10px;">@status</span></td>@foreach(var ex in extraCols){var exVal=row.ContainsKey(ex)?row[ex]?.ToString():"-"; if(string.Equals(ex,"Issue",StringComparison.OrdinalIgnoreCase)){<td><span class="cell-clip" title="@exVal">@exVal</span></td>}else{<td>@exVal</td>}}<td><div class="row-actions"><button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 ticket-view-btn" data-id="@id" title="View details"><i class="bi bi-eye"></i></button>@if(Model.CanAssign){<button type="button" class="btn btn-sm btn-outline-warning py-0 px-2 ticket-reassign-btn" data-id="@id" title="Re-Assign (kaam kisi aur ko do)"><i class="bi bi-arrow-left-right"></i></button>}<a href="@editUrl" class="btn btn-sm btn-outline-primary py-0 px-2" title="Edit" data-no-modal onclick="event.preventDefault(); window.loadPage('@editUrl', 'Edit Call');"><i class="bi bi-pencil"></i></a></div></td></tr>
}
@if(!Model.Rows.Any()){<tr><td colspan="@(10 + extraCols.Count)" class="text-center py-5 text-muted">No calls found</td></tr>}
</tbody></table></div>
<!-- ===== PAGINATION BAR (grid ke niche - bottom side) - ClientVisit jaisa ===== -->
<div class="dss-grid-toolbar d-flex flex-wrap justify-content-between align-items-center p-2 border-top bg-light gap-2" data-current-page="@current" data-total-pages="@totalPages" data-page-size="@pageSize">
  <div class="d-flex align-items-center gap-2">
    <span class="dss-label">Show per page</span>
    <select id="dssPageSizeSelect" class="form-select form-select-sm dss-page-size">
      <option value="10" selected="@(pageSize==10 ? "selected" : null)">10</option>
      <option value="20" selected="@(pageSize==20 ? "selected" : null)">20</option>
      <option value="50" selected="@(pageSize==50 ? "selected" : null)">50</option>
      <option value="100" selected="@(pageSize==100 ? "selected" : null)">100</option>
    </select>
  </div>
  <div class="dss-showing">Showing @showingFrom to @showingTo of @Model.TotalRecords entries</div>
  <div class="btn-group btn-group-sm">
    @if(current>1){
      <a href="@BuildUrl(current-1)" class="btn btn-light border dss-page" data-page="@(current-1)">Previous</a>
    }else{
      <button type="button" class="btn btn-light border" disabled>Previous</button>
    }
    @for(int p=pageStart;p<=pageEnd;p++){
      <a href="@BuildUrl(p)" class="btn dss-page @(p==current ? "btn-dark" : "btn-light border")" data-page="@p">@p</a>
    }
    @if(current<totalPages){
      <a href="@BuildUrl(current+1)" class="btn btn-light border dss-page" data-page="@(current+1)">Next</a>
    }else{
      <button type="button" class="btn btn-light border" disabled>Next</button>
    }
  </div>
</div>
</div></div>
