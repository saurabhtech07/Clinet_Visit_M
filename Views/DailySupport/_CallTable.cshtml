@model DynamicTableViewModel
@{
    var hideCols = new HashSet<string>(StringComparer.OrdinalIgnoreCase){ "USERID","VISITTYPEID","SUPPORTID","CUSTOMERID" };
    var fixedKeys = new[] { "TicketNo","SupportDate","ClientName","Mobile","Channel","Category","Priority","AssignedName","Status" };
    // CallerName / Description grid se hata diye - ab sirf ek ISSUE column (DB: Issue) dikhta hai
    var extraCols = Model.Columns.Where(c =>!fixedKeys.Contains(c, StringComparer.OrdinalIgnoreCase) &&!hideCols.Contains(c) && c!="CompanyName" && c!="AssignedTo" && c!="ClientId" && c!="CallType" && c!="CreatedOn" && c!="CallerName" && c!="Description" ).ToList();
}
<style>.table-card{border-radius:12px;border:0;box-shadow:0 4px 20px rgba(0,0,0,0.06);overflow:hidden;}.table-container{max-height:58vh;overflow-y:auto;overflow-x:hidden;}.table-container thead th{position:sticky!important;top:0!important;z-index:20!important;background:#f8fafc!important;}.table thead th{font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.3px;padding:7px 8px!important;white-space:normal;line-height:1.15;border:0;}.table tbody td{padding:5px 8px;vertical-align:middle;font-size:12.5px;border-color:#f1f5f9;background:white;}.badge-ticket{background:#0f172a;color:white;padding:3px 8px;border-radius:6px;font-weight:700;font-size:10.5px;}.badge-cat{background:#e0f2fe;color:#0284c7;padding:3px 7px;border-radius:6px;font-size:10px;font-weight:700;}.cell-clip{display:inline-block;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:bottom;}.badge-ticket.ticket-view-btn{border:0;cursor:pointer;font-family:inherit;}.row-actions{display:flex;gap:4px;}</style>
<div class="card table-card"><div class="card-body p-0"><div class="table-container"><table class="table table-hover mb-0 align-middle" id="dssTable"><thead><tr><th>TICKET NO</th><th>DATE & TIME</th><th>CLIENT [ID]</th><th>MOBILE</th><th>CHANNEL / TYPE</th><th>CATEGORY</th><th>PRIORITY</th><th>ASSIGNED</th><th>STATUS</th>@foreach(var ex in extraCols){<th>@ex.ToUpper()</th>}<th>ACTION</th></tr></thead><tbody>
@foreach(var row in Model.Rows){
    var ticket=row.ContainsKey("TicketNo")?row["TicketNo"]?.ToString():""; var clientId=row.ContainsKey("ClientId")?row["ClientId"]?.ToString():""; var clientName=row.ContainsKey("ClientName")?row["ClientName"]?.ToString():row.ContainsKey("CompanyName")?row["CompanyName"]?.ToString():""; var mobile=row.ContainsKey("Mobile")?row["Mobile"]?.ToString():""; var channel=row.ContainsKey("Channel")?row["Channel"]?.ToString():""; var callType=row.ContainsKey("CallType")?row["CallType"]?.ToString():""; var cat=row.ContainsKey("Category")?row["Category"]?.ToString():""; var pri=row.ContainsKey("Priority")?row["Priority"]?.ToString():""; var assigned=row.ContainsKey("AssignedName")?row["AssignedName"]?.ToString():row["AssignedTo"]?.ToString(); var status=row.ContainsKey("Status")?row["Status"]?.ToString():"Open"; var date=row.ContainsKey("SupportDate")?row["SupportDate"]:row.ContainsKey("CreatedOn")?row["CreatedOn"]:null; var id=row.ContainsKey("SupportId")?row["SupportId"]?.ToString():"";
    <tr><td><button type="button" class="badge-ticket ticket-view-btn" data-id="@id" title="View full details">@ticket</button></td><td><small>@(date!=null?Convert.ToDateTime(date).ToString("dd-MM-yy hh:mm tt"):"")</small></td><td><div class="fw-bold" style="font-size:12.5px;">@clientName</div><small class="text-muted">[ID:@clientId]</small></td><td class="fw-bold">@mobile</td><td><small>@channel / @callType</small></td><td><span class="badge-cat">@cat</span></td><td><span class="badge bg-light border text-dark" style="font-size:10px;">@pri</span></td><td><small>@assigned</small></td><td><span class="badge bg-warning text-dark" style="font-size:10px;">@status</span></td>@foreach(var ex in extraCols){var exVal=row.ContainsKey(ex)?row[ex]?.ToString():"-"; if(string.Equals(ex,"Issue",StringComparison.OrdinalIgnoreCase)){<td><span class="cell-clip" title="@exVal">@exVal</span></td>}else{<td>@exVal</td>}}<td><div class="row-actions"><button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 ticket-view-btn" data-id="@id" title="View details"><i class="bi bi-eye"></i></button><button type="button" class="btn btn-sm btn-outline-warning py-0 px-2 ticket-reassign-btn" data-id="@id" title="Re-Assign (kaam kisi aur ko do)"><i class="bi bi-arrow-left-right"></i></button><a href="/DailySupport/Edit/@id" class="btn btn-sm btn-outline-primary py-0 px-2" title="Edit" data-no-modal onclick="event.preventDefault(); window.loadPage('/DailySupport/Edit/@id', 'Edit Call');"><i class="bi bi-pencil"></i></a></div></td></tr>
}
@if(!Model.Rows.Any()){<tr><td colspan="20" class="text-center py-5 text-muted">No calls found</td></tr>}
</tbody></table></div><div class="p-2 bg-light d-flex flex-wrap justify-content-between align-items-center gap-2">
  <div class="d-flex align-items-center gap-2">
    <label class="text-muted" style="font-size:12px;margin-bottom:0;">Show per page</label>
    <select class="form-select form-select-sm dss-page-size" style="width:70px;border-radius:8px;height:30px;font-size:12px;">
      <option value="10" selected="@(Model.PageSize==10)">10</option>
      <option value="20" selected="@(Model.PageSize==20)">20</option>
      <option value="50" selected="@(Model.PageSize==50)">50</option>
      <option value="100" selected="@(Model.PageSize==100)">100</option>
    </select>
  </div>
  <div style="font-size:12px;color:#64748b;">Showing @((Model.TotalRecords==0)?0:((Model.CurrentPage-1)*Model.PageSize)+1) to @Math.Min(Model.CurrentPage*Model.PageSize,Model.TotalRecords) of @Model.TotalRecords entries</div>
  <div class="btn-group btn-group-sm">
    @if(Model.CurrentPage>1){<a href="#" class="btn btn-light border dss-page" data-page="@(Model.CurrentPage-1)">Previous</a>}else{<button class="btn btn-light border" disabled>Previous</button>}
    @for(int p=Math.Max(1,Model.CurrentPage-2); p<=Math.Min(Model.TotalPages,Model.CurrentPage+2); p++){<a href="#" class="btn @(p==Model.CurrentPage?"btn-dark":"btn-light border") dss-page" data-page="@p">@p</a>}
    @if(Model.CurrentPage<Model.TotalPages){<a href="#" class="btn btn-light border dss-page" data-page="@(Model.CurrentPage+1)">Next</a>}else{<button class="btn btn-light border" disabled>Next</button>}
  </div>
</div></div></div>
