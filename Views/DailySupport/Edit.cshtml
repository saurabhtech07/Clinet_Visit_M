@model List<DynamicField>
@{ Layout=Context.Request.Headers["X-Requested-With"]=="XMLHttpRequest"?null:"~/Views/Shared/_Layout.cshtml"; var row=(Dictionary<string,object?>)ViewBag.RowData; var customers=ViewBag.Customers as List<Dictionary<string,object?>>??new List<Dictionary<string,object?>>(); var engineers=ViewBag.Engineers as List<Dictionary<string,object?>>??new List<Dictionary<string,object?>>(); var known=new HashSet<string>(StringComparer.OrdinalIgnoreCase){"SupportId","TicketNo","ClientId","AssignedTo","Status","Channel","Category","Priority","Issue","Description","CallerName","CustomerID","UserId","VisitTypeId"}; var extra=Model.Where(f=>!known.Contains(f.Name)).ToList();
   // Role helpers - normal user reassign nahi kar sakta
   var canAssign=ViewBag.CanAssign as bool? ?? false;
   var myUserId=ViewBag.MyUserId as int?;
   var assignedId=row!=null&&row.ContainsKey("AssignedTo")?(row["AssignedTo"]?.ToString()??""):"";
   var assignedLabel="Unassigned";
   var assignedUser=engineers.FirstOrDefault(e=>e.ContainsKey("UserId")&&(e["UserId"]?.ToString()??"")==assignedId);
   if(assignedUser!=null&&assignedUser.ContainsKey("FullName")&&!string.IsNullOrWhiteSpace(assignedUser["FullName"]?.ToString())) assignedLabel=assignedUser["FullName"]!.ToString()!;
   if(!string.IsNullOrWhiteSpace(assignedId)&&assignedLabel=="Unassigned") assignedLabel="User #"+assignedId; }
<style>
    /* Client Master jaisa responsive form - chhoti screen par cards stack ho jate hain */
    #editCallForm h6{font-size:11px;font-weight:800;color:#0f172a;text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid #eef2f7;padding-bottom:5px;margin-bottom:8px}
    #editCallForm .form-label{font-size:11px;font-weight:700;color:#334155;margin-bottom:2px}
    #editCallForm .form-control,#editCallForm .form-select{height:30px;font-size:12.5px;border-radius:8px;background:#f8fafc;border:1px solid #e2e8f0}
    #editCallForm .form-control:focus,#editCallForm .form-select:focus{background:#fff;border-color:#94a3b8;box-shadow:0 0 0 3px rgba(37,99,235,.08)}
    #editCallForm .row{--bs-gutter-x:.6rem;--bs-gutter-y:.6rem}
    #editCallForm [class*="col-"]{min-width:0}
    #editCallForm .card-section{border:1px solid #eef2f7!important;background:#fff}
    #editCallForm textarea.form-control{height:auto}
</style>

<div class="d-flex align-items-center gap-2 mb-2">
    <a href="/DailySupport" class="btn btn-light border btn-sm px-3" onclick="event.preventDefault(); window.loadPage('/DailySupport' + window.location.search);">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
    <h4 class="fw-bold mb-0" style="font-size:16px;">Edit Call - @row["TicketNo"]</h4>
</div>

<form method="post" id="editCallForm">
    @Html.AntiForgeryToken()
    <div class="row g-2 align-items-stretch">
        <div class="col-12">
            <div class="card-section w-100 p-3 border rounded bg-white">
                <h6>Ticket / Client</h6>
                <div class="row g-2">
                    <div class="col-12 col-md-4"><label class="form-label">Ticket No</label><input class="form-control" value="@row["TicketNo"]" readonly style="background:#f1f5f9;" /></div>
                    <div class="col-12 col-md-4"><label class="form-label">Client</label><select name="ClientId" class="form-select">@foreach(var c in customers){var cId=c["ClientId"]?.ToString();var cName=c["ClientName"]?.ToString(); if(cId==row["ClientId"]?.ToString()){<option value="@cId" selected>@cName [ID:@cId]</option>}else{<option value="@cId">@cName [ID:@cId]</option>}}</select></div>
                    <div class="col-12 col-md-4">@if(canAssign){<label class="form-label">Assigned To</label><select name="AssignedTo" class="form-select"><option value="">Select User</option>@foreach(var e in engineers){var eId=e.ContainsKey("UserId")?e["UserId"]?.ToString():"";var eName=e.ContainsKey("FullName")?e["FullName"]?.ToString():""; if(eId==assignedId){<option value="@eId" selected>@eName</option>}else{<option value="@eId">@eName</option>}}</select>}else{<!-- Normal user - Assigned To badal nahi sakta, sirf dikhate hain -->
                        <label class="form-label">Assigned To</label>
                        <input type="hidden" name="AssignedTo" value="@assignedId" />
                        <div class="form-control" style="background:#f1f5f9;display:flex;align-items:center;"><i class="bi bi-person-badge me-1"></i>@assignedLabel</div>}</div>
                </div>
            </div>
        </div>

        <!-- LEFT - CALL DETAILS -->
        <div class="col-md-6 d-flex">
            <div class="card-section w-100 p-3 border rounded bg-white">
                <h6>Call Details</h6>
                <div class="mb-2"><label class="form-label">Status</label><select name="Status" class="form-select"><option selected="@(row["Status"]?.ToString()=="Open")">Open</option><option selected="@(row["Status"]?.ToString()=="In Progress")">In Progress</option><option selected="@(row["Status"]?.ToString()=="On Hold")">On Hold</option><option selected="@(row["Status"]?.ToString()=="Pending")">Pending</option><option selected="@(row["Status"]?.ToString()=="Closed")">Closed</option></select></div>
                <div class="mb-2"><label class="form-label">Priority</label><select name="Priority" class="form-select"><option selected="@(row["Priority"]?.ToString()=="Low")">Low</option><option selected="@(row["Priority"]?.ToString()=="Medium")">Medium</option><option selected="@(row["Priority"]?.ToString()=="High")">High</option><option selected="@(row["Priority"]?.ToString()=="Urgent")">Urgent</option></select></div>
                <div class="mb-2"><label class="form-label">Channel</label><input name="Channel" class="form-control" value="@row["Channel"]" /></div>
                <div class="mb-2"><label class="form-label">Category</label><input name="Category" class="form-control" value="@row["Category"]" /></div>
                @if(extra.Any()){
                    <hr />
                    <h6>Additional Information - Auto Added</h6>
                    @foreach(var f in extra){<div class="mb-2"><label class="form-label">@f.Name</label><input name="@f.Name" class="form-control" value="@(row.ContainsKey(f.Name)?row[f.Name]?.ToString():"")" /></div>}
                }
            </div>
        </div>

        <!-- RIGHT - ISSUE + BUTTONS -->
        <div class="col-md-6 d-flex flex-column gap-2">
            <div class="card-section w-100 p-3 border rounded bg-white d-flex flex-column">
                <h6>Issue</h6>
                <textarea name="Issue" id="issueBox" rows="6" class="form-control flex-grow-1">@row["Issue"]</textarea>
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="toggleDictation()" id="dictationBtn">🎤 Speak</button>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm px-4">Update Ticket</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
/* Back button ke href me filters daal do - new tab / middle click par bhi
   filter bache (warna sirf onclick wala path carry karta hai) */
document.querySelectorAll('a[href="/DailySupport"]').forEach(function(a){
  a.href='/DailySupport'+window.location.search;
});
(function(){
    var f=document.getElementById('editCallForm');
    if(!f) return;
    f.addEventListener('submit',function(e){
        e.preventDefault();
        Ajax.submit({url:'/DailySupport/Edit/@row["SupportId"]',form:f,onSuccess:function(){ window.loadPage('/DailySupport' + window.location.search); }});
    });

    // ---- Issue box me bolkar likhne ke liye (Create form jaisa) ----
    var rec=null, listening=false;
    window.toggleDictation=function(){
        var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
        if(!SR){ Ajax.toast("Is browser me voice input support nahi hai. Chrome/Edge use karein.","error"); return; }
        var btn=document.getElementById('dictationBtn');
        if(listening){ try{ rec.stop(); }catch(e){} return; }
        rec=new SR(); rec.continuous=true; rec.interimResults=true; rec.lang="en-IN";
        rec.onresult=function(e){ var tr=""; for(var i=e.resultIndex;i<e.results.length;i++) if(e.results[i].isFinal) tr+=e.results[i][0].transcript; if(tr){ var box=document.getElementById('issueBox'); box.value+=(box.value?" ":"")+tr.trim(); box.focus(); } };
        rec.onerror=function(e){ Ajax.toast("Voice error: "+e.error,"error"); };
        rec.onend=function(){ listening=false; if(btn) btn.innerText="🎤 Speak"; };
        rec.start(); listening=true; if(btn) btn.innerText="⏸ Pause";
    };

})();
</script>
