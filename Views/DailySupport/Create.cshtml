    var known=new HashSet<string>(StringComparer.OrdinalIgnoreCase){"SupportId","TicketNo","Status","Priority","SupportDate","ClientId","CustomerID","Mobile","Channel","CallType","Category","AssignedTo","Issue","Description","CreatedOn","UserId","VisitTypeId","Solution"};
