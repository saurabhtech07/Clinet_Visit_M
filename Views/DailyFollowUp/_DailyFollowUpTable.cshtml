@model ClientVisitManagement.Models.DailyFollowUpViewModel
@{
    var grid = Model.Grid;
    int start = grid.TotalRecords == 0 ? 0 : ((grid.CurrentPage - 1) * grid.PageSize) + 1;
    int end = Math.Min(grid.CurrentPage * grid.PageSize, grid.TotalRecords);

    string BuildUrl(int page, int pageSize, string? sort, string? dir)
    {
        var q = new List<string> { "page=" + page, "pageSize=" + pageSize };
        if (!string.IsNullOrWhiteSpace(grid.SearchTerm)) q.Add("search=" + Uri.EscapeDataString(grid.SearchTerm));
        if (!string.IsNullOrWhiteSpace(Model.FilterStatus)) q.Add("status=" + Uri.EscapeDataString(Model.FilterStatus));
        if (!string.IsNullOrWhiteSpace(Model.FilterPriority)) q.Add("priority=" + Uri.EscapeDataString(Model.FilterPriority));
        if (Model.FilterAssignedTo.HasValue) q.Add("assignedTo=" + Model.FilterAssignedTo.Value);
        if (Model.FilterFrom.HasValue) q.Add("fromDate=" + Model.FilterFrom.Value.ToString("yyyy-MM-dd"));
        if (Model.FilterTo.HasValue) q.Add("toDate=" + Model.FilterTo.Value.ToString("yyyy-MM-dd"));
        if (!string.IsNullOrWhiteSpace(sort)) q.Add("sort=" + Uri.EscapeDataString(sort));
        if (!string.IsNullOrWhiteSpace(dir)) q.Add("direction=" + dir);
        return "/DailyFollowUp?" + string.Join("&", q);
    }

    string DisplayName(string col) => col switch
    {
        "DailyFollowUpId" => "Id",
        "ContactPerson" => "Contact Person",
        "FollowUpDate" => "Follow Up Date",
        "NextFollowUpDate" => "Next Follow Up",
        "FollowUpType" => "Follow Up Type",
        "AssignedName" => "Assigned To",
        "CreatedOn" => "Created On",
        _ => System.Text.RegularExpressions.Regex.Replace(col, "([a-z])([A-Z])", "$1 $2")
    };

    string Fmt(object? val)
    {
        if (val == null) return "";
        if (val is DateTime dt) return dt.ToString("dd-MM-yyyy");
        if (val is decimal dc) return dc.ToString("N2");
        if (val is bool b) return b ? "Yes" : "No";
        return val.ToString() ?? "";
    }

    string StatusStyle(string s) => s switch
    {
        "Done" => "background:#dcfce7;color:#15803d;",
        "Pending" => "background:#fef3c7;color:#b45309;",
        _ => "background:#f1f5f9;color:#475569;"
    };

    string PriorityStyle(string p) => p switch
    {
        "High" => "background:#fee2e2;color:#b91c1c;",
        "Medium" => "background:#ffedd5;color:#c2410c;",
        "Low" => "background:#dcfce7;color:#15803d;",
        _ => "background:#f1f5f9;color:#475569;"
    };

    string TypeStyle(string t) => t switch
    {
        "Phone Call" => "background:#e0e7ff;color:#3730a3;",
        "Online" => "background:#cffafe;color:#0e7490;",
        "Office" => "background:#fef9c3;color:#a16207;",
        _ => "background:#f1f5f9;color:#475569;"
    };

    // Fixed column widths (table-layout: fixed) — horizontal scroll nahi aayega.
    string ColWidth(string col) => col switch
    {
        "DailyFollowUpId" => "36px",
        "ContactPerson" => "80px",
        "Company" => "80px",
        "Mobile" => "64px",
        "City" => "54px",
        "Discussion" => "78px",
        "FollowUpDate" => "70px",
        "NextFollowUpDate" => "70px",
        "FollowUpType" => "70px",
        "Priority" => "54px",
        "Status" => "66px",
        "CreatedOn" => "68px",
        "AssignedName" => "70px",
        _ => "72px"
    };
}

<style>
    /* Koi inner scroll nahi — poora table page par fit hota hai */
    .table-scroll-container { position: relative; }
    .dfu-table thead th {
        position: sticky; top: 0; z-index: 10;
        font-size: 10px; font-weight: 700; letter-spacing: 0.3px;
        color: #64748b; text-transform: uppercase;
        background: #f8fafc !important;
        border-bottom: 1px solid #e2e8f0;
        padding: 7px 8px; white-space: normal; line-height: 1.15;
        box-shadow: 0 1px 0 #e2e8f0;
    }
    .dfu-table tbody td { font-size: 12.5px; padding: 5px 8px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; background: #fff; overflow: hidden; }
    .dfu-id-pill { background: #1e293b; color: #fff; padding: 2px 7px; border-radius: 6px; font-size: 10px; font-weight: 600; }
    .table-sort-link { color: #475569 !important; text-decoration: none; }
    .table-sort-link:hover { color: #0f172a !important; }
    .dfu-grid-table { border-collapse: separate; border-spacing: 0; width: 100%; table-layout: fixed; }
    .cell-clip { display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }
    .act-btn { width: 24px; height: 24px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 7px; font-size: 12px; }
    .dfu-table tbody td.actions-cell { white-space: nowrap; }
</style>

<div class="table-scroll-container">
    <table class="table mb-0 dfu-table table-hover dfu-grid-table">
        <thead>
            <tr>
                <th style="width:36px;">Sr.No</th>
                @foreach (var col in grid.Columns)
                {
                    var nextDir = (grid.SortColumn == col && grid.SortDirection == "ASC") ? "DESC" : "ASC";
                    <th style="width:@ColWidth(col);">
                        <a class="table-sort-link ajax-dfu-link" href="@BuildUrl(1, grid.PageSize, col, nextDir)">
                            @DisplayName(col)
                            @if (grid.SortColumn == col)
                            {
                                <i class="bi @(grid.SortDirection == "ASC" ? "bi-arrow-up" : "bi-arrow-down") ms-1"></i>
                            }
                            else
                            {
                                <i class="bi bi-arrow-down-up ms-1" style="opacity:0.3; font-size:11px;"></i>
                            }
                        </a>
                    </th>
                }
                <th class="actions-col" style="width:104px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (grid.Rows.Any())
            {
                foreach (var row in grid.Rows)
                {
                    var id = row.ContainsKey("DailyFollowUpId") ? row["DailyFollowUpId"]?.ToString() : "";
                    var status = row.ContainsKey("Status") ? row["Status"]?.ToString() ?? "" : "";
                    bool isDone = status.Equals("Done", StringComparison.OrdinalIgnoreCase);

                    <tr>
                        <td style="color:#64748b;">@start</td>
                        @foreach (var col in grid.Columns)
                        {
                            object? val = row.ContainsKey(col) ? row[col] : null;
                            if (col == "DailyFollowUpId")
                            {
                                <td><span class="dfu-id-pill">@val</span></td>
                            }
                            else if (col == "Status")
                            {
                                var st = val?.ToString() ?? "";
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(st))
                                    {
                                        <span style="padding:2px 8px; border-radius:20px; font-size:10px; font-weight:600; @StatusStyle(st)">@st</span>
                                    }
                                </td>
                            }
                            else if (col == "Priority")
                            {
                                var pr = val?.ToString() ?? "";
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(pr))
                                    {
                                        <span style="padding:2px 8px; border-radius:20px; font-size:10px; font-weight:600; @PriorityStyle(pr)">@pr</span>
                                    }
                                </td>
                            }
                            else if (col == "FollowUpType")
                            {
                                var ft = val?.ToString() ?? "";
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(ft))
                                    {
                                        <span style="padding:2px 8px; border-radius:20px; font-size:10px; font-weight:600; @TypeStyle(ft)">@ft</span>
                                    }
                                </td>
                            }
                            else if (col == "ContactPerson" || col == "Company")
                            {
                                var t = Fmt(val);
                                <td class="fw-semibold" style="color:#0f172a;"><span class="cell-clip" title="@t">@t</span></td>
                            }
                            else
                            {
                                var t = Fmt(val);
                                <td><span class="cell-clip" title="@t">@t</span></td>
                            }
                        }
                        <td class="actions-cell">
                            @if (!isDone)
                            {
                                <button type="button" class="btn btn-success act-btn" onclick="dfuMarkDone(@id, this)" title="Mark as Done">
                                    <i class="bi bi-check2"></i>
                                </button>
                            }
                            else
                            {
                                <span style="padding:2px 7px; border-radius:6px; font-size:9.5px; font-weight:700; background:#dcfce7; color:#15803d;" title="Done">
                                    <i class="bi bi-check2-circle"></i> Done
                                </span>
                            }
                            <a href="/DailyFollowUp/Edit/@id" class="btn btn-light border act-btn ms-1" title="Edit"><i class="bi bi-pencil"></i></a>
                            <form method="post" action="/DailyFollowUp/Delete/@id" onsubmit="return confirm('Delete this follow-up?');" style="display:inline" class="ms-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-light border act-btn" style="color:#dc2626;" title="Delete"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    start++;
                }
            }
            else
            {
                <tr><td colspan="@(grid.Columns.Count + 2)" class="text-center text-muted py-5">No follow-ups found</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center p-2 border-top bg-white" style="border-radius:0 0 14px 14px;">
    <div class="d-flex align-items-center gap-2">
        <select id="dfuPageSize" class="form-select form-select-sm" style="width:70px; border-radius:8px;">
            <option value="10" selected="@(grid.PageSize == 10)">10</option>
            <option value="20" selected="@(grid.PageSize == 20)">20</option>
            <option value="50" selected="@(grid.PageSize == 50)">50</option>
            <option value="100" selected="@(grid.PageSize == 100)">100</option>
        </select>
        <span style="font-size:12px; color:#64748b;">records per page</span>
    </div>
    <div style="font-size:12px; color:#64748b;">Showing @start to @end of @grid.TotalRecords entries</div>
    <div class="d-flex gap-1">
        @if (grid.CurrentPage > 1)
        {
            <a class="btn btn-sm btn-light border ajax-dfu-link" href="@BuildUrl(grid.CurrentPage - 1, grid.PageSize, grid.SortColumn, grid.SortDirection)">Previous</a>
        }
        else
        {
            <button class="btn btn-sm btn-light border" disabled>Previous</button>
        }
        @for (int p = 1; p <= grid.TotalPages; p++)
        {
            if (p == grid.CurrentPage)
            {
                <span class="btn btn-sm" style="background:#0f172a; color:#fff;">@p</span>
            }
            else
            {
                <a class="btn btn-sm btn-light border ajax-dfu-link" href="@BuildUrl(p, grid.PageSize, grid.SortColumn, grid.SortDirection)">@p</a>
            }
        }
        @if (grid.CurrentPage < grid.TotalPages)
        {
            <a class="btn btn-sm btn-light border ajax-dfu-link" href="@BuildUrl(grid.CurrentPage + 1, grid.PageSize, grid.SortColumn, grid.SortDirection)">Next</a>
        }
        else
        {
            <button class="btn btn-sm btn-light border" disabled>Next</button>
        }
    </div>
</div>
