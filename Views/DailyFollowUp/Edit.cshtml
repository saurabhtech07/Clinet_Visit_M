@using Microsoft.AspNetCore.Html
@model List<DynamicField>
@{
    var row = (Dictionary<string, object?>)ViewBag.RowData;
    var followUpId = ViewBag.FollowUpId;
    var users = ViewBag.Users as List<User> ?? new List<User>();
    var leads = ViewBag.Leads as List<Dictionary<string, object?>> ?? new List<Dictionary<string, object?>>();
    var statusOptions = ViewBag.StatusOptions as string[] ?? new string[0];
    var priorityOptions = ViewBag.PriorityOptions as string[] ?? new string[0];
    var followUpTypeOptions = ViewBag.FollowUpTypeOptions as string[] ?? new string[0];

    var known = new[] { "LeadId", "ContactPerson", "Company", "Mobile", "City",
                        "FollowUpDate", "NextFollowUpDate", "Status", "Priority", "FollowUpType", "AssignedTo", "Discussion" };
    var otherFields = Model.Where(f => !known.Contains(f.Name, StringComparer.OrdinalIgnoreCase)).ToList();

    string Label(string name) => name switch
    {
        "LeadId" => "Lead",
        "FollowUpDate" => "Follow Up Date",
        "NextFollowUpDate" => "Next Follow Up Date",
        "ContactPerson" => "Contact Person",
        "AssignedTo" => "Assigned To",
        "FollowUpType" => "Follow Up Type",
        _ => System.Text.RegularExpressions.Regex.Replace(name, "([a-z])([A-Z])", "$1 $2")
    };

    string Options(IEnumerable<(string Value, string Text)> items, string? selected)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<option value=\"\">-- Select --</option>");
        foreach (var (value, text) in items)
        {
            var sel = string.Equals(value, selected, StringComparison.OrdinalIgnoreCase) ? " selected" : "";
            sb.Append($"<option value=\"{value}\"{sel}>{System.Net.WebUtility.HtmlEncode(text)}</option>");
        }
        return sb.ToString();
    }

    string BuildLeadText(Dictionary<string, object?> l)
    {
        var person = l.ContainsKey("LeadPerson") ? l["LeadPerson"]?.ToString() : null;
        var company = l.ContainsKey("Company") ? l["Company"]?.ToString() : null;
        if (string.IsNullOrWhiteSpace(person)) return company ?? "";
        return string.IsNullOrWhiteSpace(company) ? person! : person + " - " + company;
    }

    object? Row(string name) => row.ContainsKey(name) ? row[name] : null;

    IHtmlContent RenderField(DynamicField f, string colClass)
    {
        var raw = Row(f.Name);
        var v = raw switch
        {
            DateTime dt => dt.ToString("yyyy-MM-dd"),
            null => "",
            _ => raw.ToString() ?? ""
        };
        var star = f.IsNullable ? "" : " <span class=\"text-danger\">*</span>";
        var label = $"<label class=\"form-label mb-1\">{Label(f.Name)}{star}</label>";
        string input;

        if (f.Name == "LeadId")
        {
            var items = leads.Select(l => (
                Value: l.ContainsKey("LeadId") ? l["LeadId"]?.ToString() ?? "" : "",
                Text: BuildLeadText(l)));
            input = $"<select class=\"form-select\" name=\"LeadId\" id=\"dfuLead\" data-searchable=\"1\" data-placeholder=\"Search lead...\">{Options(items, v)}</select>";
        }
        else if (f.Name == "Status")
        {
            input = $"<select class=\"form-select\" name=\"Status\">{Options(statusOptions.Select(s => (s, s)), string.IsNullOrWhiteSpace(v) ? "Pending" : v)}</select>";
        }
        else if (f.Name == "Priority")
        {
            input = $"<select class=\"form-select\" name=\"Priority\">{Options(priorityOptions.Select(s => (s, s)), v)}</select>";
        }
        else if (f.Name == "FollowUpType")
        {
            input = $"<select class=\"form-select\" name=\"FollowUpType\">{Options(followUpTypeOptions.Select(s => (s, s)), v)}</select>";
        }
        else if (f.Name == "AssignedTo")
        {
            var items = users.Select(u => (
                Value: u.UserId.ToString(),
                Text: string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName));
            input = $"<select class=\"form-select\" name=\"AssignedTo\">{Options(items, v)}</select>";
        }
        else if (f.Name == "Discussion")
        {
            input = $"<textarea class=\"form-control\" name=\"Discussion\" rows=\"2\" placeholder=\"Discussion / notes...\">{System.Net.WebUtility.HtmlEncode(v)}</textarea>";
        }
        else
        {
            var isDate = f.DataType.Contains("date", StringComparison.OrdinalIgnoreCase);
            var type = isDate ? "date" : "text";
            input = $"<input class=\"form-control\" name=\"{f.Name}\" type=\"{type}\" value=\"{System.Net.WebUtility.HtmlEncode(v)}\" placeholder=\"Enter {Label(f.Name)}\" />";
        }
        return new HtmlString($"<div class=\"{colClass}\">{label}{input}</div>");
    }
}

<style>
    #dfuForm .dfu-title{font-size:11px;font-weight:800;color:#0f172a;text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid #eef2f7;padding-bottom:6px;display:flex;align-items:center;gap:7px}
    #dfuForm .dfu-title i{color:#2563eb}
    #dfuForm .form-label{font-size:11.5px;font-weight:700;color:#334155;margin-bottom:2px}
    #dfuForm .form-control,#dfuForm .form-select{height:34px;font-size:12.5px;border-radius:8px;background:#f8fafc;border:1px solid #e2e8f0;min-width:0}
    #dfuForm textarea.form-control{height:auto;min-height:56px}
    #dfuForm .form-control:focus,#dfuForm .form-select:focus{background:#fff;border-color:#94a3b8;box-shadow:0 0 0 3px rgba(37,99,235,.08)}
    #dfuForm .row{--bs-gutter-x:.6rem;--bs-gutter-y:.6rem}
    /* Flex columns ko shrink karne do — warna lamba label/option horizontal scroll bana deta hai */
    #dfuForm [class*="col-"]{min-width:0}
    #dfuForm .ss-wrap,#dfuForm .ss-input{max-width:100%}
</style>

<h4 class="fw-bold mb-2">Edit Daily Follow Up @(followUpId != null ? "#" + followUpId : "")</h4>

<form method="post" id="dfuForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="DailyFollowUpId" value="@followUpId" />
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-3">

            <div class="dfu-title"><i class="bi bi-person-lines-fill"></i> Lead</div>
            <div class="row g-2 mt-2">
                @foreach (var f in Model.Where(f => new[] { "LeadId" }.Contains(f.Name)))
                {
                    @RenderField(f, "col-md-6")
                }
            </div>

            <div class="dfu-title mt-3"><i class="bi bi-calendar2-check"></i> Schedule &amp; Assignment</div>
            <div class="row g-2 mt-2">
                @foreach (var f in Model.Where(f => new[] { "FollowUpDate", "NextFollowUpDate", "FollowUpType", "Status", "Priority", "AssignedTo" }.Contains(f.Name)))
                {
                    @RenderField(f, "col-md-4")
                }
            </div>

            <div class="dfu-title mt-3"><i class="bi bi-chat-left-text"></i> Discussion</div>
            <div class="row g-2 mt-2">
                @foreach (var f in Model.Where(f => f.Name == "Discussion"))
                {
                    @RenderField(f, "col-md-12")
                }
            </div>

            @if (otherFields.Any())
            {
                <div class="dfu-title mt-3"><i class="bi bi-plus-square"></i> Additional Information</div>
                <div class="row g-2 mt-2">
                    @foreach (var f in otherFields) { @RenderField(f, "col-md-6") }
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a href="/DailyFollowUp" class="btn btn-light border px-4">Cancel</a>
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2 me-1"></i> Update Follow Up</button>
    </div>
</form>

<script>
    if (window.SearchableSelect) { window.SearchableSelect.initAll(document); }

    (function () {
        var form = document.getElementById("dfuForm");
        if (!form) return;
        form.addEventListener("submit", function (e) {
            e.preventDefault();
            Ajax.submit({
                url: "/DailyFollowUp/Edit/@followUpId",
                form: form,
                successMessage: "Follow-up updated successfully.",
                onSuccess: function () { window.loadPage("/DailyFollowUp"); }
            });
        });
    })();
</script>
