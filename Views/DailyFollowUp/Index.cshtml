@model ClientVisitManagement.Models.DailyFollowUpViewModel
@{
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }

    var statusOptions = DailyFollowUpViewModel.StatusOptions;
    var priorityOptions = DailyFollowUpViewModel.PriorityOptions;

    var fStatus = Model.FilterStatus;
    var fPriority = Model.FilterPriority;
    var fAssignedTo = Model.FilterAssignedTo;
    var fFrom = Model.FilterFrom?.ToString("yyyy-MM-dd");
    var fTo = Model.FilterTo?.ToString("yyyy-MM-dd");
}

<style>
    .dfu-kpi-card{background:#fff;border-radius:10px;border:1px solid #eef2f7;padding:8px 12px;height:60px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 1px 2px rgba(0,0,0,0.04)}
    .dfu-kpi-label{font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;margin-bottom:1px;letter-spacing:0.4px}
    .dfu-kpi-value{font-size:18px;font-weight:800;color:#0f172a;line-height:1}
    .dfu-kpi-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;flex-shrink:0}
    .dfu-toolbar{background:#fff;border-radius:12px;border:1px solid #eef2f7;padding:10px 12px}
    .dfu-input{height:32px;font-size:12.5px;border-radius:9px;background:#f8fafc;border:1px solid #e2e8f0;padding-top:4px;padding-bottom:4px}
    .dfu-input:focus{background:#fff;border-color:#cbd5e1;box-shadow:none}
    .dfu-search{position:relative}
    .dfu-search i{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:13px}
    .dfu-search input{padding-left:30px}
    .dfu-date{display:flex;align-items:center;gap:5px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:9px;padding:0 8px;height:32px}
    .dfu-date span{font-size:9.5px;font-weight:700;color:#64748b;text-transform:uppercase}
    .dfu-date input{border:0;background:transparent;font-size:12px;color:#0f172a;outline:none;width:100px}
    .dfu-table-card{background:#fff;border-radius:12px;border:1px solid #eef2f7;overflow:hidden}
    .btn-dfu-dark{background:#0f172a;color:#fff;border-radius:10px;font-size:13px;padding:9px 16px}
    @@media print{
      .dfu-kpi-card,.dfu-toolbar,.dfu-date,.dfu-search{display:none!important}
      .dfu-table-card{border:none;overflow:visible!important}
      .table-scroll-container{max-height:none!important;overflow:visible!important;height:auto!important}
      .dfu-table thead th{position:static!important}
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="fw-bold mb-0">Daily Follow Up</h4>
    <a href="/DailyFollowUp/Create" data-no-modal class="btn btn-dfu-dark" onclick="event.preventDefault(); window.loadPage('/DailyFollowUp/Create', 'Add Follow Up');"><i class="bi bi-plus-circle me-1"></i> Add Follow Up</a>
</div>
@Html.AntiForgeryToken()

<!-- 4 CARDS -->
<div class="row g-2 mb-2">
    <div class="col-6 col-md-4">
        <div class="dfu-kpi-card">
            <div>
                <div class="dfu-kpi-label">Total Follow Ups</div>
                <div class="dfu-kpi-value">@Model.TotalFollowUps</div>
            </div>
            <div class="dfu-kpi-icon" style="background:#2563eb;"><i class="bi bi-list-check"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="dfu-kpi-card">
            <div>
                <div class="dfu-kpi-label">Pending</div>
                <div class="dfu-kpi-value" style="color:#b45309;">@Model.PendingCount</div>
            </div>
            <div class="dfu-kpi-icon" style="background:#f59e0b;"><i class="bi bi-hourglass-split"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="dfu-kpi-card">
            <div>
                <div class="dfu-kpi-label">Due Today</div>
                <div class="dfu-kpi-value" style="color:#1d4ed8;">@Model.DueTodayCount</div>
            </div>
            <div class="dfu-kpi-icon" style="background:#3b82f6;"><i class="bi bi-calendar2-check"></i></div>
        </div>
    </div>
</div>

<!-- FILTER TOOLBAR (compact single row) -->
<div class="dfu-toolbar mb-2">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="dfu-search" style="flex:1 1 200px; min-width:170px;">
            <i class="bi bi-search"></i>
            <input type="text" id="dfuSearch" value="@Model.Grid.SearchTerm" class="form-control dfu-input" placeholder="Search name / company / mobile / city..." autocomplete="off" />
        </div>

        <select id="dfuStatus" class="form-select dfu-input" style="width:135px;" title="Status">
            <option value="">All Status</option>
            @foreach (var s in statusOptions)
            {
                <option value="@s" selected="@(fStatus == s)">@s</option>
            }
        </select>

        <select id="dfuPriority" class="form-select dfu-input" style="width:130px;" title="Priority">
            <option value="">All Priority</option>
            @foreach (var p in priorityOptions)
            {
                <option value="@p" selected="@(fPriority == p)">@p</option>
            }
        </select>

        <select id="dfuAssigned" class="form-select dfu-input" style="width:150px;" title="Assigned To">
            <option value="">All Users</option>
            @foreach (var u in Model.Users)
            {
                var nm = string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName;
                <option value="@u.UserId" selected="@(fAssignedTo.HasValue && fAssignedTo.Value == u.UserId)">@nm</option>
            }
        </select>

        <div class="dfu-date" title="Follow Up Date — From">
            <span>From</span>
            <input type="date" id="dfuFrom" value="@fFrom" />
        </div>
        <div class="dfu-date" title="Follow Up Date — To">
            <span>To</span>
            <input type="date" id="dfuTo" value="@fTo" />
        </div>

        <button id="dfuClear" class="btn btn-light border" style="border-radius:9px; font-size:12.5px; height:32px;">
            <i class="bi bi-x-circle me-1"></i>Clear
        </button>

        <div class="dropdown ms-auto">
            <button class="btn btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                    style="border-radius:9px; font-size:12.5px; height:32px;">
                <i class="bi bi-download me-1"></i> Export
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a id="dfuExport" class="dropdown-item" href="/DailyFollowUp/ExportExcel"><i class="bi bi-file-earmark-excel me-2 text-success"></i>Excel</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="javascript:void(0);" onclick="window.printTable('dfuTable','Daily Follow Up');"><i class="bi bi-printer me-2"></i>Print</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- TABLE -->
<div class="dfu-table-card">
    <div id="dfuTable">
        @await Html.PartialAsync("_DailyFollowUpTable", Model)
    </div>
</div>

<script>
    (function () {
        function el(id) { return document.getElementById(id); }

        function buildUrl(page) {
            var p = new URLSearchParams();
            p.append("page", page);
            p.append("pageSize", (el("dfuPageSize") && el("dfuPageSize").value) || 10);
            var s = el("dfuSearch"); if (s && s.value.trim()) p.append("search", s.value.trim());
            var st = el("dfuStatus"); if (st && st.value) p.append("status", st.value);
            var pr = el("dfuPriority"); if (pr && pr.value) p.append("priority", pr.value);
            var as = el("dfuAssigned"); if (as && as.value) p.append("assignedTo", as.value);
            var fd = el("dfuFrom"); if (fd && fd.value) p.append("fromDate", fd.value);
            var td = el("dfuTo"); if (td && td.value) p.append("toDate", td.value);
            return "/DailyFollowUp?" + p.toString();
        }

        function updateExport() {
            var ex = el("dfuExport");
            if (ex) ex.href = "/DailyFollowUp/ExportExcel" + buildUrl(1).substring("/DailyFollowUp".length);
        }

        function loadTable(url) {
            fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                .then(function (r) { if (!r.ok) throw new Error("Failed to load follow-ups."); return r.text(); })
                .then(function (html) {
                    var t = el("dfuTable");
                    if (t) t.innerHTML = html;
                    updateExport();
                })
                .catch(function (e) { console.error("Daily follow-up table error:", e); });
        }

        window.refreshCurrentTable = function () { loadTable(buildUrl(1)); };

        window.dfuMarkDone = function (id, btn) {
            if (btn) btn.disabled = true;
            Ajax.post("/DailyFollowUp/MarkDone/" + id, new FormData())
                .then(function (d) {
                    Ajax.toast(d.message || "Follow-up done.", "success");
                    loadTable(buildUrl(1));
                })
                .catch(function (e) { if (btn) btn.disabled = false; Ajax.toast(e.message, "error"); });
        };

        // Delegated handlers only once (AJAX-nav safe)
        window.__dfuNav = window.__dfuNav || {};
        if (!window.__dfuNav.delegates) {
            window.__dfuNav.delegates = true;

            document.addEventListener("click", function (e) {
                var link = e.target.closest(".ajax-dfu-link");
                if (!link) return;
                e.preventDefault();
                loadTable(link.getAttribute("href"));
            });

            document.addEventListener("change", function (e) {
                if (e.target.id !== "dfuPageSize") return;
                loadTable(buildUrl(1));
            });
        }

        var timer = null;
        var search = el("dfuSearch");
        if (search) {
            search.addEventListener("input", function () {
                clearTimeout(timer);
                timer = setTimeout(function () { loadTable(buildUrl(1)); }, 300);
            });
        }

        ["dfuStatus", "dfuPriority", "dfuAssigned", "dfuFrom", "dfuTo"].forEach(function (id) {
            var node = el(id);
            if (node) node.addEventListener("change", function () { loadTable(buildUrl(1)); });
        });

        var clear = el("dfuClear");
        if (clear) {
            clear.addEventListener("click", function () {
                ["dfuSearch", "dfuStatus", "dfuPriority", "dfuAssigned", "dfuFrom", "dfuTo"].forEach(function (id) {
                    var node = el(id);
                    if (node) node.value = "";
                });
                loadTable(buildUrl(1));
            });
        }

        updateExport();
    })();
</script>
