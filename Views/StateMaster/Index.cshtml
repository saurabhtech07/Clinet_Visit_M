@model dynamic
@{
    ViewData["Title"] = "State Master";
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<style>
    .dss-kpi-card{background:#fff;border-radius:10px;border:1px solid #eef2f7;padding:8px 12px;height:60px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 1px 2px rgba(0,0,0,0.04)}
    .dss-kpi-label{font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;margin-bottom:1px;letter-spacing:0.4px}
    .dss-kpi-value{font-size:18px;font-weight:800;color:#0f172a;line-height:1}
    .dss-kpi-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;flex-shrink:0}
    .dss-toolbar{background:#fff;border-radius:12px;border:1px solid #eef2f7;padding:10px 12px}
    .dss-table-card{background:#fff;border-radius:14px;border:1px solid #eef2f7;overflow:hidden}
    .btn-dss-dark{background:#0f172a;color:#fff;border-radius:10px;font-size:13px;padding:9px 16px}
    .leads-search{position:relative}
    .leads-search i{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:13px}
    .leads-input{height:32px;font-size:12.5px;border-radius:9px;background:#f8fafc;border:1px solid #e2e8f0;padding-top:4px;padding-bottom:4px}
    .leads-input:focus{background:#fff;border-color:#cbd5e1;box-shadow:none}
    .leads-search input{padding-left:30px}
</style>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="fw-bold mb-0">State Master</h4>
    <a href="/StateMaster/Create" class="btn btn-dss-dark"><i class="bi bi-plus-circle me-1"></i> Add State</a>
</div>

<!-- KPI CARDS -->
<div class="row g-2 mb-2">
    <div class="col-6 col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Total States</div>
                <div class="dss-kpi-value">@ViewBag.TotalStates</div>
            </div>
            <div class="dss-kpi-icon" style="background:#2563eb;"><i class="bi bi-geo-alt-fill"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Active States</div>
                <div class="dss-kpi-value">@ViewBag.ActiveStates</div>
            </div>
            <div class="dss-kpi-icon" style="background:#10b981;"><i class="bi bi-check-circle-fill"></i></div>
        </div>
    </div>
</div>

<!-- FILTER TOOLBAR (compact single row) -->
<div class="dss-toolbar mb-2">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="leads-search" style="flex:1 1 220px; min-width:180px;">
            <i class="bi bi-search"></i>
            <input type="text" id="searchInput" class="form-control leads-input" placeholder="Search state / code / country..." autocomplete="off" />
        </div>

        <button type="button" id="btnClear" class="btn btn-light border" style="border-radius:9px; font-size:12.5px; height:32px;">
            <i class="bi bi-x-circle me-1"></i>Clear
        </button>

        <div class="dropdown ms-auto">
            <button class="btn btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                    style="border-radius:9px; font-size:12.5px; height:32px;">
                <i class="bi bi-download me-1"></i> Export
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a id="stateExportExcel" class="dropdown-item" href="/StateMaster/ExportExcel"><i class="bi bi-file-earmark-excel me-2 text-success"></i>Excel</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="javascript:void(0);" onclick="window.printTable('stateTableContainer','State Master');"><i class="bi bi-printer me-2"></i>Print</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- TABLE -->
<div class="dss-table-card">
    <div id="stateTableContainer">
        @await Html.PartialAsync("_StateTable", (object)Model)
    </div>
</div>

<script>
    window.__stateNav = window.__stateNav || {};
    var searchTimer;

    function updateStateExport() {
        const term = document.getElementById("searchInput")?.value.trim();
        const ex = document.getElementById("stateExportExcel");
        if (ex) ex.href = "/StateMaster/ExportExcel" + (term ? "?search=" + encodeURIComponent(term) : "");
    }

    function loadTable(page = 1) {
        const term = document.getElementById("searchInput").value.trim();
        const p = new URLSearchParams();
        if (term) p.append("search", term);
        p.append("page", page);
        p.append("pageSize", document.getElementById("statePageSize")?.value || 10);
        fetch("/StateMaster?" + p.toString(), { headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(r => { if (!r.ok) throw new Error(); return r.text(); })
        .then(html => {
            const container = document.getElementById("stateTableContainer");
            if (container) container.innerHTML = html;
            updateStateExport();
        })
        .catch(e => console.error(e));
    }

    function loadStateTable(url) {
        fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(r => { if (!r.ok) throw new Error(); return r.text(); })
        .then(html => {
            const container = document.getElementById("stateTableContainer");
            if (container) container.innerHTML = html;
        })
        .catch(e => console.error(e));
    }

    window.refreshCurrentTable = function () { loadTable(1); };

    // SORT + PAGINATION + PAGE SIZE - sirf ek baar register (AJAX nav safe)
    if (!window.__stateNav.delegates) {
        window.__stateNav.delegates = true;

        document.addEventListener("click", function (e) {
            if (e.__ajaxNavHandled) return;
            const link = e.target.closest(".ajax-table-link");
            if (!link) return;
            // Sirf tab handle karo jab is page ka table maujood ho (warna doosre page ka handler click kha jaata hai)
            if (!document.getElementById("stateTableContainer")) return;
            e.preventDefault();
            e.__ajaxNavHandled = true;
            loadStateTable(link.href);
        });

        document.addEventListener("change", function (e) {
            if (e.__ajaxNavHandled) return;
            if (e.target.id !== "statePageSize") return;
            e.__ajaxNavHandled = true;
            loadTable(1);
        });
    }

    var searchInput = document.getElementById("searchInput");
    if (searchInput) {
        searchInput.addEventListener("keyup", function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => loadTable(1), 300);
        });
    }

    var btnClear = document.getElementById("btnClear");
    if (btnClear) {
        btnClear.addEventListener("click", function () {
            document.getElementById("searchInput").value = "";
            loadTable(1);
        });
    }

    updateStateExport();
</script>