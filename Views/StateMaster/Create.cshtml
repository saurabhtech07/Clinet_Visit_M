@model List<ClientVisitManagement.Models.DynamicField>

<h4 class="mb-3">Add State</h4>

<div class="card-section" style="max-width:500px">

    <form method="post"
          action="/StateMaster/Create">

        @Html.AntiForgeryToken()

        @foreach (var f in Model)
        {
            <div class="mb-3">

                <label class="form-label">
                    @f.Name
                    @(f.IsNullable ? "" : "*")
                </label>

                <input class="form-control"
                       name="@f.Name"
                       @(f.IsNullable ? null : "required") />

            </div>
        }

        <div class="mt-3 text-end">

            <a href="/StateMaster"
               class="btn btn-light border">
                Back
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Save
            </button>

        </div>

    </form>

</div>