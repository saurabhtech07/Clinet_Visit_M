@model ClientVisitManagement.Models.DynamicTableViewModel
@{
    var displayCols = Model.Columns.Where(c => c!= "UserId" && c!= "Designation").ToList();
    int startSr = (Model.CurrentPage - 1) * Model.PageSize + 1;

    // Visit Type ka naam dikhane ke liye lookup (VisitTypeId -> Name)
    var visitTypes = ViewBag.VisitTypeMap as Dictionary<string, string> ?? new Dictionary<string, string>();
}
<style>
   .report-table-responsive{ max-height: 58vh; overflow:auto; }
   .report-table-responsive table{ width:100%; table-layout:fixed; }
   .report-table-responsive thead th{
        position: sticky;
        top: 0;
        z-index: 20;
        background: #f8fafc!important;
        color: #475569!important;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
        white-space: normal;
        line-height: 1.15;
        padding: 6px 6px!important;
        border-bottom: 1px solid #e2e8f0!important;
        box-shadow: 0 1px 0 #e2e8f0;
    }
   /* Wrap + compact: horizontal scroll ki jarurat nahi padti */
   .report-table-responsive tbody td{ padding: 4px 6px; font-size: 11.5px; border-color: #f1f5f9; white-space: normal; overflow-wrap: anywhere; word-break: break-word; }
   .report-table-responsive thead th:hover{ background: #f1f5f9!important; }
   /* DSS Report jaisa bottom pager */
   .cv-pager{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;padding:10px 14px;font-size:12px;background:#fff;border-top:1px solid #eef0f2;}
   .cv-pager .page-size-select{height:34px;border-radius:8px;font-size:13px;padding:5px 12px;border:1px solid #e5e7eb;background:#fff;min-width:75px;cursor:pointer;}
   .cv-pager .page-btn{width:34px;height:34px;border-radius:8px;border:1px solid #e5e7eb;background:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;cursor:pointer;color:#111827;padding:0;}
   .cv-pager .page-btn:disabled{opacity:.35;cursor:not-allowed;}
   .cv-pager .page-box{height:34px;min-width:120px;display:flex;align-items:center;justify-content:center;gap:5px;padding:0 14px;border:1px solid #e5e7eb;border-radius:8px;background:#f9fafb;font-size:13px;color:#374151;white-space:nowrap;}
</style>

<div class="table-responsive report-table-responsive">
<table class="table table-hover align-middle mb-0" style="font-size:11.5px;">
<thead style="font-size:10px; font-weight:700; color:#6c757d; letter-spacing:.5px; text-transform:uppercase;">
<tr>
    <th style="width:50px;">Sr.No</th>
    @foreach(var col in displayCols)
    {
        var isSorted = Model.SortColumn == col;
        var arrow = isSorted? (Model.SortDirection=="ASC"?"▲":"▼") : "↕";
        <th style="white-space:nowrap;">
            <a href="javascript:void(0)" class="sort-link text-decoration-none d-flex align-items-center gap-1" style="color:#6c757d;" data-sort="@col">
                @(col == "VisitTypeId" ? "Visit Type" : col) <span class="no-print" style="@(isSorted?"color:#111;font-weight:900;":"color:#bbb;")">@arrow</span>
            </a>
        </th>
    }
    <th class="actions-col no-print" style="width:70px; text-align:center;">ACTION</th>
</tr>
</thead>
<tbody>
@if(!Model.Rows.Any())
{
    <tr><td colspan="@(displayCols.Count+2)" class="text-center text-muted py-5">No records found</td></tr>
}
else
{
    int sr = startSr;
    foreach(var row in Model.Rows)
    {
        var visitId = row.ContainsKey("VisitId")? row["VisitId"]?.ToString() : "0";
    <tr>
        <td><span class="badge bg-dark" style="border-radius:6px;">@sr</span></td>
        @foreach(var col in displayCols)
        {
            var val = row.ContainsKey(col)? row[col] : null;
            string str = val==null? "-" : val.ToString()!;

            if (col == "VisitTypeId")
            {
                // 1 -> Onsite Visit, 2 -> Online (VisitTypeMaster se)
                if (val != null && visitTypes.TryGetValue(str, out var vtName) && !string.IsNullOrEmpty(vtName)) str = vtName;
            }
            else if (DateTime.TryParse(str, out var d))
            {
                str = d.ToString("dd-MM-yyyy hh:mm");
            }
            <td title="@str">@str</td>
        }
        <td class="actions-cell no-print" style="text-align:center;">
            <button type="button" class="btn btn-sm btn-outline-primary" style="width:28px; height:28px; padding:0; border-radius:6px;" onclick="viewReportDetails('@visitId')" title="View">
                <i class="bi bi-eye"></i>
            </button>
        </td>
    </tr>
    sr++;
    }
}
</tbody>
</table>
</div>

@{
    // DSS Report jaisa pager: Prev [Page X of Y] Next
    int totalPages = Model.TotalPages < 1 ? 1 : Model.TotalPages;
    int curPage = Model.CurrentPage < 1 ? 1 : (Model.CurrentPage > totalPages ? totalPages : Model.CurrentPage);
    int showingFrom = Model.TotalRecords == 0 ? 0 : ((curPage - 1) * Model.PageSize) + 1;
    int showingTo = Math.Min(curPage * Model.PageSize, Model.TotalRecords);
}
<div class="cv-pager">
    <div class="d-flex align-items-center gap-2">
        <span>Show</span>
        <select id="reportPageSize" class="page-size-select">
            <option value="10" selected="@(Model.PageSize==10)">10</option>
            <option value="20" selected="@(Model.PageSize==20)">20</option>
            <option value="50" selected="@(Model.PageSize==50)">50</option>
            <option value="100" selected="@(Model.PageSize==100)">100</option>
        </select>
        <span>entries</span>
    </div>
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <div class="text-muted">Total: <b class="text-dark">@Model.TotalRecords</b></div>
        <div style="font-size:12px;color:#6b7280;">Showing @showingFrom to @showingTo of @Model.TotalRecords</div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        @if (curPage > 1)
        {
            <button type="button" class="page-btn report-page-btn" data-page="@(curPage - 1)" title="Previous page"><i class="bi bi-chevron-left"></i></button>
        }
        else
        {
            <button type="button" class="page-btn" disabled title="Previous page"><i class="bi bi-chevron-left"></i></button>
        }
        <div class="page-box">Page <b>@curPage</b> of <b>@totalPages</b></div>
        @if (curPage < totalPages)
        {
            <button type="button" class="page-btn report-page-btn" data-page="@(curPage + 1)" title="Next page"><i class="bi bi-chevron-right"></i></button>
        }
        else
        {
            <button type="button" class="page-btn" disabled title="Next page"><i class="bi bi-chevron-right"></i></button>
        }
    </div>
</div>