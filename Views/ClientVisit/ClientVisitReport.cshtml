@model ClientVisitManagement.Models.DynamicTableViewModel
@{
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
    ViewData["Title"] = "Client Visit Report";
    var fromDate = ViewBag.FromDate as string?? Context.Request.Query["fromDate"].ToString();
    var toDate = ViewBag.ToDate as string?? Context.Request.Query["toDate"].ToString();
}
<style>
   .visit-page-header{display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px;}
   .visit-page-header h4{font-weight:800; font-size:22px; margin:0;}
   .visit-subtitle{font-size:13px; color:#6c757d; margin-top:2px;}
   .visit-filter-card-daily{background:#fff; border:1px solid #eef0f2; border-radius:12px; padding:14px 16px;}
   .visit-filter-card-daily label{font-size:10px; font-weight:700; color:#6c757d; letter-spacing:.5px; text-transform:uppercase; margin-bottom:6px; display:block;}
   .visit-search-box{position:relative;}.visit-search-box i{position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#888;}
   .visit-search-box input{padding-left:38px; height:38px; border-radius:8px; background:#f8f9fa; border:1px solid #e9ecef;}
   .date-filter{height:38px; border-radius:8px; background:#f8f9fa; border:1px solid #e9ecef;}
   .visit-clear-btn{height:38px; border-radius:8px; border:1px solid #e9ecef; background:#fff; font-size:13px; font-weight:600; padding:0 16px;}
   .export-main-btn{height:38px; border-radius:8px; background:#111; color:#fff; font-size:13px; font-weight:600; border:none;}
   .visit-table-card{background:#fff; border:1px solid #eef0f2; border-radius:12px; overflow:hidden;}
</style>

<div class="visit-page-header">
    <div>
        <h4>Client Visit Report</h4>
        <div class="visit-subtitle">Full detailed report - All fields from database will be displayed</div>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-dark" style="height:38px; display:flex; align-items:center; border-radius:8px; padding:0 14px;">Total: @Model.TotalRecords</span>
        <a href="/ClientVisit" class="btn btn-light border btn-sm" style="height:38px; border-radius:8px; display:flex; align-items:center;">Back to List</a>
    </div>
</div>

<div class="visit-filter-card-daily mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label>SEARCH - AUTO SEARCH</label>
            <div class="visit-search-box"><i class="bi bi-search"></i><input id="reportSearch" type="text" value="@Model.SearchTerm" placeholder="Type to auto search..." autocomplete="off" /></div>
        </div>
        <div class="col-md-2"><label>FROM DATE</label><input id="reportFromDate" class="form-control date-filter" type="date" value="@fromDate" /></div>
        <div class="col-md-2"><label>TO DATE</label><input id="reportToDate" class="form-control date-filter" type="date" value="@toDate" /></div>
        <div class="col-md-3 d-flex gap-2 justify-content-end">
            <button type="button" id="clearReportFilter" class="visit-clear-btn"><i class="bi bi-x"></i> Clear</button>
            <div class="dropdown">
                <button class="btn export-main-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"><i class="bi bi-download me-1"></i> Export</button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="/ClientVisit/ExportExcel?search=@Model.SearchTerm"><i class="bi bi-file-earmark-excel text-success"></i> Excel</a></li>
                    <li><a class="dropdown-item" href="/ClientVisit/ExportCsv?search=@Model.SearchTerm"><i class="bi bi-filetype-csv text-info"></i> CSV</a></li>
                    <li><a class="dropdown-item" href="javascript:window.print()"><i class="bi bi-printer text-primary"></i> Print</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="visit-table-card">
    <div id="reportTable">
        @await Html.PartialAsync("_VisitReportTable", Model)
    </div>
</div>

<div class="modal fade" id="reportDetailsModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content" id="reportDetailsModalContent">
      <div class="modal-body text-center py-5">Loading...</div>
    </div>
  </div>
</div>

<script>
    var reportSearchTimer;
    var currentSort = "@Model.SortColumn";
    var currentDir = "@Model.SortDirection";
    var reportSearch = document.getElementById("reportSearch");
    var reportFrom = document.getElementById("reportFromDate");
    var reportTo = document.getElementById("reportToDate");
    var reportTable = document.getElementById("reportTable");

    function buildReportUrl(page=1){
        const p = new URLSearchParams();
        if(reportSearch.value.trim()) p.append("term", reportSearch.value.trim());
        if(reportFrom.value) p.append("fromDate", reportFrom.value);
        if(reportTo.value) p.append("toDate", reportTo.value);
        if(currentSort) p.append("sort", currentSort);
        if(currentDir) p.append("direction", currentDir);
        p.append("page", page);
        p.append("pageSize", document.getElementById("reportPageSize")?.value || 10);
        return "/ClientVisit/ClientVisitReport?" + p.toString();
    }
    function loadReport(url){
        fetch(url, { headers: {"X-Requested-With":"XMLHttpRequest"} })
      .then(r=>r.text()).then(html=>{ reportTable.innerHTML = html; });
    }
    reportSearch.addEventListener("input", function(){ clearTimeout(reportSearchTimer); reportSearchTimer = setTimeout(()=> loadReport(buildReportUrl(1)), 300); });
    reportFrom.addEventListener("change", ()=> loadReport(buildReportUrl(1)));
    reportTo.addEventListener("change", ()=> loadReport(buildReportUrl(1)));
    document.addEventListener("change", function(e){ if(e.target.id==="reportPageSize") loadReport(buildReportUrl(1)); });
    document.getElementById("clearReportFilter").addEventListener("click", ()=>{ reportSearch.value=""; reportFrom.value=""; reportTo.value=""; currentSort=""; currentDir="DESC"; loadReport(buildReportUrl(1)); });
    document.addEventListener("click", function(e){
        const sortLink = e.target.closest(".sort-link");
        if(sortLink){ e.preventDefault(); const col=sortLink.dataset.sort; if(currentSort===col) currentDir=currentDir==="ASC"?"DESC":"ASC"; else {currentSort=col; currentDir="ASC";} loadReport(buildReportUrl(1)); return; }
        const pageLink = e.target.closest(".ajax-report-link");
        if(pageLink){ e.preventDefault(); loadReport(pageLink.href); }
    });
    function viewReportDetails(id){
        $("#reportDetailsModalContent").html('<div class="modal-body text-center py-5">Loading...</div>');
        var modal = new bootstrap.Modal(document.getElementById('reportDetailsModal'));
        modal.show();
        $.get("/ClientVisit/Details/" + id).done(function(html){ $("#reportDetailsModalContent").html(html); });
    }
</script>