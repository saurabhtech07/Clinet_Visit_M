@model ClientVisitManagement.Models.DynamicTableViewModel
@{
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
    ViewData["Title"] = "Client Visit Report";
    var fromDate = ViewBag.FromDate as string?? Context.Request.Query["fromDate"].ToString();
    var toDate = ViewBag.ToDate as string?? Context.Request.Query["toDate"].ToString();
}
<style>
   .visit-page-header{display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;}
   .visit-page-header h4{font-weight:800; font-size:18px; margin:0;}
   .visit-subtitle{font-size:11px; color:#6c757d; margin-top:2px;}
   .visit-filter-card-daily{background:#fff; border:1px solid #eef0f2; border-radius:12px; padding:10px 12px;}
   .visit-filter-card-daily label{font-size:10px; font-weight:700; color:#64748b; letter-spacing:.4px; text-transform:uppercase; margin-bottom:5px; display:block;}
   .visit-search-box{position:relative;}.visit-search-box i{position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#888; font-size:13px;}
   .visit-search-box input{padding-left:32px; height:32px; border-radius:9px; background:#f8f9fa; border:1px solid #e9ecef; font-size:12.5px;}
   .date-filter{height:32px; border-radius:9px; background:#f8f9fa; border:1px solid #e9ecef; font-size:12.5px;}
   .visit-clear-btn{height:32px; border-radius:9px; border:1px solid #e9ecef; background:#fff; font-size:12.5px; font-weight:600; padding:0 12px;}
   .export-main-btn{height:32px; border-radius:9px; background:#111; color:#fff; font-size:12.5px; font-weight:600; border:none;}
   .visit-table-card{background:#fff; border:1px solid #eef0f2; border-radius:12px; overflow:hidden;}
</style>

<div class="visit-page-header">
    <div>
        <h4>Client Visit Report</h4>
        <div class="visit-subtitle">Full detailed report - All fields from database will be displayed</div>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-dark" style="height:38px; display:flex; align-items:center; border-radius:8px; padding:0 14px;">Total: @Model.TotalRecords</span>
        <a href="/ClientVisit" class="btn btn-light border btn-sm" style="height:38px; border-radius:8px; display:flex; align-items:center;">Back to List</a>
    </div>
</div>

<div class="visit-filter-card-daily mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label>SEARCH - AUTO SEARCH</label>
            <div class="visit-search-box"><i class="bi bi-search"></i><input id="reportSearch" type="text" value="@Model.SearchTerm" placeholder="Type to auto search..." autocomplete="off" /></div>
        </div>
        <div class="col-md-2"><label>FROM DATE</label><input id="reportFromDate" class="form-control date-filter" type="date" value="@fromDate" /></div>
        <div class="col-md-2"><label>TO DATE</label><input id="reportToDate" class="form-control date-filter" type="date" value="@toDate" /></div>
        <div class="col-md-3 d-flex gap-2 justify-content-end">
            <button type="button" id="clearReportFilter" class="visit-clear-btn"><i class="bi bi-x"></i> Clear</button>
            <div class="dropdown">
                <button class="btn export-main-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"><i class="bi bi-download me-1"></i> Export</button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="/ClientVisit/ExportExcel?search=@Model.SearchTerm"><i class="bi bi-file-earmark-excel text-success"></i> Excel</a></li>
                    <li><a class="dropdown-item" href="/ClientVisit/ExportCsv?search=@Model.SearchTerm"><i class="bi bi-filetype-csv text-info"></i> CSV</a></li>
                    <li><a class="dropdown-item" href="javascript:window.printTable('reportTable','Client Visit Report')"><i class="bi bi-printer text-primary"></i> Print</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="visit-table-card">
    <div id="reportTable">
        @await Html.PartialAsync("_VisitReportTable", Model)
    </div>
</div>

<div class="modal fade" id="cvViewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable" style="max-width:980px;">
    <div class="modal-content" style="border-radius:14px;overflow:hidden;">
      <div class="modal-header" style="background:#0f172a;color:#fff;padding:10px 16px;">
        <h6 class="modal-title mb-0" id="cvViewModalTitle" style="font-weight:700;font-size:13px;">Visit Details</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0" id="cvViewModalBody">
        <div class="text-center p-5"><div class="spinner-border text-dark"></div></div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Close</button>
        <a href="#" id="cvViewModalEdit" data-no-modal class="btn btn-sm" style="background:#0f172a;color:#fff;" onclick="event.preventDefault(); var h=this.getAttribute('href'); if(h && h!=='#') window.loadPage(h, 'Edit Visit');">Open Edit Form</a>
      </div>
    </div>
  </div>
</div>
<style>
 #cvViewModal .modal-body{background:#f8fafc;max-height:72vh;overflow-y:auto;}
 #cvViewModal .modal-info{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 12px;}
 #cvViewModal .dss-modal-sec{font-size:10px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px;}
 #cvViewModal .dss-row{display:flex;justify-content:space-between;gap:10px;margin-bottom:6px;font-size:12px;}
 #cvViewModal .dss-row span:first-child{color:#6b7280;}
 #cvViewModal .dss-row span:last-child{font-weight:500;text-align:right;}
</style>

<script>
    var reportSearchTimer;
    var currentSort = "@Model.SortColumn";
    var currentDir = "@Model.SortDirection";
    var reportSearch = document.getElementById("reportSearch");
    var reportFrom = document.getElementById("reportFromDate");
    var reportTo = document.getElementById("reportToDate");
    var reportTable = document.getElementById("reportTable");

    function buildReportUrl(page=1){
        const p = new URLSearchParams();
        if(reportSearch.value.trim()) p.append("term", reportSearch.value.trim());
        if(reportFrom.value) p.append("fromDate", reportFrom.value);
        if(reportTo.value) p.append("toDate", reportTo.value);
        if(currentSort) p.append("sort", currentSort);
        if(currentDir) p.append("direction", currentDir);
        p.append("page", page);
        p.append("pageSize", document.getElementById("reportPageSize")?.value || 10);
        return "/ClientVisit/ClientVisitReport?" + p.toString();
    }
    function loadReport(url){
        fetch(url, { headers: {"X-Requested-With":"XMLHttpRequest"} })
      .then(r=>r.text()).then(html=>{ reportTable.innerHTML = html; });
    }
    reportSearch.addEventListener("input", function(){ clearTimeout(reportSearchTimer); reportSearchTimer = setTimeout(()=> loadReport(buildReportUrl(1)), 300); });
    reportFrom.addEventListener("change", ()=> loadReport(buildReportUrl(1)));
    reportTo.addEventListener("change", ()=> loadReport(buildReportUrl(1)));
    if (!window.__reportNav) window.__reportNav = {};
    if (!window.__reportNav.delegates) {
    window.__reportNav.delegates = true;
    document.addEventListener("change", function(e){ if(e.target.id==="reportPageSize" && !e.__reportNavHandled){ e.__reportNavHandled = true; loadReport(buildReportUrl(1)); } });
    document.getElementById("clearReportFilter").addEventListener("click", ()=>{ reportSearch.value=""; reportFrom.value=""; reportTo.value=""; currentSort=""; currentDir="DESC"; loadReport(buildReportUrl(1)); });
    document.addEventListener("click", function(e){
        if (e.__reportNavHandled) return;
        const sortLink = e.target.closest(".sort-link");
        if(sortLink){ e.preventDefault(); e.__reportNavHandled = true; const col=sortLink.dataset.sort; if(currentSort===col) currentDir=currentDir==="ASC"?"DESC":"ASC"; else {currentSort=col; currentDir="ASC";} loadReport(buildReportUrl(1)); return; }
        const pageLink = e.target.closest(".ajax-report-link");
        if(pageLink){ e.preventDefault(); e.__reportNavHandled = true; loadReport(pageLink.href); }
    });
    }
    function viewReportDetails(id){ openVisitDetails(id); }
    function cvFmtLabel(k) { if (k === "VisitTypeId") return "Visit Type"; return String(k).replace(/([a-z])([A-Z])/g, "$1 $2"); }
    function cvBuildRows(obj, skip) {
        if (!obj) return '<div class="text-muted" style="font-size:12px;">No data</div>';
        var html = "";
        for (var k in obj) {
            if (skip.indexOf(k) > -1) continue;
            var v = obj[k]; if (v === null || v === undefined || v === "") v = "-";
            if (String(k).toLowerCase().indexOf("date") > -1 && v !== "-") { try { v = new Date(v).toLocaleString(); } catch (err) { } }
            html += '<div class="dss-row"><span>' + cvFmtLabel(k) + '</span><span>' + v + '</span></div>';
        }
        return html || '<div class="text-muted" style="font-size:12px;">No data</div>';
    }
    // Client Visit List wala hi View - Visit Info + Client Info + Visit History
    function openVisitDetails(id) {
        var modalEl = document.getElementById("cvViewModal");
        if (!modalEl || !id) return;
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        var titleEl = document.getElementById("cvViewModalTitle");
        var bodyEl = document.getElementById("cvViewModalBody");
        var editEl = document.getElementById("cvViewModalEdit");

        titleEl.textContent = "Loading…";
        bodyEl.innerHTML = '<div class="text-center p-5"><div class="spinner-border text-dark"></div></div>';
        if (editEl) editEl.href = "/ClientVisit/Edit/" + id;
        modal.show();

        fetch("/ClientVisit/GetVisitDetails?id=" + encodeURIComponent(id), { headers: { "X-Requested-With": "XMLHttpRequest" } })
            .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
            .then(function (data) {
                var v = data.visit || {}, c = data.client || {}, h = data.history || [];
                titleEl.textContent = (c.ClientName ? c.ClientName : "Visit") + (v.VisitDate ? " - " + new Date(v.VisitDate).toLocaleDateString() : "");
                var skipV = ["UserId", "ClientId", "Designation"];
                var hist = h.length
                    ? h.map(function (row) {
                        return "<tr><td><span style='background:#0f172a;color:#fff;padding:2px 6px;border-radius:4px;font-size:10px;'>#" + (row.VisitId || "") + "</span></td>" +
                            "<td style='font-size:11px;'>" + (row.VisitDate ? new Date(row.VisitDate).toLocaleDateString() : "-") + "</td>" +
                            "<td style='font-size:11px;'>" + (row.PersonMet || row.PersonName || "-") + "</td>" +
                            "<td>" + (row.VisitType || row.PurposeOfVisit || "-") + "</td>" +
                            "<td>" + (row.FollowUpStatus || "-") + "</td>" +
                            "<td style='font-size:11px;'>" + (row.NextFollowUpDate ? new Date(row.NextFollowUpDate).toLocaleDateString() : "-") + "</td></tr>";
                    }).join("")
                    : "<tr><td colspan='6' class='text-center text-muted'>No visit history</td></tr>";

                bodyEl.innerHTML =
                    "<div class='p-3'>" +
                        "<div class='row g-2 mb-2'>" +
                            "<div class='col-md-6'><div class='modal-info h-100'><div class='dss-modal-sec'>Visit Info</div>" + cvBuildRows(v, skipV) + "</div></div>" +
                            "<div class='col-md-6'><div class='modal-info h-100'><div class='dss-modal-sec'>Client Info</div>" + cvBuildRows(c, ["ClientId", "UserId", "StateId"]) + "</div></div>" +
                        "</div>" +
                        "<div class='modal-info'><div class='dss-modal-sec'>Visit History (Last 10 Visits)</div>" +
                            "<table class='table table-sm mb-0' style='font-size:12px;'><thead><tr><th>Visit</th><th>Date</th><th>Person Met</th><th>Purpose</th><th>Status</th><th>Next Follow-up</th></tr></thead><tbody>" + hist + "</tbody></table>" +
                        "</div>" +
                    "</div>";
            })
            .catch(function (err) {
                bodyEl.innerHTML = "<div class='p-4 text-danger text-center'>Failed to load: " + err.message + "</div>";
            });
    }
</script>