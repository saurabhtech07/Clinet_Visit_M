@* @model List<ClientVisitManagement.Models.DynamicField>
@{
    var client = ViewBag.Client as ClientVisitManagement.Models.Client;
    var clients = ViewBag.Clients as List<ClientVisitManagement.Models.Client>?? new List<ClientVisitManagement.Models.Client>();
    int selectedClientId = ViewBag.SelectedClientId?? 0;
}

<h5 class="mb-3 fw-bold">CLIENT VISIT TRANSACTION</h5>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="form-label fw-bold mb-0">SELECT CLIENT *</label>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearAll()">Clear</button>
        </div>
        <div class="row g-2">
            <div class="col-md-4">
                <input type="text" list="clientList" id="clientSearchBox" class="form-control" placeholder="Type 134 or Name..." autocomplete="off" />
                <datalist id="clientList">
                    @foreach (var c in clients)
                    {
                        <option value="@c.ClientId - @c.ClientName"></option>
                    }
                </datalist>
            </div>
            <div class="col-md-8">
                <select class="form-select" id="clientDropdown" onchange="onClientChange(this.value)">
                    <option value="">-- Select Client --</option>
                    @foreach (var c in clients)
                    {
                        <option value="@c.ClientId" selected="@(c.ClientId == selectedClientId? "selected" : null)" data-search="@c.ClientId - @c.ClientName (@c.City)">
                            @c.ClientName - @c.City (@c.CompanyTypeName)
                        </option>
                    }
                </select>
            </div>
        </div>

        @if (client!= null)
        {
            <div class="mt-3 p-3 rounded" style="background:#e8f4ff; border:1px solid #b6d7ff;">
                <div class="row small g-2">
                    <div class="col-md-3"><strong>Company:</strong> @client.ClientName</div>
                    <div class="col-md-2"><strong>City:</strong> @client.City</div>
                    <div class="col-md-2"><strong>State:</strong> @client.StateName</div>
                    <div class="col-md-2"><strong>Pincode:</strong> @client.Pincode</div>
                    <div class="col-md-3"><strong>Mobile:</strong> @client.MobileNo</div>
                </div>
            </div>
        }
    </div>
</div>

<form method="post" id="visitForm">
    @Html.AntiForgeryToken()
    @if (client!= null) { <input type="hidden" name="ClientId" value="@client.ClientId" /> }
    else { <input type="hidden" name="ClientId" value="0" id="hiddenClientId" /> }

    <div class="row g-3 align-items-stretch">
        <!-- LEFT -->
        <div class="col-lg-6 d-flex">
            <div class="card border-0 shadow-sm w-100">
                <div class="card-body p-3">
                    <h6 class="fw-bold mb-3" style="color:#0d3b66;">VISIT DETAILS</h6>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label">VisitDate *</label>
                            <input class="form-control form-control-sm" name="VisitDate" type="date" value="@ViewBag.CurrentDate" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">VisitTime</label>
                            <input class="form-control form-control-sm" name="VisitTime" type="time" value="@ViewBag.CurrentTime" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">PersonMet</label>
                            <select class="form-select form-select-sm" name="PersonMet"><option value="">Select</option><option>Owner</option><option>Manager</option><option>CEO</option><option>Purchase Manager</option></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">PersonName</label><input class="form-control form-control-sm" name="PersonName" type="text" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Designation</label><input class="form-control form-control-sm" name="Designation" type="text" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ContactNo</label><input class="form-control form-control-sm" name="ContactNo" type="text" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Email</label><input class="form-control form-control-sm" name="Email" type="text" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">NextFollowUpDate *</label><input class="form-control form-control-sm" name="NextFollowUpDate" type="date" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">FollowUpStatus</label>
                            <select class="form-select form-select-sm" name="FollowUpStatus"><option value="Pending" selected>Pending</option><option value="Done">Done</option><option value="Overdue">Overdue</option></select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT -->
        <div class="col-lg-6 d-flex">
            <div class="card border-0 shadow-sm w-100">
                <div class="card-body p-3 d-flex flex-column">
                    <h6 class="fw-bold mb-3" style="color:#0d3b66;">DISCUSSION</h6>
                    <label class="form-label">Discussion / Requirement *</label>
                    <textarea class="form-control flex-grow-1" rows="7" name="DiscussionRequirement" id="discussionBox" required></textarea>
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="toggleDictation()" id="dictationBtn">🎤 Speak</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="document.getElementById('discussionBox').value=''">Clear</button>
                    </div>
                    <label class="form-label mt-3">Remarks</label>
                    <textarea class="form-control" rows="4" name="Remarks"></textarea>
                    <div class="mt-auto pt-3 text-end border-top">
                        <a href="/ClientVisit" class="btn btn-light border btn-sm">Back</a>
                        <button type="submit" class="btn btn-success btn-sm px-4">Save Visit</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    function onClientChange(id){ if(id && id!=="0") window.location.href='/ClientVisit/Create?clientId='+id; }
    const searchBox = document.getElementById("clientSearchBox");
    const dropdown = document.getElementById("clientDropdown");
    searchBox.addEventListener("input", function(){
        let val = this.value.toLowerCase().trim();
        let idPart = val.split("-")[0].trim();
        for(let i=0;i<dropdown.options.length;i++){
            let opt = dropdown.options[i];
            if(i==0){ opt.style.display=""; continue; }
            let txt = (opt.getAttribute("data-search")||"").toLowerCase();
            let match = txt.includes(val) || txt.includes(idPart);
            opt.style.display = match? "" : "none";
        }
    });
    searchBox.addEventListener("change", function(){
        let val = this.value.toLowerCase(); let id = val.split("-")[0].trim();
        for(let i=0;i<dropdown.options.length;i++){
            let opt = dropdown.options[i]; let search = (opt.getAttribute("data-search")||"").toLowerCase();
            if(search.includes(id) && id!==""){ dropdown.value = opt.value; onClientChange(opt.value); break; }
        }
    });
    searchBox.addEventListener("keydown", function(e){ if(e.key==="Enter"){ e.preventDefault(); return false; } });
    function clearAll(){ window.location.href='/ClientVisit/Create'; }
    var rec=null, listening=false;
    function toggleDictation(){
        var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
        if(!SR){ alert("Voice not supported"); return; }
        var btn=document.getElementById("dictationBtn");
        if(!listening){
            rec=new SR(); rec.continuous=true; rec.interimResults=true; rec.lang="en-IN";
            rec.onresult=function(e){ var tr=""; for(var i=e.resultIndex;i<e.results.length;i++) if(e.results[i].isFinal) tr+=e.results[i][0].transcript; if(tr) document.getElementById("discussionBox").value+=(document.getElementById("discussionBox").value?" ":"")+tr; };
            rec.start(); listening=true; btn.innerText="⏸ Pause";
        } else { rec.stop(); listening=false; btn.innerText="🎤 Speak"; }
    }
</script>
} *@



@model List<ClientVisitManagement.Models.DynamicField>
@{
    var client = ViewBag.Client as ClientVisitManagement.Models.Client;
    var clients = ViewBag.Clients as List<ClientVisitManagement.Models.Client>?? new List<ClientVisitManagement.Models.Client>();
    int selectedClientId = ViewBag.SelectedClientId?? 0;

    // FIX: Form ko dynamic banaya - jo bhi naya column DB me add hoga yaha khud aa jayega
    var visitFields = Model.Where(f =>
        f.Name!= "VisitId" &&
        f.Name!= "ClientId" &&
        f.Name!= "UserId" &&
        f.Name!= "CreatedOn" &&
        f.Name!= "DiscussionRequirement" &&
        f.Name!= "Remarks"
    ).ToList();

    var discussionFields = Model.Where(f => f.Name == "DiscussionRequirement" || f.Name == "Remarks").ToList();
    var otherFields = Model.Where(f =>
        f.Name!= "VisitId" && f.Name!= "ClientId" && f.Name!= "UserId" && f.Name!= "CreatedOn" &&
       !visitFields.Contains(f) &&!discussionFields.Contains(f)
    ).ToList();
}

