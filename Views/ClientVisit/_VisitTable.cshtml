@model ClientVisitManagement.Models.DynamicTableViewModel
@{
    // AB SIRF YAHI 6 COLUMN + ACTION DIKHEGA
    var allowedInList = new[] { "VisitId", "ClientName", "StateName", "VisitDate", "PersonMet", "PersonName", "FollowUpStatus", "NextFollowUpDate" };

    // DB me jo naam hai us hisab se filter
    var displayCols = Model.Columns
       .Where(c => allowedInList.Contains(c))
       .OrderBy(c => Array.IndexOf(allowedInList, c))
       .ToList();

    // Agar CompanyName / ClientName dono hai to 1 hi lega, backup ke liye
    if(!displayCols.Any()){
        displayCols = Model.Columns.Where(c => c!= "UserId").Take(7).ToList();
    }

    int startSr = (Model.CurrentPage - 1) * Model.PageSize + 1;
}
