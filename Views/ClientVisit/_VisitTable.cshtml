                        Visited By
                        <i class="bi @(currentSort == "VisitedBy" ? (currentDirection == "ASC" ? "bi-arrow-up" : "bi-arrow-down") : "bi-arrow-down-up sort-neutral")"></i>
                    </a>
                </th>

                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">Pincode</th>
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">Person Met</th>

