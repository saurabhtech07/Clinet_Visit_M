                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    @{
                        var nextVisitDateDirection = currentSort == "VisitDate" && currentDirection == "ASC" ? "DESC" : "ASC";
                    }
                    <a class="table-sort-link ajax-visit-link" href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=VisitDate&direction=@nextVisitDateDirection&page=1&pageSize=@Model.PageSize">
