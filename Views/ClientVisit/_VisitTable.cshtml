@* @model VisitListViewModel

@{
    var currentSort = ViewBag.Sort as string ?? "VisitDate";
    var currentDirection = ViewBag.Direction as string ?? "DESC";

    int startNo = Model.Visits.Any()
        ? ((Model.Page - 1) * Model.PageSize) + 1
        : 0;

    int endNo = Model.Visits.Any()
        ? startNo + Model.Visits.Count - 1
        : 0;

    string Search = Uri.EscapeDataString(Model.SearchTerm ?? "");
    string FromDate = Model.FromDate?.ToString("yyyy-MM-dd") ?? "";
    string ToDate = Model.ToDate?.ToString("yyyy-MM-dd") ?? "";
}

<div class="table-container" style="max-height:58vh;overflow-y:auto;overflow-x:auto;">

    <table class="table table-hover mb-0 align-middle" id="cvTable">

        <thead>
            <tr style="position:sticky;top:0;z-index:10;background:#f8fafc;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;white-space:normal;line-height:1.15;padding:7px 8px;border-bottom:1px solid #e2e8f0;">

                <th class="serial-column" style="font-size:10px;font-weight:700;text-transform:uppercase;">Sr.No</th>


                <!-- CLIENT ID -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    Client ID
                </th>


                <!-- COMPANY NAME -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    @{
                        var nextClientNameDirection =
                            currentSort == "ClientName" &&
                            currentDirection == "ASC"
                                ? "DESC"
                                : "ASC";
                    }

                    <a class="table-sort-link ajax-visit-link"
                       href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=ClientName&direction=@nextClientNameDirection&page=1&pageSize=@Model.PageSize">

                        Company Name

                        <i class="bi @(currentSort == "ClientName"
                            ? (currentDirection == "ASC"
                                ? "bi-arrow-up"
                                : "bi-arrow-down")
                            : "bi-arrow-down-up sort-neutral")"></i>

                    </a>
                </th>


                <!-- CITY -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    @{
                        var nextCityDirection =
                            currentSort == "City" &&
                            currentDirection == "ASC"
                                ? "DESC"
                                : "ASC";
                    }

                    <a class="table-sort-link ajax-visit-link"
                       href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=City&direction=@nextCityDirection&page=1&pageSize=@Model.PageSize">

                        City

                        <i class="bi @(currentSort == "City"
                            ? (currentDirection == "ASC"
                                ? "bi-arrow-up"
                                : "bi-arrow-down")
                            : "bi-arrow-down-up sort-neutral")"></i>

                    </a>
                </th>


                <!-- STATE -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    @{
                        var nextStateDirection =
                            currentSort == "State" &&
                            currentDirection == "ASC"
                                ? "DESC"
                                : "ASC";
                    }

                    <a class="table-sort-link ajax-visit-link"
                       href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=State&direction=@nextStateDirection&page=1&pageSize=@Model.PageSize">

                        State

                        <i class="bi @(currentSort == "State"
                            ? (currentDirection == "ASC"
                                ? "bi-arrow-up"
                                : "bi-arrow-down")
                            : "bi-arrow-down-up sort-neutral")"></i>

                    </a>
                </th>


                <!-- VISITED BY -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    @{
                        var nextVisitedByDirection =
                            currentSort == "VisitedBy" &&
                            currentDirection == "ASC"
                                ? "DESC"
                                : "ASC";
                    }

                    <a class="table-sort-link ajax-visit-link"
                       href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=VisitedBy&direction=@nextVisitedByDirection&page=1&pageSize=@Model.PageSize">

                        Visited By

                        <i class="bi @(currentSort == "VisitedBy"
                            ? (currentDirection == "ASC"
                                ? "bi-arrow-up"
                                : "bi-arrow-down")
                            : "bi-arrow-down-up sort-neutral")"></i>

                    </a>
                </th>


                <!-- PINCODE -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    Pincode
                </th>


                <!-- PERSON MET -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    Person Met
                </th>


                <!-- PERSON NAME -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    @{
                        var nextPersonNameDirection =
                            currentSort == "PersonName" &&
                            currentDirection == "ASC"
                                ? "DESC"
                                : "ASC";
                    }

                    <a class="table-sort-link ajax-visit-link"
                       href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=PersonName&direction=@nextPersonNameDirection&page=1&pageSize=@Model.PageSize">

                        Person Name

                        <i class="bi @(currentSort == "PersonName"
                            ? (currentDirection == "ASC"
                                ? "bi-arrow-up"
                                : "bi-arrow-down")
                            : "bi-arrow-down-up sort-neutral")"></i>

                    </a>
                </th>


                <!-- VISIT DATE -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    @{
                        var nextVisitDateDirection =
                            currentSort == "VisitDate" &&
                            currentDirection == "ASC"
                                ? "DESC"
                                : "ASC";
                    }

                    <a class="table-sort-link ajax-visit-link"
                       href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=VisitDate&direction=@nextVisitDateDirection&page=1&pageSize=@Model.PageSize">

                        Visit Date

                        <i class="bi @(currentSort == "VisitDate"
                            ? (currentDirection == "ASC"
                                ? "bi-arrow-up"
                                : "bi-arrow-down")
                            : "bi-arrow-down-up sort-neutral")"></i>

                    </a>
                </th>


                <th class="actions-column">
                    Actions
                </th>

            </tr>
        </thead>


        <tbody>

            @if (Model.Visits.Any())
            {
                foreach (var v in Model.Visits)
                {
                    <tr>

                        <td>
                            @startNo
                        </td>

                        <td>
                            @v.ClientCode
                        </td>

                        <td>
                            @v.ClientName
                        </td>

                        <td>
                            @v.City
                        </td>

                        <td>
                            @v.State
                        </td>

                        <td>
                            @v.VisitedBy
                        </td>

                        <td>
                            @v.Pincode
                        </td>

                        <td>
                            @v.PersonMet
                        </td>

                        <td>
                            @v.PersonName
                        </td>

                        <td>
                            @v.VisitDate.ToString("dd-MM-yyyy")
                        </td>

                        <td class="action-icons">

                            <!-- VIEW -->
                            <a href="#"
                               onclick="viewDetails(@v.VisitId); return false;"
                               title="View">

                                <i class="bi bi-eye text-primary"></i>

                            </a>


                            <!-- EDIT -->
                            <a href="/ClientVisit/Edit/@v.VisitId"
                               data-no-modal onclick="event.preventDefault(); window.loadPage('/ClientVisit/Edit/@v.VisitId', 'Edit Visit');"
                               title="Edit">

                                <i class="bi bi-pencil-square text-warning"></i>

                            </a>


                            <!-- DELETE -->
                            <a href="#"
                               onclick="deleteVisit(@v.VisitId); return false;"
                               title="Delete">

                                <i class="bi bi-trash text-danger"></i>

                            </a>

                        </td>

                    </tr>

                    startNo++;
                }
            }
            else
            {
                <tr>

                    <td colspan="11"
                        class="text-center text-muted">

                        No records found

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


<!-- =========================================================
     FOOTER
     ========================================================= -->

<div class="table-footer">

    <!-- RECORDS PER PAGE -->
    <div class="records-per-page">

        <select id="visitPageSize"
                class="form-select form-select-sm">

            <option value="10"
                    selected="@(Model.PageSize == 10)">
                10
            </option>

            <option value="20"
                    selected="@(Model.PageSize == 20)">
                20
            </option>

            <option value="50"
                    selected="@(Model.PageSize == 50)">
                50
            </option>

            <option value="100"
                    selected="@(Model.PageSize == 100)">
                100
            </option>

        </select>

        <span>
            records per page
        </span>

    </div>


    <!-- SHOWING -->
    <div class="showing-records">

        Showing
        @startNo
        to
        @endNo
        of
        @Model.TotalCount
        entries

    </div>


    <!-- PAGINATION -->
    <div class="pagination-area">

        <!-- PREVIOUS -->
        @if (Model.Page > 1)
        {
            <a class="btn btn-sm btn-light border ajax-visit-link"
               href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=@currentSort&direction=@currentDirection&page=@(Model.Page - 1)&pageSize=@Model.PageSize">

                Previous

            </a>
        }
        else
        {
            <button class="btn btn-sm btn-light border"
                    disabled>

                Previous

            </button>
        }


        <!-- PAGE NUMBERS -->
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            if (p == Model.Page)
            {
                <span class="btn btn-sm btn-primary">
                    @p
                </span>
            }
            else
            {
                <a class="btn btn-sm btn-light border ajax-visit-link"
                   href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=@currentSort&direction=@currentDirection&page=@p&pageSize=@Model.PageSize">

                    @p

                </a>
            }
        }


        <!-- NEXT -->
        @if (Model.Page < Model.TotalPages)
        {
            <a class="btn btn-sm btn-light border ajax-visit-link"
               href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=@currentSort&direction=@currentDirection&page=@(Model.Page + 1)&pageSize=@Model.PageSize">

                Next

            </a>
        }
        else
        {
            <button class="btn btn-sm btn-light border"
                    disabled>

                Next

            </button>
        }

    </div>

</div> *@



@* 
@model VisitListViewModel
@{
    var currentSort = ViewBag.Sort as string ?? "VisitDate";
    var currentDirection = ViewBag.Direction as string ?? "DESC";
    int startNo = Model.Visits.Any() ? ((Model.Page - 1) * Model.PageSize) + 1 : 0;
    int endNo = Model.Visits.Any() ? startNo + Model.Visits.Count - 1 : 0;
    string Search = Uri.EscapeDataString(Model.SearchTerm ?? "");
    string FromDate = Model.FromDate?.ToString("yyyy-MM-dd") ?? "";
    string ToDate = Model.ToDate?.ToString("yyyy-MM-dd") ?? "";
}

<style>
    .visit-table-wrap{background:#fff; border-radius:12px; overflow:hidden;}
    .visit-table thead th{
        font-size:11px; font-weight:700; color:#6c757d; text-transform:uppercase;
        background:#f8f9fb; border-bottom:1px solid #eef0f2; padding:14px 12px; white-space:nowrap;
    }
    .visit-table tbody td{font-size:13px; padding:13px 12px; vertical-align:middle; border-bottom:1px solid #f1f3f5;}
    .table-sort-link{color:#6c757d; text-decoration:none; font-weight:700; display:flex; align-items:center; gap:4px;}
    .table-sort-link:hover{color:#111;}
    .sort-neutral{opacity:.4;}
    .client-pill{background:#111; color:#fff; border-radius:6px; padding:5px 10px; font-weight:700; font-size:12px; letter-spacing:.3px;}
    .action-icons a{margin-right:8px; font-size:16px;}
    .table-footer{background:#fff; border-top:1px solid #eef0f2; padding:12px 16px; display:flex; justify-content:space-between; align-items:center; border-radius:0 0 12px 12px;}
</style>

<div class="visit-table-wrap">
<div class="table-responsive">
    <table class="table mb-0 visit-table">
        <thead>
            <tr>
                <th class="serial-column">Sr.No</th>

                <!-- CLIENT ID WITH SORTING - ADDED -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    @{
                        var nextClientIdDirection = currentSort == "ClientId" && currentDirection == "ASC" ? "DESC" : "ASC";
                    }
                    <a class="table-sort-link ajax-visit-link" href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=ClientId&direction=@nextClientIdDirection&page=1&pageSize=@Model.PageSize">
                        Client ID
                        <i class="bi @(currentSort == "ClientId" ? (currentDirection == "ASC" ? "bi-arrow-up" : "bi-arrow-down") : "bi-arrow-down-up sort-neutral")"></i>
                    </a>
                </th>

                <!-- COMPANY NAME -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    @{
                        var nextClientNameDirection = currentSort == "ClientName" && currentDirection == "ASC" ? "DESC" : "ASC";
                    }
                    <a class="table-sort-link ajax-visit-link" href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=ClientName&direction=@nextClientNameDirection&page=1&pageSize=@Model.PageSize">
                        Company Name
                        <i class="bi @(currentSort == "ClientName" ? (currentDirection == "ASC" ? "bi-arrow-up" : "bi-arrow-down") : "bi-arrow-down-up sort-neutral")"></i>
                    </a>
                </th>

                <!-- CITY -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    @{
                        var nextCityDirection = currentSort == "City" && currentDirection == "ASC" ? "DESC" : "ASC";
                    }
                    <a class="table-sort-link ajax-visit-link" href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=City&direction=@nextCityDirection&page=1&pageSize=@Model.PageSize">
                        City
                        <i class="bi @(currentSort == "City" ? (currentDirection == "ASC" ? "bi-arrow-up" : "bi-arrow-down") : "bi-arrow-down-up sort-neutral")"></i>
                    </a>
                </th>

                <!-- STATE -->
                <th style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:7px 8px;">
                    @{
                        var nextStateDirection = currentSort == "State" && currentDirection == "ASC" ? "DESC" : "ASC";
                    }
                    <a class="table-sort-link ajax-visit-link" href="/ClientVisit?term=@Search&fromDate=@FromDate&toDate=@ToDate&sort=State&direction=@nextStateDirection&page=1&pageSize=@Model.PageSize">
