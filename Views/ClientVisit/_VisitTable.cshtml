                        <td>@v.VisitedBy</td>
                        <td>@v.Pincode</td>
                        <td>@v.PersonMet</td>
                        <td>@v.PersonName</td>
                        <td>@v.VisitDate.ToString("dd-MM-yyyy")</td>
                        <td class="action-icons">
                            <a href="#" onclick="viewDetails(@v.VisitId); return false;" title="View"><i class="bi bi-eye text-primary"></i></a>
