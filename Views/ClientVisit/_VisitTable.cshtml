<div class="table-responsive visit-table-responsive">
<table class="table table-hover align-middle mb-0" style="font-size:12.5px;">
<thead style="font-size:10px; font-weight:700; color:#64748b; letter-spacing:.3px; text-transform:uppercase;">
<tr>
    <th style="width:50px; padding:7px 8px;">Sr.No</th>
    @foreach(var col in displayCols)
    {
        var isSorted = Model.SortColumn == col;
        var arrow = isSorted? (Model.SortDirection=="ASC"?"▲":"▼") : "↕";
        var title = col;
        if(col=="CompanyName") title="ClientName / Company";
        if(col=="PersonName") title="PersonMet";
        <th style="white-space:normal; line-height:1.15; padding:7px 8px;">
            <a href="javascript:void(0)" class="sort-link text-decoration-none d-flex align-items-center gap-1" style="color:#6c757d;" data-sort="@col">
                @title <span style="@(isSorted?"color:#111;font-weight:900;":"color:#bbb;")">@arrow</span>
            </a>
        </th>
    }
    <th class="actions-col" style="width:110px; text-align:center;">ACTION</th>
</tr>
</thead>
<tbody>
@if(!Model.Rows.Any())
{
    <tr><td colspan="@(displayCols.Count+2)" class="text-center text-muted py-5">No records found</td></tr>
}
else
{
    int sr = startSr;
    foreach(var row in Model.Rows)
    {
        var visitId = row.ContainsKey("VisitId")? row["VisitId"]?.ToString() : "0";
    <tr>
        <td style="padding:5px 8px;"><span class="badge bg-dark" style="border-radius:6px;font-size:10.5px;">@sr</span></td>
        @foreach(var col in displayCols)
        {
            var val = row.ContainsKey(col)? row[col] : null;
            string str = val==null? "-" : val.ToString()!;
            if(DateTime.TryParse(str, out var d)){
                if(col=="NextFollowUpDate") str = d.ToString("dd-MM-yyyy");
                else str = d.ToString("dd-MM-yyyy hh:mm");
            }

            if(col=="FollowUpStatus"){
                var bg = str=="Pending"?"#ffc107": str=="Done"?"#198754":"#6f42c1";
                var txt = str=="Pending"?"#000":"#fff";
                <td><span class="badge" style="background:@bg; color:@txt; border-radius:12px; font-size:10px; padding:5px 10px;">@str</span></td>
            } else {
                <td title="@val" style="max-width:200px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-weight:500; font-size:12.5px; padding:5px 8px;">@str</td>
            }
        }
        <td class="actions-cell" style="text-align:center;padding:5px 8px;">
            <div class="d-flex gap-1 justify-content-center">
                <button type="button" class="btn btn-sm btn-outline-primary" style="width:28px; height:28px; padding:0; border-radius:6px;" onclick="viewDetails('@visitId')" title="View"><i class="bi bi-eye"></i></button>
                <a href="/ClientVisit/Edit/@visitId" class="btn btn-sm btn-outline-secondary" style="width:28px; height:28px; padding:0; border-radius:6px; display:flex; align-items:center; justify-content:center;" title="Edit" data-no-modal onclick="event.preventDefault(); window.loadPage('/ClientVisit/Edit/@visitId', 'Edit Visit');"><i class="bi bi-pencil"></i></a>
                <button type="button" class="btn btn-sm btn-outline-danger" style="width:28px; height:28px; padding:0; border-radius:6px;" onclick="deleteVisit('@visitId')" title="Delete"><i class="bi bi-trash"></i></button>
            </div>
        </td>
    </tr>
    sr++;
    }
}
</tbody>
</table>
</div>

@{
    // DSS Report jaisa pager: Prev [Page X of Y] Next
    int vTotalPages = Model.TotalPages < 1 ? 1 : Model.TotalPages;
    int vCurPage = Model.CurrentPage < 1 ? 1 : (Model.CurrentPage > vTotalPages ? vTotalPages : Model.CurrentPage);
    int vShowingFrom = Model.TotalRecords == 0 ? 0 : ((vCurPage - 1) * Model.PageSize) + 1;
    int vShowingTo = Math.Min(vCurPage * Model.PageSize, Model.TotalRecords);
}
<div class="visit-pager">
    <div class="d-flex align-items-center gap-2">
        <span class="vp-label">Show</span>
        <select id="visitPageSize" class="form-select vp-page-size">
            <option value="10" selected="@(Model.PageSize==10)">10</option>
            <option value="20" selected="@(Model.PageSize==20)">20</option>
            <option value="50" selected="@(Model.PageSize==50)">50</option>
            <option value="100" selected="@(Model.PageSize==100)">100</option>
        </select>
        <span class="vp-label">entries</span>
    </div>
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <span class="vp-total">Total: <b>@Model.TotalRecords</b></span>
        <span class="vp-showing">Showing @vShowingFrom to @vShowingTo of @Model.TotalRecords</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (vCurPage > 1)
        {
            <button type="button" class="vp-page-btn vp-page" data-page="@(vCurPage - 1)" title="Previous page"><i class="bi bi-chevron-left"></i></button>
        }
        else
        {
            <button type="button" class="vp-page-btn" disabled title="Previous page"><i class="bi bi-chevron-left"></i></button>
        }
        <div class="vp-page-box">Page <b>@vCurPage</b> of <b>@vTotalPages</b></div>
        @if (vCurPage < vTotalPages)
        {
            <button type="button" class="vp-page-btn vp-page" data-page="@(vCurPage + 1)" title="Next page"><i class="bi bi-chevron-right"></i></button>
        }
        else
        {
            <button type="button" class="vp-page-btn" disabled title="Next page"><i class="bi bi-chevron-right"></i></button>
        }
    </div>
</div>