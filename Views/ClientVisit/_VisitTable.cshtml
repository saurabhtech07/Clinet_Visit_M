@model ClientVisitManagement.Models.DynamicTableViewModel
@{
    // AB SIRF YAHI 6 COLUMN + ACTION DIKHEGA
    var allowedInList = new[] { "VisitId", "ClientName", "StateName", "VisitDate", "PersonMet", "PersonName", "FollowUpStatus", "NextFollowUpDate" };

    // DB me jo naam hai us hisab se filter
    var displayCols = Model.Columns
       .Where(c => allowedInList.Contains(c))
       .OrderBy(c => Array.IndexOf(allowedInList, c))
       .ToList();

    // Agar CompanyName / ClientName dono hai to 1 hi lega, backup ke liye
    if(!displayCols.Any()){
        displayCols = Model.Columns.Where(c => c!= "UserId").Take(7).ToList();
    }

    int startSr = (Model.CurrentPage - 1) * Model.PageSize + 1;
}
<style>
 .visit-table-responsive{ max-height: 65vh; overflow:auto; }
 .visit-table-responsive thead th{
        position: sticky;
        top: 0;
        z-index: 10;
        background: #f8f9fa!important;
        box-shadow: 0 1px 0 #e9ecef;
    }
</style>

<div class="table-responsive visit-table-responsive">
<table class="table table-hover align-middle mb-0" style="font-size:13px;">
<thead style="font-size:10px; font-weight:700; color:#6c757d; letter-spacing:.5px; text-transform:uppercase;">
<tr>
    <th style="width:50px;">Sr.No</th>
    @foreach(var col in displayCols)
    {
        var isSorted = Model.SortColumn == col;
        var arrow = isSorted? (Model.SortDirection=="ASC"?"▲":"▼") : "↕";
        var title = col;
        if(col=="CompanyName") title="ClientName / Company";
        if(col=="PersonName") title="PersonMet / PersonName";
        <th style="white-space:nowrap;">
            <a href="javascript:void(0)" class="sort-link text-decoration-none d-flex align-items-center gap-1" style="color:#6c757d;" data-sort="@col">
                @title <span style="@(isSorted?"color:#111;font-weight:900;":"color:#bbb;")">@arrow</span>
            </a>
        </th>
    }
    <th style="width:110px; text-align:center;">ACTION</th>
</tr>
</thead>
<tbody>
@if(!Model.Rows.Any())
{
    <tr><td colspan="@(displayCols.Count+2)" class="text-center text-muted py-5">No records found</td></tr>
}
else
{
    int sr = startSr;
    foreach(var row in Model.Rows)
    {
        var visitId = row.ContainsKey("VisitId")? row["VisitId"]?.ToString() : "0";
    <tr>
        <td><span class="badge bg-dark" style="border-radius:6px;">@sr</span></td>
        @foreach(var col in displayCols)
        {
            var val = row.ContainsKey(col)? row[col] : null;
            string str = val==null? "-" : val.ToString()!;
            if(DateTime.TryParse(str, out var d)){
                if(col=="NextFollowUpDate") str = d.ToString("dd-MM-yyyy");
                else str = d.ToString("dd-MM-yyyy hh:mm");
            }

            if(col=="FollowUpStatus"){
                var bg = str=="Pending"?"#ffc107": str=="Done"?"#198754":"#6f42c1";
                var txt = str=="Pending"?"#000":"#fff";
                <td><span class="badge" style="background:@bg; color:@txt; border-radius:12px; font-size:10px; padding:5px 10px;">@str</span></td>
            } else {
                <td title="@val" style="max-width:200px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-weight:500;">@str</td>
            }
        }
        <td style="text-align:center;">
            <div class="d-flex gap-1 justify-content-center">
                <button type="button" class="btn btn-sm btn-outline-primary" style="width:28px; height:28px; padding:0; border-radius:6px;" onclick="viewDetails('@visitId')" title="View"><i class="bi bi-eye"></i></button>
                <a href="/ClientVisit/Edit/@visitId" class="btn btn-sm btn-outline-secondary" style="width:28px; height:28px; padding:0; border-radius:6px; display:flex; align-items:center; justify-content:center;" title="Edit"><i class="bi bi-pencil"></i></a>
                <button type="button" class="btn btn-sm btn-outline-danger" style="width:28px; height:28px; padding:0; border-radius:6px;" onclick="deleteVisit('@visitId')" title="Delete"><i class="bi bi-trash"></i></button>
            </div>
        </td>
    </tr>
    sr++;
    }
}
</tbody>
</table>
</div>

<div class="d-flex justify-content-between align-items-center p-3 border-top bg-white">
    <div class="d-flex align-items-center gap-2">
        <span style="font-size:12px; color:#6c757d;">Show</span>
        <select id="visitPageSize" class="form-select form-select-sm" style="width:75px; height:32px; border-radius:8px; background:#f8f9fa;">
            <option value="10" selected="@(Model.PageSize==10)">10</option>
            <option value="20" selected="@(Model.PageSize==20)">20</option>
            <option value="50" selected="@(Model.PageSize==50)">50</option>
            <option value="100" selected="@(Model.PageSize==100)">100</option>
        </select>
        <span style="font-size:12px; color:#6c757d;">Total: @Model.TotalRecords</span>
    </div>
    <div class="d-flex align-items-center gap-1">
        @{
            var prevPage = Model.CurrentPage - 1;
            var nextPage = Model.CurrentPage + 1;
        }
        <a href="/ClientVisit?page=@prevPage&term=@Model.SearchTerm&sort=@Model.SortColumn&direction=@Model.SortDirection" class="btn btn-sm @(prevPage>=1? "btn-light border ajax-visit-link" : "btn-light border disabled")" style="border-radius:8px;">Previous</a>
        @for(int i=Math.Max(1, Model.CurrentPage-2); i<=Math.Min(Model.TotalPages, Model.CurrentPage+2); i++)
        {
            var url = $"/ClientVisit?page={i}&term={Model.SearchTerm}&sort={Model.SortColumn}&direction={Model.SortDirection}";
            <a href="@url" class="btn btn-sm ajax-visit-link @(i==Model.CurrentPage? "btn-dark" : "btn-light border")" style="border-radius:8px; min-width:32px;">@i</a>
        }
        <a href="/ClientVisit?page=@nextPage&term=@Model.SearchTerm&sort=@Model.SortColumn&direction=@Model.SortDirection" class="btn btn-sm @(nextPage<=Model.TotalPages? "btn-light border ajax-visit-link" : "btn-light border disabled")" style="border-radius:8px;">Next</a>
    </div>
</div>