@* @model VisitListViewModel

<!-- =========================================================
     PAGE HEADER
     ========================================================= -->

<div class="visit-page-header">

    <div>
        <h4 class="mb-1">Client Visit List</h4>

        <div class="visit-subtitle">
            Track and manage all client visits, follow-ups and field performance
        </div>
    </div>

    <a href="/ClientVisit/SelectClient"
       class="btn btn-primary add-visit-btn">

        <i class="bi bi-plus-lg"></i>
        Add Visit for Existing Client

    </a>

</div>


<!-- =========================================================
     KPI CARDS
     ========================================================= -->

<div class="row g-3 mb-3">

    <!-- TOTAL CLIENTS VISITED -->
    <div class="col-md-3">
        <div class="kpi-card kpi-orange">

            <div class="kpi-content">

                <div class="kpi-icon">
                    <i class="bi bi-buildings"></i>
                </div>

                <span class="kpi-title">
                    Total Clients Visited
                </span>

                <span class="kpi-value">
                    @(ViewBag.TotalClientsVisited ?? 0)
                </span>

            </div>

        </div>
    </div>


    <!-- VISITS THIS MONTH -->
    <div class="col-md-3">
        <div class="kpi-card kpi-blue">

            <div class="kpi-content">

                <div class="kpi-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <span class="kpi-title">
                    Visits This Month
                </span>

                <span class="kpi-value">
                    @(ViewBag.VisitsThisMonth ?? 0)
                </span>

            </div>

        </div>
    </div>


    <!-- TODAY'S VISITS -->
    <div class="col-md-3">
        <div class="kpi-card kpi-green">

            <div class="kpi-content">

                <div class="kpi-icon">
                    <i class="bi bi-calendar-day"></i>
                </div>

                <span class="kpi-title">
                    Today's Visits
                </span>

                <span class="kpi-value">
                    @(ViewBag.TodaysVisits ?? 0)
                </span>

            </div>

        </div>
    </div>


    <!-- PENDING FOLLOW UPS -->
    <div class="col-md-3">
        <div class="kpi-card kpi-purple">

            <div class="kpi-content">

                <div class="kpi-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <span class="kpi-title">
                    Pending Follow-ups
                </span>

                <span class="kpi-value">
                    @(ViewBag.PendingFollowUps ?? 0)
                </span>

            </div>

        </div>
    </div>

</div>


<!-- =========================================================
     FILTER / SEARCH SECTION
     ========================================================= -->

<div class="card-section visit-filter-card">

    <div class="visit-filter-row">

        <!-- SEARCH -->
        <div class="visit-filter search-filter">

            <label>Search</label>

            <div class="visit-search-box">

                <i class="bi bi-search"></i>

                <input id="visitSearch"
                       type="text"
                       value="@Model.SearchTerm"
                       placeholder="Client, mobile, user, city..."
                       autocomplete="off" />

            </div>

        </div>


        <!-- FROM DATE -->
        <div class="visit-filter date-filter">

            <label>From Date</label>

            <input id="fromDate"
                   class="form-control"
                   type="date"
                   value="@Model.FromDate?.ToString("yyyy-MM-dd")" />

        </div>


        <!-- TO DATE -->
        <div class="visit-filter date-filter">

            <label>To Date</label>

            <input id="toDate"
                   class="form-control"
                   type="date"
                   value="@Model.ToDate?.ToString("yyyy-MM-dd")" />

        </div>


        <!-- CLEAR -->
        <div class="visit-filter action-filter">

            <label>&nbsp;</label>

            <button type="button"
                    id="clearVisitFilter"
                    class="visit-clear-btn">

                <i class="bi bi-x-lg"></i>
                Clear

            </button>

        </div>


        <!-- EXPORT -->
        <div class="visit-filter action-filter">

            <label>&nbsp;</label>

            <div class="dropdown export-dropdown">

                <button class="btn export-main-btn dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown">

                    <i class="bi bi-download"></i>
                    Export

                </button>

                <ul class="dropdown-menu">

                    <li>
                        <a id="visitExportExcel"
                           class="dropdown-item"
                           href="/ClientVisit/ExportToExcel">

                            <i class="bi bi-file-earmark-excel text-success"></i>
                            Excel

                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item"
                           href="javascript:void(0);"
                           onclick="exportVisitCsv();">

                            <i class="bi bi-filetype-csv text-info"></i>
                            CSV

                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item"
                           href="javascript:void(0);"
                           onclick="printVisitTable();">

                            <i class="bi bi-printer text-primary"></i>
                            Print

                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     TABLE SECTION
     ========================================================= -->

<div class="card-section visit-table-card">

    <div id="visitTable">

        @await Html.PartialAsync("_VisitTable", Model)

    </div>

</div>


<!-- =========================================================
     DETAILS MODAL
     ========================================================= -->

<div class="modal fade"
     id="detailsModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content"
             id="detailsModalContent">

            <div class="modal-body text-center py-5">
                Loading...
            </div>

        </div>

    </div>

</div>


<!-- DELETE -->
<form id="deleteForm"
      method="post"
      style="display:none">

    @Html.AntiForgeryToken()

</form>


@section Scripts {

<script>

    let searchTimer;

    const searchInput =
        document.getElementById("visitSearch");

    const fromDate =
        document.getElementById("fromDate");

    const toDate =
        document.getElementById("toDate");

    const visitTable =
        document.getElementById("visitTable");

    const exportExcel =
        document.getElementById("visitExportExcel");


    // =========================================================
    // BUILD URL
    // =========================================================

    function buildUrl(page = 1) {

        const p = new URLSearchParams();

        const term =
            searchInput.value.trim();

        if (term)
            p.append("term", term);

        if (fromDate.value)
            p.append("fromDate", fromDate.value);

        if (toDate.value)
            p.append("toDate", toDate.value);

        p.append("page", page);

        p.append(
            "pageSize",
            document.getElementById("visitPageSize")?.value || 10
        );

        return "/ClientVisit?" + p.toString();
    }


    // =========================================================
    // EXPORT URL
    // =========================================================

    function updateExportUrl() {

        const p =
            new URLSearchParams();

        const term =
            searchInput.value.trim();

        if (term)
            p.append("term", term);

        if (fromDate.value)
            p.append(
                "fromDate",
                fromDate.value
            );

        if (toDate.value)
            p.append(
                "toDate",
                toDate.value
            );

        exportExcel.href =
            "/ClientVisit/ExportToExcel?" +
            p.toString();
    }


    // =========================================================
    // AJAX TABLE
    // =========================================================

    function loadVisitTable(url) {

        fetch(url, {
            headers: {
                "X-Requested-With":
                    "XMLHttpRequest"
            }
        })
        .then(response => {

            if (!response.ok)
                throw new Error(
                    "Failed to load visits."
                );

            return response.text();

        })
        .then(html => {

            visitTable.innerHTML = html;

            updateExportUrl();

        })
        .catch(error => {

            console.error(
                "Visit table error:",
                error
            );

        });
    }


    // =========================================================
    // LIVE SEARCH
    // =========================================================

    searchInput.addEventListener(
        "input",
        function () {

            clearTimeout(searchTimer);

            searchTimer =
                setTimeout(() => {

                    loadVisitTable(
                        buildUrl(1)
                    );

                }, 300);
        }
    );


    // =========================================================
    // DATE FILTER
    // =========================================================

    fromDate.addEventListener(
        "change",
        () => loadVisitTable(buildUrl(1))
    );

    toDate.addEventListener(
        "change",
        () => loadVisitTable(buildUrl(1))
    );


    // =========================================================
    // PAGE SIZE
    // =========================================================

    document.addEventListener(
        "change",
        function (event) {

            if (
                event.target.id !==
                "visitPageSize"
            )
                return;

            loadVisitTable(
                buildUrl(1)
            );

        }
    );


    // =========================================================
    // CLEAR
    // =========================================================

    document.getElementById(
        "clearVisitFilter"
    ).addEventListener(
        "click",
        function () {

            searchInput.value = "";
            fromDate.value = "";
            toDate.value = "";

            const size =
                document.getElementById(
                    "visitPageSize"
                );

            if (size)
                size.value = "10";

            loadVisitTable(
                buildUrl(1)
            );

            updateExportUrl();

        }
    );


    // =========================================================
    // SORT + PAGINATION
    // =========================================================

    document.addEventListener(
        "click",
        function (event) {

            const link =
                event.target.closest(
                    ".ajax-visit-link"
                );

            if (!link)
                return;

            event.preventDefault();

            loadVisitTable(
                link.href
            );

        }
    );


    // =========================================================
    // DETAILS
    // =========================================================

    function viewDetails(id) {

        $.get(
            "/ClientVisit/Details/" + id,
            function (html) {

                $("#detailsModalContent")
                    .html(html);

                new bootstrap.Modal(
                    document.getElementById(
                        "detailsModal"
                    )
                ).show();

            }
        );
    }


    // =========================================================
    // DELETE
    // =========================================================

    function deleteVisit(id) {

        if (!confirm(
            "Are you sure you want to delete this visit?"
        ))
            return;

        $("#deleteForm")
            .attr(
                "action",
                "/ClientVisit/Delete/" + id
            )
            .submit();
    }


    // =========================================================
    // EXPORT CSV
    // =========================================================

    function exportVisitCsv() {

        const p =
            new URLSearchParams();

        const term =
            searchInput.value.trim();

        if (term)
            p.append("term", term);

        if (fromDate.value)
            p.append(
                "fromDate",
                fromDate.value
            );

        if (toDate.value)
            p.append(
                "toDate",
                toDate.value
            );

        window.location.href =
            "/ClientVisit/ExportToCsv?" +
            p.toString();
    }


    // =========================================================
    // PRINT
    // =========================================================

    function printVisitTable() {
        window.print();
    }


    updateExportUrl();

</script>

} *@


