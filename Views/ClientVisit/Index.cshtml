<form id="deleteForm" method="post" style="display:none">@Html.AntiForgeryToken()</form>

<script>
    var searchTimer;
    var currentSort = "@Model.SortColumn";
    var currentDir = "@Model.SortDirection";
    var searchInput = document.getElementById("visitSearch");
    var fromDate = document.getElementById("fromDate");
    var toDate = document.getElementById("toDate");
    var visitTable = document.getElementById("visitTable");
    var exportExcel = document.getElementById("visitExportExcel");

    function buildUrl(page = 1) {
        const p = new URLSearchParams();
        if (searchInput.value.trim()) p.append("term", searchInput.value.trim());
        if (fromDate.value) p.append("fromDate", fromDate.value);
        if (toDate.value) p.append("toDate", toDate.value);
        if(currentSort) p.append("sort", currentSort);
        if(currentDir) p.append("direction", currentDir);
        p.append("page", page);
        p.append("pageSize", document.getElementById("visitPageSize")?.value || 10);
        return "/ClientVisit?" + p.toString();
    }
    function updateExportUrl() {
        const p = new URLSearchParams();
        if (searchInput.value.trim()) p.append("search", searchInput.value.trim());
        exportExcel.href = "/ClientVisit/ExportExcel?" + p.toString();
    }
    function loadVisitTable(url) {
        fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
       .then(r => r.text()).then(html => { visitTable.innerHTML = html; updateExportUrl(); });
    }
    searchInput.addEventListener("input", function () { clearTimeout(searchTimer); searchTimer = setTimeout(() => loadVisitTable(buildUrl(1)), 300); });
    fromDate.addEventListener("change", () => loadVisitTable(buildUrl(1)));
    toDate.addEventListener("change", () => loadVisitTable(buildUrl(1)));
    document.addEventListener("change", function (e) { if (e.target.id === "visitPageSize") loadVisitTable(buildUrl(1)); });
    document.getElementById("clearVisitFilter").addEventListener("click", function () {
        searchInput.value = ""; fromDate.value = ""; toDate.value = "";
        const size = document.getElementById("visitPageSize"); if (size) size.value = "10";
        currentSort=""; currentDir="DESC";
        loadVisitTable(buildUrl(1));
    });
    // SORTING + PAGINATION + ACTION - sirf ek baar register (AJAX nav safe)
    if (!window.__visitNav) window.__visitNav = {};
    if (!window.__visitNav.delegates) {
    window.__visitNav.delegates = true;
    document.addEventListener("click", function (e) {
        if (e.__visitNavHandled) return;
        const sortLink = e.target.closest(".sort-link");
        if(sortLink){
            e.preventDefault();
            e.__visitNavHandled = true;
            const col = sortLink.dataset.sort;
            if(currentSort === col) currentDir = currentDir==="ASC"?"DESC":"ASC";
            else { currentSort = col; currentDir = "ASC"; }
            loadVisitTable(buildUrl(1));
            return;
        }
        const pageLink = e.target.closest(".ajax-visit-link");
        if(pageLink){ e.preventDefault(); e.__visitNavHandled = true; loadVisitTable(pageLink.href); }
    });
    }
    function viewDetails(id) { openVisitDetails(id); }
    function cvFmtLabel(k) { if (k === "VisitTypeId") return "Visit Type"; return String(k).replace(/([a-z])([A-Z])/g, "$1 $2"); }
    function cvBuildRows(obj, skip) {
        if (!obj) return '<div class="text-muted" style="font-size:12px;">No data</div>';
        var html = "";
        for (var k in obj) {
            if (skip.indexOf(k) > -1) continue;
            var v = obj[k]; if (v === null || v === undefined || v === "") v = "-";
            if (String(k).toLowerCase().indexOf("date") > -1 && v !== "-") { try { v = new Date(v).toLocaleString(); } catch (err) { } }
            html += '<div class="dss-row"><span>' + cvFmtLabel(k) + '</span><span>' + v + '</span></div>';
        }
        return html || '<div class="text-muted" style="font-size:12px;">No data</div>';
    }
    function openVisitDetails(id) {
        var modalEl = document.getElementById("cvViewModal");
        if (!modalEl || !id) return;
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        var titleEl = document.getElementById("cvViewModalTitle");
        var bodyEl = document.getElementById("cvViewModalBody");
        var editEl = document.getElementById("cvViewModalEdit");

        titleEl.textContent = "Loading…";
        bodyEl.innerHTML = '<div class="text-center p-5"><div class="spinner-border text-dark"></div></div>';
        if (editEl) editEl.href = "/ClientVisit/Edit/" + id;
        modal.show();

        fetch("/ClientVisit/GetVisitDetails?id=" + encodeURIComponent(id), { headers: { "X-Requested-With": "XMLHttpRequest" } })
            .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
            .then(function (data) {
                var v = data.visit || {}, c = data.client || {}, h = data.history || [];
                titleEl.textContent = (c.ClientName ? c.ClientName : "Visit") + (v.VisitDate ? " - " + new Date(v.VisitDate).toLocaleDateString() : "");
                var skipV = ["UserId", "ClientId", "Designation"];
                var hist = h.length
                    ? h.map(function (row) {
                        return "<tr><td><span style='background:#0f172a;color:#fff;padding:2px 6px;border-radius:4px;font-size:10px;'>#" + (row.VisitId || "") + "</span></td>" +
                            "<td style='font-size:11px;'>" + (row.VisitDate ? new Date(row.VisitDate).toLocaleDateString() : "-") + "</td>" +
                            "<td style='font-size:11px;'>" + (row.PersonMet || row.PersonName || "-") + "</td>" +
                            "<td>" + (row.VisitType || row.PurposeOfVisit || "-") + "</td>" +
                            "<td>" + (row.FollowUpStatus || "-") + "</td>" +
                            "<td style='font-size:11px;'>" + (row.NextFollowUpDate ? new Date(row.NextFollowUpDate).toLocaleDateString() : "-") + "</td></tr>";
                    }).join("")
                    : "<tr><td colspan='6' class='text-center text-muted'>No visit history</td></tr>";

                bodyEl.innerHTML =
                    "<div class='p-3'>" +
                        "<div class='row g-2 mb-2'>" +
                            "<div class='col-md-6'><div class='modal-info h-100'><div class='dss-modal-sec'>Visit Info</div>" + cvBuildRows(v, skipV) + "</div></div>" +
                            "<div class='col-md-6'><div class='modal-info h-100'><div class='dss-modal-sec'>Client Info</div>" + cvBuildRows(c, ["ClientId", "UserId", "StateId"]) + "</div></div>" +
                        "</div>" +
                        "<div class='modal-info'><div class='dss-modal-sec'>Visit History (Last 10 Visits)</div>" +
                            "<table class='table table-sm mb-0' style='font-size:12px;'><thead><tr><th>Visit</th><th>Date</th><th>Person Met</th><th>Purpose</th><th>Status</th><th>Next Follow-up</th></tr></thead><tbody>" + hist + "</tbody></table>" +
                        "</div>" +
                    "</div>";
            })
            .catch(function (err) {
                bodyEl.innerHTML = "<div class='p-4 text-danger text-center'>Failed to load: " + err.message + "</div>";
            });
    }
    function deleteVisit(id) {
        if (!confirm("Are you sure?")) return;
        Ajax.postSimple("/ClientVisit/Delete/" + id, null, function () { loadVisitTable(buildUrl(1)); });
    }
    function exportVisitCsv() { window.location.href = "/ClientVisit/ExportCsv?search=" + encodeURIComponent(searchInput.value.trim()); }
    window.refreshCurrentTable = function () { loadVisitTable(buildUrl(1)); };
    updateExportUrl();
</script>