

@model ClientVisitManagement.Models.DynamicTableViewModel
@{
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}

<style>
  .dss-kpi-card{background:#fff;border-radius:10px;border:1px solid #eef2f7;padding:8px 12px;height:60px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 1px 2px rgba(0,0,0,0.04)}
  .dss-kpi-label{font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;margin-bottom:1px;letter-spacing:0.4px}
  .dss-kpi-value{font-size:18px;font-weight:800;color:#0f172a;line-height:1}
  .dss-kpi-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;flex-shrink:0}
  .dss-toolbar{background:#fff;border-radius:12px;border:1px solid #eef2f7;padding:10px 12px}
  .dss-table-card{background:#fff;border-radius:14px;border:1px solid #eef2f7;overflow:hidden}
  .btn-dss-dark{background:#0f172a;color:#fff;border-radius:10px;font-size:13px;padding:9px 16px}
  .leads-search{position:relative}
  .leads-search i{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:13px}
  .leads-input{height:32px;font-size:12.5px;border-radius:9px;background:#f8fafc;border:1px solid #e2e8f0;padding-top:4px;padding-bottom:4px}
  .leads-input:focus{background:#fff;border-color:#cbd5e1;box-shadow:none}
  .leads-search input{padding-left:30px}
</style>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="fw-bold mb-0">User Master</h4>
    <a href="/User/Create" class="btn btn-dss-dark"><i class="bi bi-plus-circle me-1"></i> Add User</a>
</div>

<div class="row g-2 mb-2">
    <div class="col-6 col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Total Users</div>
                <div class="dss-kpi-value">@Model.TotalRecords</div>
            </div>
            <div class="dss-kpi-icon" style="background:#f59e0b;"><i class="bi bi-people-fill"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Active Users</div>
                <div class="dss-kpi-value">@(Model.Rows.Count(r => r.ContainsKey("IsActive") && r["IsActive"]!=null && Convert.ToBoolean(r["IsActive"])))</div>
            </div>
            <div class="dss-kpi-icon" style="background:#ef4444;"><i class="bi bi-person-check-fill"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Inactive Users</div>
                <div class="dss-kpi-value">@(Model.Rows.Count(r => r.ContainsKey("IsActive") && r["IsActive"]!=null && !Convert.ToBoolean(r["IsActive"])))</div>
            </div>
            <div class="dss-kpi-icon" style="background:#10b981;"><i class="bi bi-person-x-fill"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Roles</div>
                <div class="dss-kpi-value">@(Model.Rows.Where(r=>r.ContainsKey("Role")&&r["Role"]!=null).Select(r=>r["Role"]?.ToString()).Where(s=>!string.IsNullOrWhiteSpace(s)).Distinct().Count())</div>
            </div>
            <div class="dss-kpi-icon" style="background:#8b5cf6;"><i class="bi bi-shield-check"></i></div>
        </div>
    </div>
</div>

<!-- FILTER TOOLBAR (compact single row) -->
<div class="dss-toolbar mb-2">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="leads-search" style="flex:1 1 220px; min-width:180px;">
            <i class="bi bi-search"></i>
            <input type="text" id="userSearch" value="@Model.SearchTerm" class="form-control leads-input" placeholder="Search user / role / mobile..." autocomplete="off" />
        </div>

        <button id="clearUserFilter" class="btn btn-light border" style="border-radius:9px; font-size:12.5px; height:32px;">
            <i class="bi bi-x-circle me-1"></i>Clear
        </button>

        <div class="dropdown ms-auto">
            <button class="btn btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                    style="border-radius:9px; font-size:12.5px; height:32px;">
                <i class="bi bi-download me-1"></i> Export
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a id="userExportExcel" class="dropdown-item" href="/User/ExportExcel"><i class="bi bi-file-earmark-excel me-2 text-success"></i>Excel</a></li>
                <li><a id="userExportCsv" class="dropdown-item" href="/User/ExportCsv"><i class="bi bi-filetype-csv me-2 text-primary"></i>CSV</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="javascript:void(0);" onclick="window.printTable('userTable','User Master');"><i class="bi bi-printer me-2"></i>Print</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="dss-table-card"><div id="userTable">@await Html.PartialAsync("_UserTable", Model)</div></div>
<script>
    window.__userNav = window.__userNav || {};

    function buildUrl(page = 1) {
        const p = new URLSearchParams();
        const searchInput = document.getElementById("userSearch");
        const term = searchInput ? searchInput.value.trim() : "";
        if (term) p.append("search", term);
        p.append("page", page);
        p.append("pageSize", document.getElementById("visitPageSize")?.value || document.getElementById("userPageSize")?.value || 10);
        return "/User?" + p.toString();
    }

    // CLIENT VISIT JAISE HI EXPORT URL UPDATE HOGA
    function updateExportUrl() {
        const p = new URLSearchParams();
        const searchInput = document.getElementById("userSearch");
        const term = searchInput ? searchInput.value.trim() : "";
        if (term) p.append("search", term);
        const q = p.toString();
        const exportExcel = document.getElementById("userExportExcel");
        const exportCsv = document.getElementById("userExportCsv");
        if (exportExcel) exportExcel.href = "/User/ExportExcel" + (q ? "?" + q : "");
        if (exportCsv) exportCsv.href = "/User/ExportCsv" + (q ? "?" + q : "");
    }

    function loadUserTable(url) {
        fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(r => { if (!r.ok) throw new Error(); return r.text(); })
        .then(html => {
            const userTable = document.getElementById("userTable");
            if (userTable) userTable.innerHTML = html;
            updateExportUrl();
        })
        .catch(e => console.error(e));
    }

    window.refreshCurrentTable = function () { loadUserTable(buildUrl(1)); };

    // SORT + PAGINATION + PAGE SIZE - sirf ek baar register (AJAX nav safe)
    if (!window.__userNav.delegates) {
        window.__userNav.delegates = true;

        document.addEventListener("click", function (e) {
            if (e.__ajaxNavHandled) return;
            const link = e.target.closest(".ajax-table-link");
            if (!link) return;
            // Sirf tab handle karo jab is page ka table maujood ho (warna doosre page ka handler click kha jaata hai)
            if (!document.getElementById("userTable")) return;
            e.preventDefault();
            e.__ajaxNavHandled = true;
            loadUserTable(link.href);
        });

        document.addEventListener("change", function (e) {
            if (e.__ajaxNavHandled) return;
            if (e.target.id !== "userPageSize" && e.target.id !== "visitPageSize") return;
            e.__ajaxNavHandled = true;
            loadUserTable(buildUrl(1));
        });
    }

    var searchInput = document.getElementById("userSearch");
    if (searchInput) {
        searchInput.addEventListener("keyup", function () {
            loadUserTable(buildUrl(1));
        });
    }

    var clearUserFilter = document.getElementById("clearUserFilter");
    if (clearUserFilter) {
        clearUserFilter.addEventListener("click", function () {
            if (searchInput) searchInput.value = "";
            loadUserTable(buildUrl(1));
            updateExportUrl();
        });
    }

    // CLIENT VISIT WALA CSV LOGIC
    function exportUserCsv() {
        const p = new URLSearchParams();
        const searchInput = document.getElementById("userSearch");
        const term = searchInput ? searchInput.value.trim() : "";
        if (term) p.append("search", term);
        window.location.href = "/User/ExportCsv?" + p.toString();
    }

    // CLIENT VISIT WALA PRINT LOGIC - TERA PEHLE WALA
    function printUserTable() {
        window.print();
    }

    updateExportUrl();
</script>