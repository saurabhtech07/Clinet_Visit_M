

@model ClientVisitManagement.Models.DynamicTableViewModel
@{
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}

<style>
  .dss-kpi-card{background:#fff;border-radius:12px;border:1px solid #eef2f7;padding:12px 14px;height:72px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 1px 2px rgba(0,0,0,0.04)}
  .dss-kpi-label{font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;margin-bottom:2px;letter-spacing:0.5px}
  .dss-kpi-value{font-size:22px;font-weight:800;color:#0f172a;line-height:1}
  .dss-kpi-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:16px;flex-shrink:0}
  .dss-toolbar{background:#fff;border-radius:14px;border:1px solid #eef2f7;padding:14px 18px}
  .dss-toolbar-label{font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;margin-bottom:6px}
  .dss-search-input{background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;font-size:13px;padding:9px 14px}
  .dss-table-card{background:#fff;border-radius:14px;border:1px solid #eef2f7;overflow:hidden}
  .btn-dss-dark{background:#0f172a;color:#fff;border-radius:10px;font-size:13px;padding:9px 16px}
  .table-scroll-container{max-height:420px;overflow-y:auto;position:relative}
  .dss-table thead th{position:sticky;top:0;z-index:10;background:#f8fafc!important;border-bottom:1px solid #e2e8f0;padding:12px 14px;font-size:10.5px;white-space:nowrap}
  .dss-table tbody td{font-size:13px;padding:12px 14px;border-bottom:1px solid #f1f5f9}

  @@media print{
    body *{visibility:hidden}
    .dss-table-card, .dss-table-card *{visibility:visible}
    .dss-table-card{position:absolute;left:0;top:0;width:100%;border:none;overflow:visible!important}
    .table-scroll-container{max-height:none!important;overflow:visible!important;height:auto!important}
    .dss-table thead th{position:static!important}
    .dss-kpi-card,.dss-toolbar .btn,.form-select{display:none!important}
  }
</style>

<h4 class="fw-bold mb-3">User Master</h4>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Total Users</div>
                <div class="dss-kpi-value">@Model.TotalRecords</div>
            </div>
            <div class="dss-kpi-icon" style="background:#f59e0b;"><i class="bi bi-people-fill"></i></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Active Users</div>
                <div class="dss-kpi-value">@(Model.Rows.Count(r => r.ContainsKey("IsActive") && r["IsActive"]!=null && Convert.ToBoolean(r["IsActive"])))</div>
            </div>
            <div class="dss-kpi-icon" style="background:#ef4444;"><i class="bi bi-person-check-fill"></i></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Inactive Users</div>
                <div class="dss-kpi-value">@(Model.Rows.Count(r => r.ContainsKey("IsActive") && r["IsActive"]!=null && !Convert.ToBoolean(r["IsActive"])))</div>
            </div>
            <div class="dss-kpi-icon" style="background:#10b981;"><i class="bi bi-person-x-fill"></i></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Roles</div>
                <div class="dss-kpi-value">@(Model.Rows.Where(r=>r.ContainsKey("Role")&&r["Role"]!=null).Select(r=>r["Role"]?.ToString()).Where(s=>!string.IsNullOrWhiteSpace(s)).Distinct().Count())</div>
            </div>
            <div class="dss-kpi-icon" style="background:#8b5cf6;"><i class="bi bi-shield-check"></i></div>
        </div>
    </div>
</div>

<div class="dss-toolbar mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <div class="dss-toolbar-label">Search User / Role / Mobile</div>
            <div class="position-relative">
                <i class="bi bi-search position-absolute" style="left:12px; top:50%; transform:translateY(-50%); color:#94a3b8;"></i>
                <input type="text" id="userSearch" value="@Model.SearchTerm" class="form-control dss-search-input ps-5" placeholder="Search user..." autocomplete="off" />
            </div>
        </div>
        <div class="col-md-7 d-flex gap-2 justify-content-end align-items-center">
            <button id="clearUserFilter" class="btn btn-light border" style="border-radius:10px; font-size:13px;">Clear</button>
            <div class="btn-group">
                <a id="userExportExcel" href="/User/ExportExcel" class="btn btn-light border" style="font-size:13px; border-radius:10px 0 0 10px;"><i class="bi bi-file-earmark-excel me-1"></i> Excel</a>
                <a href="javascript:void(0);" onclick="exportUserCsv();" class="btn btn-light border" style="font-size:13px;"><i class="bi bi-filetype-csv me-1"></i> CSV</a>
                <a href="javascript:void(0);" onclick="printUserTable();" class="btn btn-light border" style="font-size:13px; border-radius:0 10px 10px 0;"><i class="bi bi-printer me-1"></i> Print</a>
            </div>
            <a href="/User/Create" class="btn btn-dss-dark ms-2"><i class="bi bi-plus-circle me-1"></i> Add User</a>
        </div>
    </div>
</div>

<div class="dss-table-card"><div id="userTable">@await Html.PartialAsync("_UserTable", Model)</div></div>
<script>
    window.__userNav = window.__userNav || {};

    function buildUrl(page = 1) {
        const p = new URLSearchParams();
        const searchInput = document.getElementById("userSearch");
        const term = searchInput ? searchInput.value.trim() : "";
        if (term) p.append("search", term);
        p.append("page", page);
        p.append("pageSize", document.getElementById("visitPageSize")?.value || document.getElementById("userPageSize")?.value || 10);
        return "/User?" + p.toString();
    }

    // CLIENT VISIT JAISE HI EXPORT URL UPDATE HOGA
    function updateExportUrl() {
        const p = new URLSearchParams();
        const searchInput = document.getElementById("userSearch");
        const term = searchInput ? searchInput.value.trim() : "";
        if (term) p.append("search", term);
        const exportExcel = document.getElementById("userExportExcel");
        if (exportExcel) exportExcel.href = "/User/ExportExcel?" + p.toString();
    }

    function loadUserTable(url) {
        fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(r => { if (!r.ok) throw new Error(); return r.text(); })
        .then(html => {
            const userTable = document.getElementById("userTable");
            if (userTable) userTable.innerHTML = html;
            updateExportUrl();
        })
        .catch(e => console.error(e));
    }

    // SORT + PAGINATION + PAGE SIZE - sirf ek baar register (AJAX nav safe)
    if (!window.__userNav.delegates) {
        window.__userNav.delegates = true;

        document.addEventListener("click", function (e) {
            if (e.__ajaxNavHandled) return;
            const link = e.target.closest(".ajax-table-link");
            if (!link) return;
            e.preventDefault();
            e.__ajaxNavHandled = true;
            loadUserTable(link.href);
        });

        document.addEventListener("change", function (e) {
            if (e.__ajaxNavHandled) return;
            if (e.target.id !== "userPageSize" && e.target.id !== "visitPageSize") return;
            e.__ajaxNavHandled = true;
            loadUserTable(buildUrl(1));
        });
    }

    var searchInput = document.getElementById("userSearch");
    if (searchInput) {
        searchInput.addEventListener("keyup", function () {
            loadUserTable(buildUrl(1));
        });
    }

    var clearUserFilter = document.getElementById("clearUserFilter");
    if (clearUserFilter) {
        clearUserFilter.addEventListener("click", function () {
            if (searchInput) searchInput.value = "";
            loadUserTable(buildUrl(1));
            updateExportUrl();
        });
    }

    // CLIENT VISIT WALA CSV LOGIC
    function exportUserCsv() {
        const p = new URLSearchParams();
        const searchInput = document.getElementById("userSearch");
        const term = searchInput ? searchInput.value.trim() : "";
        if (term) p.append("search", term);
        window.location.href = "/User/ExportCsv?" + p.toString();
    }

    // CLIENT VISIT WALA PRINT LOGIC - TERA PEHLE WALA
    function printUserTable() {
        window.print();
    }

    updateExportUrl();
</script>