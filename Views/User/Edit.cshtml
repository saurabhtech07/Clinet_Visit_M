@model List<ClientVisitManagement.Models.DynamicField>

@{
    var row = (Dictionary<string, object?>)ViewBag.RowData;

var roles = ViewBag.Roles as List<ClientVisitManagement.Models.Role>
    ?? new List<ClientVisitManagement.Models.Role>();
}

<h4 class="mb-3">Edit User</h4>

<form method="post" action="/User/Edit/@ViewBag.UserId">
    @Html.AntiForgeryToken()

    <input type="hidden"
           name="UserId"
           value="@ViewBag.UserId" />

    <div class="card-section">

        <h6>User Information</h6>

        <div class="row g-3">

            @foreach (var f in Model)
            {
                if (f.Name.Equals("UserId", StringComparison.OrdinalIgnoreCase) ||
                    f.Name.Equals("CreatedDate", StringComparison.OrdinalIgnoreCase) ||
                    f.Name.Equals("RoleName", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                var value = row.ContainsKey(f.Name)
                    ? row[f.Name]?.ToString()
                    : "";

                <div class="col-md-6">

                    <label class="form-label">
                        @f.Name
                        @if (!f.IsNullable)
                        {
                            <span> *</span>
                        }
                    </label>

                    @* ROLE *@
                    @if (f.Name.Equals("RoleId", StringComparison.OrdinalIgnoreCase))
                    {
                        <select name="RoleId"
                                class="form-select"
                                required>

                            <option value="">Select Role</option>

                          @foreach (var role in roles)
{
    var roleId = role.RoleId.ToString();

    if (roleId == value)
    {
        <option value="@roleId" selected>
            @role.RoleName
        </option>
    }
    else
    {
        <option value="@roleId">
            @role.RoleName
        </option>
    }
}

                        </select>
                    }

                    @* ACTIVE / INACTIVE *@
                    else if (f.Name.Equals("IsActive", StringComparison.OrdinalIgnoreCase))
                    {
                        var isActive =
                            value == "True" ||
                            value == "true" ||
                            value == "1";

                        <select name="IsActive"
                                class="form-select">

                            @if (isActive)
                            {
                                <option value="1" selected>Active</option>
                                <option value="0">Inactive</option>
                            }
                            else
                            {
                                <option value="1">Active</option>
                                <option value="0" selected>Inactive</option>
                            }

                        </select>
                    }

                    @* PASSWORD *@
                    else if (f.Name.Equals("PasswordHash", StringComparison.OrdinalIgnoreCase))
                    {
                        <input type="password"
                               name="PasswordHash"
                               class="form-control"
                               placeholder="Leave blank to keep current password"
                               autocomplete="new-password" />
                    }

                    @* OTHER DYNAMIC FIELDS *@
                    else
                    {
                        var type =
                            f.DataType.Contains("int", StringComparison.OrdinalIgnoreCase)
                                ? "number"
                                : f.DataType.Contains("date", StringComparison.OrdinalIgnoreCase)
                                    ? "date"
                                    : "text";

                        <input name="@f.Name"
                               type="@type"
                               value="@value"
                               class="form-control"
                               @(f.IsNullable ? "" : "required") />
                    }

                </div>
            }

        </div>

    </div>

    <div class="text-end mt-4">

        <a href="/User"
           class="btn btn-light border">
            Back
        </a>

        <button type="reset"
                class="btn btn-light border">
            Reset
        </button>

        <button type="submit"
                class="btn btn-primary">
            Update User
        </button>

    </div>

</form>