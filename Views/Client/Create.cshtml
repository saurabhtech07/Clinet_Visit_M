@using Microsoft.AspNetCore.Html
@model List<DynamicField>
@{
    var states = ((DynamicTableViewModel)ViewBag.States).Rows;
    var companyTypes = ((DynamicTableViewModel)ViewBag.CompanyTypes).Rows;
    var users = ViewBag.Users as List<User> ?? new List<User>();

    var companyFields = new[] { "ClientName", "Address1", "Address2", "City", "StateId", "Pincode" };
    var contactFields = new[] { "ContactPerson", "LandlineNo", "MobileNo", "Email" };
    var businessFields = new[] { "CompanyTypeId", "AssignedTo" };

    // FIX: Jo bhi naya column (GSTNo, PANNo, Website) add hoga wo is list me khud ayega
    var otherFields = Model.Where(f =>
       !companyFields.Contains(f.Name) &&
       !contactFields.Contains(f.Name) &&
       !businessFields.Contains(f.Name) &&
        f.Name!= "ClientId" && f.Name!= "CreatedOn" && f.Name!= "CompanyType"
    ).ToList();

    IHtmlContent RenderField(DynamicField f)
    {
        var label = $"<label class=\"form-label\">{(f.Name == "CompanyTypeId"? "Company Type" : f.Name == "StateId"? "State" : f.Name == "AssignedTo"? "Assigned To" : f.Name == "ContactPerson"? "Contact Person" : f.Name)}{(f.IsNullable? "" : " *")}</label>";
        string input;
        if (f.Name == "StateId")
        {
            var opts = string.Join("", states.Select(s => $"<option value=\"{s["StateId"]}\">{s["StateName"]}</option>"));
            input = $@"<select class=""form-select form-select-sm"" name=""StateId"" required><option value="""">Select State</option>{opts}</select>";
        }
        else if (f.Name == "CompanyTypeId")
        {
            var opts = string.Join("", companyTypes.Select(s => $"<option value=\"{s["Id"]}\">{s["Name"]}</option>"));
            input = $@"<select class=""form-select form-select-sm"" name=""CompanyTypeId"" required><option value="""">Select Company Type</option>{opts}</select>";
        }
        else if (f.Name == "AssignedTo")
        {
            var opts = string.Join("", users.Select(u => {
                var nm = System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName);
                return $"<option value=\"{u.UserId}\">{nm}</option>";
            }));
            input = $@"<select class=""form-select form-select-sm"" name=""AssignedTo""><option value="""">Unassigned</option>{opts}</select>";
        }
        else
        {
            var type = f.DataType.Contains("int")? "number" : f.DataType.Contains("date")? "date" : "text";
            var req = f.IsNullable? "" : "required";
            input = $@"<input class=""form-control form-control-sm"" name=""{f.Name}"" type=""{type}"" {req} placeholder=""Enter {f.Name}"" />";
        }
        return new HtmlString($"<div class='mb-2'>{label}{input}</div>");
    }
}

<style>
    #clientForm h6{font-size:11px;font-weight:800;color:#0f172a;text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid #eef2f7;padding-bottom:5px;margin-bottom:8px}
    #clientForm .form-label{font-size:11px;font-weight:700;color:#334155;margin-bottom:2px}
    #clientForm .form-control,#clientForm .form-select{height:30px;font-size:12.5px;border-radius:8px;background:#f8fafc;border:1px solid #e2e8f0}
    #clientForm .form-control:focus,#clientForm .form-select:focus{background:#fff;border-color:#94a3b8;box-shadow:0 0 0 3px rgba(37,99,235,.08)}
    #clientForm .row{--bs-gutter-x:.6rem;--bs-gutter-y:.6rem}
    #clientForm [class*="col-"]{min-width:0}
    #clientForm .card-section{border:1px solid #eef2f7!important;background:#fff}
</style>

<div class="d-flex align-items-center gap-2 mb-2">
    <a href="/Client" class="btn btn-light border btn-sm px-3" onclick="event.preventDefault(); window.loadPage('/Client');">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
    <h4 class="fw-bold mb-0" style="font-size:16px;">Create New Client</h4>
</div>
<form method="post" id="clientForm">
    @Html.AntiForgeryToken()
    <div class="row g-2 align-items-stretch">
        <div class="col-md-6 d-flex">
            <div class="card-section w-100 p-3 border rounded bg-white">
                <h6>Company Information</h6>
                @foreach (var f in Model.Where(f => companyFields.Contains(f.Name))) { @RenderField(f) }
            </div>
        </div>
        <div class="col-md-6 d-flex flex-column gap-2">
            <div class="card-section w-100 p-3 border rounded bg-white">
                <h6>Contact Information</h6>
                @foreach (var f in Model.Where(f => contactFields.Contains(f.Name))) { @RenderField(f) }
            </div>
                <div class="card-section w-100 p-3 border rounded bg-white">
                    <h6>Business Information</h6>
                    @foreach (var f in Model.Where(f => businessFields.Contains(f.Name))) { @RenderField(f) }

                    @if(otherFields.Any())
                    {
                        <hr />
                        <h6>Additional Information - Auto Added</h6>
                        @foreach (var f in otherFields) { @RenderField(f) }
                    }
                </div>
            </div>
        </div>
    <div class="text-end mt-2">
        <button type="reset" class="btn btn-light border">Reset</button>
        <button type="submit" class="btn btn-primary">Save &amp; Continue</button>
    </div>
</form>

<script>
    (function () {
        var form = document.getElementById("clientForm");
        if (!form) return;
        form.addEventListener("submit", function (e) {
            e.preventDefault();
            Ajax.submit({
                url: "/Client/Create",
                form: form,
                onSuccess: function (data) {
                    if (window.loadPage) window.loadPage("/ClientVisit/Create?clientId=" + data.id, "Add Visit");
                    else window.location.href = "/ClientVisit/Create?clientId=" + data.id;
                }
            });
        });
    })();
</script>