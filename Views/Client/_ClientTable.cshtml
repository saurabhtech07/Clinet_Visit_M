@model ClientVisitManagement.Models.DynamicTableViewModel
@{
    int start = Model.TotalRecords == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int end = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords);
    int sr = start;
}

<style>
  /* Grid ke andar hi scroll (Daily Support / Client Visit jaisa) */
  .table-scroll-container { position: relative; max-height: 58vh; overflow: auto; }
  .dss-table thead th {
        position: sticky; top: 0; z-index: 10;
        font-size: 10px; font-weight: 700; letter-spacing: 0.3px;
        color: #64748b; text-transform: uppercase;
        background: #f8fafc !important;
        border-bottom: 1px solid #e2e8f0;
        padding: 7px 8px; white-space: normal; line-height: 1.15;
        box-shadow: 0 1px 0 #e2e8f0;
    }
  .dss-table tbody td {
        font-size: 12.5px; padding: 5px 8px;
        border-bottom: 1px solid #f1f5f9; vertical-align: middle;
        background: #fff; overflow: hidden;
    }
  .client-grid-table { border-collapse: separate; border-spacing: 0; width: 100%; }
  .cell-clip { display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }
  .client-id-pill { background: #1e293b; color: #fff; padding: 2px 7px; border-radius: 6px; font-size: 10px; font-weight: 600; }
  .action-edit, .action-delete {
        width: 24px; height: 24px;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 7px; font-size: 12px; transition: all 0.2s;
    }
  .action-edit { border: 1px solid #dbeafe; background: #eff6ff; color: #2563eb !important; }
  .action-edit:hover { background: #2563eb; color: #fff !important; }
  .action-delete { border: 1px solid #fee2e2; background: #fef2f2; color: #dc2626 !important; margin-left: 5px; }
  .action-delete:hover { background: #dc2626; color: #fff !important; }
  .dss-table tbody td.actions-cell { white-space: nowrap; }
  .table-sort-link { color: #475569 !important; text-decoration: none; }
  .table-sort-link:hover { color: #0f172a !important; }
  .sort-neutral { opacity: 0.4; }
</style>

<div class="table-scroll-container">
    <table class="table mb-0 dss-table table-hover client-grid-table">
        <thead>
            <tr>
                <th style="width:44px;">Sr.No</th>
                <th>
                    @{
                        var clientIdDirection = Model.SortColumn == "ClientId" && Model.SortDirection == "ASC" ? "DESC" : "ASC";
                    }
                    <a class="table-sort-link ajax-client-link text-decoration-none" href="/Client?page=1&pageSize=@Model.PageSize&search=@Uri.EscapeDataString(Model.SearchTerm ?? "")&sort=ClientId&direction=@clientIdDirection">
                        ClientId
                        @if (Model.SortColumn == "ClientId")
                        {
                            <i class="bi @(Model.SortDirection == "ASC" ? "bi-arrow-up" : "bi-arrow-down") ms-1"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up ms-1" style="opacity:0.3; font-size:11px;"></i>
                        }
                    </a>
                </th>
                <th>
                    @{
                        var clientNameDirection = Model.SortColumn == "ClientName" && Model.SortDirection == "ASC" ? "DESC" : "ASC";
                    }
                    <a class="table-sort-link ajax-client-link text-decoration-none" href="/Client?page=1&pageSize=@Model.PageSize&search=@Uri.EscapeDataString(Model.SearchTerm ?? "")&sort=ClientName&direction=@clientNameDirection">
                        Client Name
                        @if (Model.SortColumn == "ClientName")
                        {
                            <i class="bi @(Model.SortDirection == "ASC" ? "bi-arrow-up" : "bi-arrow-down") ms-1"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up ms-1" style="opacity:0.3; font-size:11px;"></i>
                        }
                    </a>
                </th>
                <th>Contact Person</th>
                <th>City</th>
                <th>
                    @{
                        var stateDirection = Model.SortColumn == "StateName" && Model.SortDirection == "ASC" ? "DESC" : "ASC";
                    }
                    <a class="table-sort-link ajax-client-link text-decoration-none" href="/Client?page=1&pageSize=@Model.PageSize&search=@Uri.EscapeDataString(Model.SearchTerm ?? "")&sort=StateName&direction=@stateDirection">
                        State Name
                        @if (Model.SortColumn == "StateName")
                        {
                            <i class="bi @(Model.SortDirection == "ASC" ? "bi-arrow-up" : "bi-arrow-down") ms-1"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up ms-1" style="opacity:0.3; font-size:11px;"></i>
                        }
                    </a>
                </th>
                <th>Pincode</th>
                <th>Mobile</th>
                <th>Email</th>
                <th>Assigned To</th>
                <th class="actions-col" style="width:78px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows.Any())
            {
                foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="serial-col" style="color:#64748b;">@sr</td>
                        <td><span class="client-id-pill">@(row.ContainsKey("ClientId") ? row["ClientId"] : "")</span></td>
                        <td class="fw-semibold" style="color:#0f172a;"><span class="cell-clip">@(row.ContainsKey("ClientName") ? row["ClientName"] : "")</span></td>
                        <td><span class="cell-clip">@(row.ContainsKey("ContactPerson") ? row["ContactPerson"] : "")</span></td>
                        <td><span class="cell-clip">@(row.ContainsKey("City") ? row["City"] : "")</span></td>
                        @* State match nahi hua (StateId NULL) to "Unknown" dikhao - khali cell nahi *@
                        <td><span class="cell-clip">@(row.ContainsKey("StateName") && !string.IsNullOrWhiteSpace(row["StateName"]?.ToString()) ? row["StateName"]?.ToString() : "Unknown")</span></td>
                        <td><span class="cell-clip">@(row.ContainsKey("Pincode") ? row["Pincode"] : "")</span></td>
                        <td class="fw-medium"><span class="cell-clip">@(row.ContainsKey("MobileNo") ? row["MobileNo"] : "")</span></td>
                        <td style="color:#64748b;"><span class="cell-clip">@(row.ContainsKey("Email") ? row["Email"] : "")</span></td>
                        <td><span class="cell-clip">@(row.ContainsKey("AssignedToName") && row["AssignedToName"] != null ? row["AssignedToName"] : "—")</span></td>
                        <td class="actions-cell">
                            @if (row.ContainsKey("ClientId"))
                            {
                                <a href="/Client/Edit/@row["ClientId"]" title="Edit" class="action-edit" data-no-modal onclick="event.preventDefault(); window.loadPage('/Client/Edit/@row["ClientId"]', 'Edit Client');"><i class="bi bi-pencil"></i></a>
                                <a href="/Client/Delete/@row["ClientId"]" title="Delete" class="action-delete ajax-delete"
                                   data-confirm="Delete this client and ALL its related visits, follow-ups and support tickets? This cannot be undone."><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                    sr++;
                }
            }
            else
            {
                <tr><td colspan="11" class="text-center text-muted py-5">No clients found</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- FOOTER - User Master jaisa (scroll nahi hoga) -->
<div class="d-flex justify-content-between align-items-center p-2 border-top bg-white" style="border-radius:0 0 14px 14px;">
    <div class="d-flex align-items-center gap-2">
        <select id="clientPageSize" class="form-select form-select-sm" style="width:70px; border-radius:8px;">
            <option value="10" selected="@(Model.PageSize == 10)">10</option>
            <option value="20" selected="@(Model.PageSize == 20)">20</option>
            <option value="50" selected="@(Model.PageSize == 50)">50</option>
            <option value="100" selected="@(Model.PageSize == 100)">100</option>
        </select>
        <span style="font-size:12px; color:#64748b;">records per page</span>
    </div>
    <div style="font-size:12px; color:#64748b;">Showing @start to @end of @Model.TotalRecords entries</div>
    <div class="d-flex gap-1">
        @if (Model.CurrentPage > 1) { <a class="btn btn-sm btn-light border ajax-client-link" href="/Client?page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize&search=@Uri.EscapeDataString(Model.SearchTerm ?? "")&sort=@Uri.EscapeDataString(Model.SortColumn ?? "")&direction=@Model.SortDirection">Previous</a> }
        else { <button class="btn btn-sm btn-light border" disabled>Previous</button> }
        @if (Model.CurrentPage < Model.TotalPages) { <a class="btn btn-sm btn-light border ajax-client-link" href="/Client?page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize&search=@Uri.EscapeDataString(Model.SearchTerm ?? "")&sort=@Uri.EscapeDataString(Model.SortColumn ?? "")&direction=@Model.SortDirection">Next</a> }
        else { <button class="btn btn-sm btn-light border" disabled>Next</button> }
    </div>
</div>