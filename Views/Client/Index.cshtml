<div class="dss-table-card" id="printArea"><div id="clientTable">@await Html.PartialAsync("_ClientTable", Model.Clients)</div></div>

<script>
    let clientSearchTimer;
    const clientSearch = document.getElementById("clientSearch");
    const clientTable = document.getElementById("clientTable");
    const exportExcel = document.getElementById("clientExportExcel");

    function buildUrl(page=1){
        const p=new URLSearchParams();
        const term=clientSearch.value.trim();
        if(term) p.append("search",term);
        p.append("page",page);
        p.append("pageSize",document.getElementById("clientPageSize")?.value || 10);
        return "/Client?"+p.toString();
    }
    function updateExportUrl(){
        const p=new URLSearchParams();
        const term=clientSearch.value.trim();
        if(term) p.append("search",term);
        exportExcel.href="/Client/ExportExcel?"+p.toString();
    }
    function loadClientTable(url){
        fetch(url,{headers:{"X-Requested-With":"XMLHttpRequest"}})
        .then(r=>{if(!r.ok)throw new Error(); return r.text();})
        .then(html=>{clientTable.innerHTML=html; updateExportUrl();})
        .catch(e=>console.error(e));
    }
    function printClientTable() {
        var printContents = document.getElementById("printArea").innerHTML;
        var printWindow = window.open('', '', 'height=600,width=800');
        printWindow.document.write('<html><head><title>Client List - Print</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{padding:20px} table{width:100% !important} .btn, .pagination, .form-select{display:none !important}</style></head><body><h4 style="margin-bottom:15px">Client Master - Print</h4>'+printContents+'</body></html>');
        printWindow.document.close(); printWindow.focus();
        setTimeout(function(){printWindow.print(); printWindow.close();},500);
    }
    function exportClientCsv(){
        const p=new URLSearchParams(); const term=clientSearch.value.trim();
        if(term) p.append("search",term);
        window.location.href="/Client/ExportCsv?"+p.toString();
    }
    clientSearch.addEventListener("input",function(){clearTimeout(clientSearchTimer); clientSearchTimer=setTimeout(()=>{loadClientTable(buildUrl(1));},300);});
    document.getElementById("clearClientFilter").addEventListener("click",function(){clientSearch.value=""; loadClientTable(buildUrl(1)); updateExportUrl();});
    document.addEventListener("click",function(e){const link=e.target.closest(".ajax-client-link"); if(!link) return; e.preventDefault(); loadClientTable(link.href);});
    document.addEventListener("change",function(e){if(e.target.id!=="clientPageSize") return; loadClientTable(buildUrl(1));});
    updateExportUrl();
</script> *@