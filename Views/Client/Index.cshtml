@model ClientVisitManagement.Models.ClientDashboardViewModel
@{
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}

<style>
    .dss-kpi-card{background:#fff;border-radius:10px;border:1px solid #eef2f7;padding:8px 12px;height:60px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 1px 2px rgba(0,0,0,0.04)}
    .dss-kpi-label{font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;margin-bottom:1px;letter-spacing:0.4px}
    .dss-kpi-value{font-size:18px;font-weight:800;color:#0f172a;line-height:1}
    .dss-kpi-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;flex-shrink:0}
    .dss-toolbar{background:#fff;border-radius:12px;border:1px solid #eef2f7;padding:10px 12px}
    .dss-table-card{background:#fff;border-radius:14px;border:1px solid #eef2f7;overflow:hidden}
    .btn-dss-dark{background:#0f172a;color:#fff;border-radius:10px;font-size:13px;padding:9px 16px}
    .leads-search{position:relative}
    .leads-search i{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:13px}
    .leads-input{height:32px;font-size:12.5px;border-radius:9px;background:#f8fafc;border:1px solid #e2e8f0;padding-top:4px;padding-bottom:4px}
    .leads-search input{padding-left:30px}
</style>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="fw-bold mb-0">Client Master</h4>
    <a href="/Client/Create" class="btn btn-dss-dark"><i class="bi bi-plus-circle me-1"></i> Add Client</a>
</div>

<!-- KPI CARDS -->
<div class="row g-2 mb-2">
    <div class="col-6 col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Total Clients</div>
                <div class="dss-kpi-value">@Model.TotalClients</div>
            </div>
            <div class="dss-kpi-icon" style="background:#f59e0b;"><i class="bi bi-people-fill"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Active Clients</div>
                <div class="dss-kpi-value">@Model.ActiveClients</div>
            </div>
            <div class="dss-kpi-icon" style="background:#ef4444;"><i class="bi bi-person-check-fill"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Visits Scheduled</div>
                <div class="dss-kpi-value">@Model.ThisMonthVisits</div>
            </div>
            <div class="dss-kpi-icon" style="background:#10b981;"><i class="bi bi-person-plus-fill"></i></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dss-kpi-card">
            <div>
                <div class="dss-kpi-label">Total Visits</div>
                <div class="dss-kpi-value">@Model.TotalVisits</div>
            </div>
            <div class="dss-kpi-icon" style="background:#8b5cf6;"><i class="bi bi-shield-check"></i></div>
        </div>
    </div>
</div>

<!-- FILTER TOOLBAR (compact single row) -->
<div class="dss-toolbar mb-2">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="leads-search" style="flex:1 1 220px; min-width:180px;">
            <i class="bi bi-search"></i>
            <input type="text" id="clientSearch" value="@Model.Clients.SearchTerm" class="form-control leads-input" placeholder="Search client / city / mobile..." autocomplete="off" />
        </div>

        <button id="clearClientSearch" class="btn btn-light border" style="border-radius:9px; font-size:12.5px; height:32px;">
            <i class="bi bi-x-circle me-1"></i>Clear
        </button>

        <div class="dropdown ms-auto">
            <button class="btn btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                    style="border-radius:9px; font-size:12.5px; height:32px;">
                <i class="bi bi-download me-1"></i> Export
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a id="clientExportExcel" class="dropdown-item" href="/Client/ExportExcel"><i class="bi bi-file-earmark-excel me-2 text-success"></i>Excel</a></li>
                <li><a id="clientExportCsv" class="dropdown-item" href="/Client/ExportCsv"><i class="bi bi-filetype-csv me-2 text-primary"></i>CSV</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="javascript:void(0);" onclick="window.printTable('clientTable','Client Master');"><i class="bi bi-printer me-2"></i>Print</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- TABLE - User Master jaisa -->
<div class="dss-table-card">
    <div id="clientTable">
        @await Html.PartialAsync("_ClientTable", Model.Clients)
    </div>
</div>


<script>
    window.__clientNav = window.__clientNav || {};

    function buildClientUrl(page) {
        const p = new URLSearchParams();
        p.append("page", page);
        p.append("pageSize", document.getElementById("clientPageSize")?.value || 10);
        const s = document.getElementById("clientSearch");
        if (s && s.value.trim()) p.append("search", s.value.trim());
        return "/Client?" + p.toString();
    }

    function updateClientExport() {
        const s = document.getElementById("clientSearch");
        const q = s && s.value.trim() ? "?search=" + encodeURIComponent(s.value.trim()) : "";
        const ex = document.getElementById("clientExportExcel");
        const cs = document.getElementById("clientExportCsv");
        if (ex) ex.href = "/Client/ExportExcel" + q;
        if (cs) cs.href = "/Client/ExportCsv" + q;
    }

    function loadClientTable(url) {
        fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
            .then(response => {
                if (!response.ok) throw new Error("Failed to load clients.");
                return response.text();
            })
            .then(html => {
                const table = document.getElementById("clientTable");
                if (table) table.innerHTML = html;
                updateClientExport();
            })
            .catch(error => {
                console.error("Client table error:", error);
            });
    }

    // Delete ke baad table refresh (ajax-helper ise call karta hai)
    window.refreshCurrentTable = function () { loadClientTable(buildClientUrl(1)); };

    // SORT + PAGINATION + PAGE SIZE - sirf ek baar register (AJAX nav safe)
    if (!window.__clientNav.delegates) {
        window.__clientNav.delegates = true;

        document.addEventListener("click", function (event) {
            if (event.__ajaxNavHandled) return;
            const link = event.target.closest(".ajax-client-link");
            if (!link) return;
            event.preventDefault();
            event.__ajaxNavHandled = true;
            loadClientTable(link.href);
        });

        document.addEventListener("change", function (event) {
            if (event.__ajaxNavHandled) return;
            if (event.target.id !== "clientPageSize") return;
            event.__ajaxNavHandled = true;
            loadClientTable(buildClientUrl(1));
        });
    }

    // LIVE SEARCH (debounced)
    var clientSearchTimer = null;
    var clientSearch = document.getElementById("clientSearch");
    if (clientSearch) {
        clientSearch.addEventListener("input", function () {
            clearTimeout(clientSearchTimer);
            clientSearchTimer = setTimeout(function () { loadClientTable(buildClientUrl(1)); }, 300);
        });
    }

    // CLEAR SEARCH
    var clearClientSearch = document.getElementById("clearClientSearch");
    if (clearClientSearch) {
        clearClientSearch.addEventListener("click", function () {
            if (clientSearch) clientSearch.value = "";
            loadClientTable(buildClientUrl(1));
        });
    }

    updateClientExport();
</script>

