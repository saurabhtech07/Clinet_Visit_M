@using Microsoft.AspNetCore.Html
@model List<DynamicField>
@{
    var row = (Dictionary<string, object?>)ViewBag.RowData;
    var leadId = ViewBag.LeadId;
    var states = ((DynamicTableViewModel)ViewBag.States).Rows;
    var users = ViewBag.Users as List<User> ?? new List<User>();
    var statusOptions = ViewBag.StatusOptions as string[] ?? new string[0];
    var priorityOptions = ViewBag.PriorityOptions as string[] ?? new string[0];
    var sourceOptions = ViewBag.SourceOptions as string[] ?? new string[0];
    var clients = ViewBag.Clients as List<Client> ?? new List<Client>();

    bool isConverted = row.ContainsKey("IsConverted") && row["IsConverted"] != null && Convert.ToBoolean(row["IsConverted"]);
    var convertedClientId = row.ContainsKey("ConvertedClientId") && row["ConvertedClientId"] != null ? row["ConvertedClientId"]?.ToString() : null;

    var mainFields = new[] { "LeadPerson", "Company", "Mobile", "Email", "City", "StateId" };
    var statusFields = new[] { "Status", "Priority", "LeadSource", "DealValue", "AssignedTo", "NextFollowUpDate" };
    var requirementFields = new[] { "Requirement" };

    // These columns are auto-filled -> they are not shown in the form
    var autoFields = new[] { "CreatedOn", "EntryTime", "IsConverted", "ConvertedClientId", "ConvertedOn", "ClientId" };

    var otherFields = Model.Where(f =>
        !mainFields.Contains(f.Name) &&
        !statusFields.Contains(f.Name) &&
        !requirementFields.Contains(f.Name) &&
        !autoFields.Contains(f.Name)).ToList();

    string Label(string name) => name switch
    {
        "LeadPerson" => "Lead Person",
        "StateId" => "State",
        "DealValue" => "Deal Value",
        "AssignedTo" => "Assigned To",
        _ => System.Text.RegularExpressions.Regex.Replace(name, "([a-z])([A-Z])", "$1 $2")
    };

    string Enc(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");

    IHtmlContent RenderField(DynamicField f, string colClass)
    {
        var raw = row.ContainsKey(f.Name) ? row[f.Name] : null;
        var v = raw is DateTime dt ? dt.ToString("yyyy-MM-ddTHH:mm") : raw?.ToString() ?? "";
        var star = f.IsNullable ? "" : " *";
        var label = $"<label class=\"form-label mb-1\">{Label(f.Name)}{star}</label>";
        string input;

        if (f.Name == "Company")
        {
            // Searchable dropdown from the Company (Client) master. Older leads may not
            // have a ClientId, so we match by Company name and preselect it.
            var curClientId = row.ContainsKey("ClientId") ? row["ClientId"]?.ToString() : null;
            var curName = raw?.ToString();
            if (string.IsNullOrEmpty(curClientId) && !string.IsNullOrEmpty(curName))
            {
                var m = clients.FirstOrDefault(c => string.Equals(c.ClientName, curName, StringComparison.OrdinalIgnoreCase));
                if (m != null) curClientId = m.ClientId.ToString();
            }
            var opts = string.Join("", clients.Select(c =>
            {
                var id = c.ClientId.ToString();
                var sel = id == curClientId ? " selected" : "";
                return $"<option value=\"{id}\"{sel} data-name=\"{Enc(c.ClientName)}\" data-city=\"{Enc(c.City)}\" data-state=\"{c.StateId}\" data-mobile=\"{Enc(c.MobileNo)}\">{Enc(c.ClientName)}</option>";
            }));
            input = $@"<select class=""form-select"" id=""leadCompanySelect"" name=""ClientId"" data-searchable data-add-new data-add-new-label=""+ Add New Company"" data-placeholder=""Search company...""><option value="""">Select Company</option>{opts}</select>" +
                    $@"<input type=""hidden"" name=""Company"" id=""leadCompanyName"" value=""{Enc(curName)}"" />";
        }
        else if (f.Name == "StateId")
        {
            var cur = raw?.ToString();
            var opts = string.Join("", states.Select(s =>
            {
                var id = s["StateId"]?.ToString();
                var sel = id == cur ? " selected" : "";
                return $"<option value=\"{id}\"{sel}>{s["StateName"]}</option>";
            }));
            input = $@"<select class=""form-select"" name=""StateId""><option value="""">Select State</option>{opts}</select>";
        }
        else if (f.Name == "Status")
        {
            var opts = string.Join("", statusOptions.Select(s =>
            {
                var sel = s == v ? " selected" : "";
                return $"<option value=\"{s}\"{sel}>{s}</option>";
            }));
            input = $@"<select class=""form-select"" name=""Status""><option value="""">Select Status</option>{opts}</select>";
        }
        else if (f.Name == "Priority")
        {
            var opts = string.Join("", priorityOptions.Select(s =>
            {
                var sel = s == v ? " selected" : "";
                return $"<option value=\"{s}\"{sel}>{s}</option>";
            }));
            input = $@"<select class=""form-select"" name=""Priority""><option value="""">Select Priority</option>{opts}</select>";
        }
        else if (f.Name == "LeadSource")
        {
            var opts = string.Join("", sourceOptions.Select(s =>
            {
                var sel = s == v ? " selected" : "";
                return $"<option value=\"{s}\"{sel}>{s}</option>";
            }));
            input = $@"<select class=""form-select"" name=""LeadSource""><option value="""">Select Source</option>{opts}</select>";
        }
        else if (f.Name == "NextFollowUpDate")
        {
            var dv = raw is DateTime dtv ? dtv.ToString("yyyy-MM-dd") : "";
            input = $@"<input class=""form-control"" name=""NextFollowUpDate"" type=""date"" value=""{dv}"" />";
        }
        else if (f.Name == "AssignedTo")
        {
            var opts = string.Join("", users.Select(u =>
            {
                var nm = System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(u.FullName) ? u.Username : u.FullName);
                var sel = u.UserId.ToString() == v ? " selected" : "";
                return $"<option value=\"{u.UserId}\"{sel}>{nm}</option>";
            }));
            input = $@"<select class=""form-select"" name=""AssignedTo""><option value="""">Unassigned</option>{opts}</select>";
        }
        else if (f.Name == "Requirement")
        {
            input = $@"<textarea class=""form-control"" name=""Requirement"" rows=""2"" placeholder=""Enter customer requirement..."">{System.Net.WebUtility.HtmlEncode(v)}</textarea>";
        }
        else
        {
            var type = f.DataType.Contains("decimal") || f.DataType.Contains("money") || f.DataType.Contains("float") ? "number"
                     : f.DataType.Contains("int") ? "number"
                     : f.DataType.Contains("date") || f.DataType.Contains("time") ? "datetime-local"
                     : "text";
            var step = type == "number" ? " step=\"0.01\"" : "";
            var req = f.IsNullable ? "" : "required";
            input = $@"<input class=""form-control"" name=""{f.Name}"" type=""{type}""{step} value=""{System.Net.WebUtility.HtmlEncode(v)}"" {req} />";
        }
        return new HtmlString($"<div class=\"{colClass}\">{label}{input}</div>");
    }
}

<style>
    #leadForm .lf-title{font-size:11px;font-weight:800;color:#0f172a;text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid #eef2f7;padding-bottom:6px;display:flex;align-items:center;gap:7px}
    #leadForm .lf-title i{color:#2563eb}
    #leadForm .form-label{font-size:11.5px;font-weight:700;color:#334155;margin-bottom:2px}
    #leadForm .form-control,#leadForm .form-select{height:34px;font-size:12.5px;border-radius:8px;background:#f8fafc;border:1px solid #e2e8f0;min-width:0}
    #leadForm textarea.form-control{height:auto;min-height:56px}
    #leadForm .form-control:focus,#leadForm .form-select:focus{background:#fff;border-color:#94a3b8;box-shadow:0 0 0 3px rgba(37,99,235,.08)}
    #leadForm .row{--bs-gutter-x:.6rem;--bs-gutter-y:.6rem}
    /* Let the flex columns shrink — otherwise a long label/option forces a horizontal scroll */
    #leadForm [class*="col-"]{min-width:0}
    #leadForm .ss-wrap,#leadForm .ss-input{max-width:100%}
</style>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="fw-bold mb-0">Edit Lead @(leadId != null ? "#" + leadId : "")</h4>
    <div class="d-flex align-items-center gap-2">
        <a href="/Leads/Details/@leadId" class="btn btn-light border btn-sm"><i class="bi bi-clock-history me-1"></i> Activity &amp; Details</a>
        @if (isConverted)
        {
            <span style="padding:5px 12px; border-radius:8px; font-size:12px; font-weight:600; background:#dcfce7; color:#15803d;">
                <i class="bi bi-check2-circle"></i> Converted to Client @(!string.IsNullOrEmpty(convertedClientId) ? "#" + convertedClientId : "")
            </span>
        }
    </div>
</div>

<form method="post" id="leadForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="LeadId" value="@leadId" />
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-3">

            <div class="lf-title"><i class="bi bi-person-badge"></i> Lead Information</div>
            <div class="row g-2 mt-2">
                @foreach (var f in Model.Where(f => mainFields.Contains(f.Name))) { @RenderField(f, "col-md-4") }
            </div>

            <div class="lf-title mt-3"><i class="bi bi-sliders"></i> Pipeline, Priority &amp; Assignment</div>
            <div class="row g-2 mt-2">
                @foreach (var f in Model.Where(f => statusFields.Contains(f.Name))) { @RenderField(f, "col-md-4") }
            </div>

            <div class="lf-title mt-3"><i class="bi bi-card-text"></i> Requirement</div>
            <div class="row g-2 mt-2">
                @foreach (var f in Model.Where(f => requirementFields.Contains(f.Name))) { @RenderField(f, "col-md-12") }
            </div>

            @if (otherFields.Any())
            {
                <div class="lf-title mt-3"><i class="bi bi-plus-square"></i> Additional Information</div>
                <div class="row g-2 mt-2">
                    @foreach (var f in otherFields) { @RenderField(f, "col-md-4") }
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end align-items-center gap-2 mt-3">
        @if (!isConverted)
        {
            <button type="button" id="convertLeadBtn" class="btn btn-success px-4"><i class="bi bi-arrow-left-right me-1"></i> Convert to Client</button>
        }
        else if (!string.IsNullOrEmpty(convertedClientId))
        {
            <a href="/Client/Edit/@convertedClientId" class="btn btn-light border px-4"><i class="bi bi-building me-1"></i> View Client</a>
        }
        <a href="/Leads" class="btn btn-light border px-4">Cancel</a>
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2 me-1"></i> Update Lead</button>
    </div>
</form>

<script>
    if (window.SearchableSelect) { window.SearchableSelect.initAll(document); }

    (function () {
        var form = document.getElementById("leadForm");
        if (form) {
            // ---------- Company -> City/State/Mobile auto-fill ----------
            var companySel = document.getElementById("leadCompanySelect");
            var companyNameEl = document.getElementById("leadCompanyName");

            function setReadonly(name, val) {
                var el = form.querySelector('[name="' + name + '"]');
                if (!el) return;
                el.value = val || "";
                el.readOnly = true;
                el.style.background = "#eef2f7";
            }

            function applyCompany(id) {
                if (!companySel) return;
                var opt = id ? companySel.querySelector('option[value="' + String(id) + '"]') : null;
                if (!opt) { if (companyNameEl) companyNameEl.value = ""; return; }

                if (companyNameEl) companyNameEl.value = opt.getAttribute("data-name") || "";
                setReadonly("City", opt.getAttribute("data-city"));
                setReadonly("Mobile", opt.getAttribute("data-mobile"));

                var st = form.querySelector('[name="StateId"]');
                if (st) {
                    st.value = opt.getAttribute("data-state") || "";
                    st.style.pointerEvents = "none";
                    st.style.background = "#eef2f7";
                }
            }

            if (companySel) {
                companySel.addEventListener("change", function () { applyCompany(this.value); });
                companySel.addEventListener("ss:addnew", function (e) {
                    openQuickCompany(e.detail ? e.detail.query : "");
                });
                // Edit: if a company is already selected, auto-fill it and make it readonly
                if (companySel.value) applyCompany(companySel.value);
            }

            function ensureQuickModal() {
                var el = document.getElementById("quickCompanyModal");
                if (!el) {
                    el = document.createElement("div");
                    el.className = "modal fade";
                    el.id = "quickCompanyModal";
                    el.tabIndex = -1;
                    el.innerHTML = '<div class="modal-dialog modal-dialog-centered">' +
                        '<div class="modal-content" style="border-radius:14px;overflow:hidden;">' +
                        '<div class="modal-header align-items-center"><h6 class="modal-title fw-bold me-auto">Add New Company</h6>' +
                        '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>' +
                        '<div class="modal-body" id="quickCompanyModalBody"></div></div></div>';
                    document.body.appendChild(el);
                }
                return el;
            }

            function openQuickCompany(query) {
                var modalEl = ensureQuickModal();
                var body = modalEl.querySelector("#quickCompanyModalBody");
                body.innerHTML = '<div class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm me-2"></div>Loading\u2026</div>';
                bootstrap.Modal.getOrCreateInstance(modalEl).show();

                fetch("/Client/QuickAdd?name=" + encodeURIComponent(query || ""), { headers: { "X-Requested-With": "XMLHttpRequest" } })
                    .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.text(); })
                    .then(function (html) {
                        body.innerHTML = html;
                        var qf = document.getElementById("quickClientForm");
                        if (qf) {
                            qf.addEventListener("submit", function (ev) {
                                ev.preventDefault();
                                Ajax.submit({
                                    url: "/Client/QuickAdd",
                                    form: qf,
                                    successMessage: "Company added successfully.",
                                    onSuccess: function (d) {
                                        addCompanyOption(d);
                                        bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                                    }
                                });
                            });
                        }
                    })
                    .catch(function () {
                        body.innerHTML = '<div class="text-danger py-3">Could not load the form.</div>';
                    });
            }

            function addCompanyOption(d) {
                if (!companySel || !d || !d.id) return;
                var existing = companySel.querySelector('option[value="' + d.id + '"]');
                if (existing) existing.remove();

                var opt = document.createElement("option");
                opt.value = d.id;
                opt.textContent = d.name || "";
                opt.setAttribute("data-name", d.name || "");
                opt.setAttribute("data-city", d.city || "");
                opt.setAttribute("data-state", (d.stateId !== null && d.stateId !== undefined) ? d.stateId : "");
                opt.setAttribute("data-mobile", d.mobile || "");
                companySel.appendChild(opt);

                companySel.value = d.id;
                if (typeof companySel.__ssSync === "function") companySel.__ssSync();
                applyCompany(d.id);
            }

            form.addEventListener("submit", function (e) {
                e.preventDefault();
                Ajax.submit({
                    url: "/Leads/Edit/@leadId",
                    form: form,
                    successMessage: "Lead updated successfully.",
                    onSuccess: function () { window.loadPage("/Leads"); }
                });
            });
        }

        var cbtn = document.getElementById("convertLeadBtn");
        if (cbtn) {
            cbtn.addEventListener("click", function () {
                if (!confirm("Convert this lead to a Client?")) return;
                cbtn.disabled = true;
                Ajax.post("/Leads/Convert/@leadId", new FormData())
                    .then(function (d) {
                        Ajax.toast(d.message || "Converted to Client.", "success");
                        window.loadPage("/Leads");
                    })
                    .catch(function (e) {
                        cbtn.disabled = false;
                        Ajax.toast(e.message, "error");
                    });
            });
        }
    })();
</script>
