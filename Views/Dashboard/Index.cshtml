@model DashboardViewModel
@{
    // AJAX navigation (sidebar se) ke liye layout hatao
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}

@functions {
    readonly string[] Palette = { "#4f6ef2", "#2ec5ce", "#8b5cf6", "#f59e0b", "#ef4444", "#10b981", "#f9a8d4", "#6366f1" };

    string DonutStyle(IReadOnlyList<NameValue> items, int total)
    {
        if (items == null || items.Count == 0 || total <= 0) return "background:#eef2f7;";
        var sb = new System.Text.StringBuilder();
        sb.Append("background:conic-gradient(");
        double cum = 0;
        for (int i = 0; i < items.Count; i++)
        {
            double pct = items[i].Value / (double)total * 100.0;
            double from = cum; cum += pct;
            sb.Append(Palette[i % Palette.Length]).Append(' ').Append(from.ToString("F1")).Append("% ");
            sb.Append(cum.ToString("F1")).Append("%");
            if (i < items.Count - 1) sb.Append(',');
        }
        sb.Append(");");
        return sb.ToString();
    }

    int BarHeight(int val, int max) => max > 0 ? (int)Math.Round(val / (double)max * 100) : 0;
    int HBarWidth(int val, int max) => max > 0 ? (int)Math.Round(val / (double)max * 100) : 0;
    string Color(int i) => Palette[i % Palette.Length];
    int MaxValue(IReadOnlyList<NameValue> items) => items == null || items.Count == 0 ? 0 : items.Max(x => x.Value);
    int Sum(IReadOnlyList<NameValue> items) => items == null || items.Count == 0 ? 0 : items.Sum(x => x.Value);

    // Donut ke segments ko JSON me do - JS hover pe kaunsa segment hai wo nikalta hai
    string SegmentsJson(IReadOnlyList<NameValue> items, int total)
    {
        if (items == null || items.Count == 0 || total <= 0) return "[]";
        var list = items.Select(x => new
        {
            name = x.Name,
            value = x.Value,
            pct = Math.Round(x.Value / (double)total * 100.0, 2)
        }).ToList();
        return System.Text.Json.JsonSerializer.Serialize(list);
    }

    // Legend / hover ke liye ek line ka text
    string LegendTip(string name, int value, int total)
        => total > 0 ? $"{name} — {value} ({(value * 100.0 / total):F1}%)" : $"{name} — {value}";
}

<style>
    /* ================= HERO HEADER ================= */
    .dash-hero{position:relative;overflow:hidden;border-radius:16px;padding:16px 20px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;color:#fff;
        background:linear-gradient(120deg,#1e3a8a 0%,#2c4fbf 48%,#4f6ef2 100%);
        box-shadow:0 14px 30px -16px rgba(37,72,190,.75)}
    .dash-hero::before{content:"";position:absolute;right:-60px;top:-90px;width:250px;height:250px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.22),rgba(255,255,255,0) 70%);pointer-events:none}
    .dash-hero::after{content:"";position:absolute;left:28%;bottom:-100px;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(46,197,206,.35),rgba(255,255,255,0) 70%);pointer-events:none}
    .dash-hero-left{display:flex;align-items:center;gap:14px;position:relative;z-index:1}
    .dash-hero-icon{width:48px;height:48px;border-radius:14px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.28);display:flex;align-items:center;justify-content:center;font-size:23px;flex-shrink:0}
    .dash-hero-title{margin:0;font-weight:800;font-size:1.3rem;letter-spacing:.2px}
    .dash-hero-sub{font-size:12px;opacity:.82}
    .dash-hero-right{display:flex;align-items:center;gap:10px;position:relative;z-index:1;flex-wrap:wrap}
    .dash-hero-chip{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.3);color:#fff;font-size:12px;font-weight:600;padding:5px 12px;border-radius:20px}
    .dash-hero-updated{font-size:11.5px;opacity:.85}
    .dash-hero-btn{background:rgba(255,255,255,.96);color:#1e3a8a;font-weight:700;font-size:12.5px;border-radius:10px;border:0;padding:7px 14px;transition:transform .14s ease,background .14s ease}
    .dash-hero-btn:hover{background:#fff;color:#1e3a8a;transform:translateY(-1px)}

    /* ================= KPI CARDS ================= */
    .dash-kpi{position:relative;overflow:hidden;background:#fff;border-radius:14px;border:1px solid #eef2f7;padding:15px 16px 15px 20px;display:flex;justify-content:space-between;align-items:center;
        box-shadow:0 3px 12px -8px rgba(15,23,42,.28);min-height:92px;transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}
    .dash-kpi::before{content:"";position:absolute;left:0;top:15px;bottom:15px;width:4px;border-radius:0 4px 4px 0;background:var(--acc,#4f6ef2)}
    .dash-kpi::after{content:"";position:absolute;right:-38px;top:-38px;width:118px;height:118px;border-radius:50%;background:var(--acc,#4f6ef2);opacity:.07;pointer-events:none}
    .dash-kpi-label{font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px}
    .dash-kpi-value{font-size:25px;font-weight:800;color:#0f172a;line-height:1}
    .dash-kpi-sub{font-size:10px;color:#94a3b8;margin-top:4px}
    .dash-kpi-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:19px;flex-shrink:0;position:relative;z-index:1;
        background:linear-gradient(135deg,var(--acc,#4f6ef2),rgba(0,0,0,.24));
        box-shadow:0 10px 18px -10px var(--acc,#4f6ef2)}

    /* ================= CARDS ================= */
    .dash-card{background:#fff;border-radius:14px;border:1px solid #eef2f7;height:100%;display:flex;flex-direction:column;
        box-shadow:0 3px 14px -10px rgba(15,23,42,.28);transition:box-shadow .16s ease,transform .16s ease}
    .dash-card:hover{box-shadow:0 14px 30px -18px rgba(15,23,42,.45)}
    .dash-card-head{padding:13px 16px;border-bottom:1px solid #f1f5f9;font-size:13px;font-weight:700;color:#1e293b;
        background:linear-gradient(180deg,#fbfcff,#f6f8fd);border-radius:14px 14px 0 0}
    .dash-card-body{padding:16px;flex:1}

    /* ================= SECTION TITLE ================= */
    .dash-sec-title{display:flex;align-items:center;gap:9px;font-size:12px;font-weight:800;color:#475569;text-transform:uppercase;letter-spacing:.6px;margin:0 0 11px}
    .dash-sec-title::before{content:"";width:4px;height:16px;border-radius:3px;background:linear-gradient(180deg,#4f6ef2,#2ec5ce)}
    .dash-sec-title i{color:#4f6ef2}

    .dash-bars{display:flex;align-items:flex-end;gap:8px;height:180px}
    .dash-bar{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;min-width:0}
    .dash-bar-val{font-size:10px;font-weight:700;color:#334155;margin-bottom:3px}
    .dash-bar-fill{width:100%;max-width:42px;border-radius:6px 6px 0 0;background:linear-gradient(180deg,#6b86f7,#2a48c8);transition:height .4s;min-height:2px;box-shadow:0 -2px 8px -3px rgba(79,110,242,.6)}
    .dash-bar-lbl{font-size:10px;color:#64748b;margin-top:6px;white-space:nowrap}

    .dash-donut{width:150px;height:150px;border-radius:50%;margin:0 auto;position:relative;box-shadow:0 14px 28px -18px rgba(15,23,42,.6)}
    .dash-donut-center{position:absolute;inset:12px;background:#fff;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:inset 0 0 0 1px #f1f5f9}
    .dash-donut-num{font-size:27px;font-weight:800;color:#0f172a;line-height:1}
    .dash-donut-lbl{font-size:9px;color:#64748b;text-transform:uppercase;font-weight:700;letter-spacing:.5px;margin-top:2px}
    .dash-legend{list-style:none;margin:14px 0 0;padding:0;display:flex;flex-direction:column;gap:7px}
    .dash-legend li{display:flex;align-items:center;gap:8px;font-size:12px;color:#334155}
    .dash-legend .dot{width:10px;height:10px;border-radius:3px;flex-shrink:0}
    .dash-legend .ln{flex:1}
    .dash-legend .cnt{font-weight:700}

    .dash-hrow{margin-bottom:12px}
    .dash-hrow-top{display:flex;justify-content:space-between;font-size:12px;color:#334155;margin-bottom:5px;gap:10px}
    .dash-hrow-top .nm{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .dash-hrow-track{height:22px;background:#eef2f7;border-radius:6px;overflow:hidden}
    .dash-hrow-fill{height:100%;border-radius:6px;display:flex;align-items:center;padding:0 8px;color:#fff;font-weight:700;font-size:11px;white-space:nowrap;transition:width .4s;box-shadow:0 4px 10px -5px rgba(15,23,42,.5)}

    .dash-empty{color:#94a3b8;font-size:12px;text-align:center;padding:22px 10px}
    .dash-empty i{display:block;font-size:26px;opacity:.5;margin-bottom:6px}

    .dash-recent{font-size:12px}
    .dash-recent th{font-size:10px;text-transform:uppercase;color:#64748b;border-bottom:1px solid #e2e8f0;padding:7px 10px;white-space:nowrap;background:#f8fafc}
    .dash-recent td{font-size:12px;padding:8px 10px;border-bottom:1px solid #f1f5f9;color:#334155}
    .dash-recent tbody tr{transition:background .12s ease}
    .dash-recent tbody tr:hover{background:#f6f9ff}

    .dash-badge{display:inline-block;padding:2px 8px;border-radius:20px;font-size:10.5px;font-weight:700}

    .dash-link{display:block;text-decoration:none;color:inherit}
    .dash-link:hover .dash-kpi{transform:translateY(-3px);border-color:#c7d2fe;box-shadow:0 16px 28px -18px rgba(79,110,242,.6)}
    .dash-chip{background:#eef2f7;border:1px solid #e2e8f0;color:#475569;font-size:12px;font-weight:600;padding:4px 10px;border-radius:20px}
    .dash-chip:hover{background:#e3eaf6;color:#1e3a8a}

    /* ---- Hover tooltip ---- */
    .dash-tip{position:fixed;z-index:2100;pointer-events:none;left:0;top:0;background:#0f172a;color:#fff;font-size:11.5px;line-height:1.35;padding:6px 10px;border-radius:8px;box-shadow:0 6px 18px rgba(15,23,42,.28);opacity:0;transform:translateY(3px);transition:opacity .12s ease,transform .12s ease;white-space:nowrap;max-width:260px}
    .dash-tip.show{opacity:1;transform:translateY(0)}
    .dash-tip .t-mut{color:#94a3b8}

    /* hover cues */
    .dash-bar{cursor:default;border-radius:6px}
    .dash-bar:hover .dash-bar-fill{filter:brightness(1.1);box-shadow:0 0 0 2px rgba(79,110,242,.18)}
    .dash-hrow:hover .dash-hrow-track{background:#e6ebf3}
    .dash-hrow:hover .dash-hrow-fill{filter:brightness(1.05)}
    .dash-donut{cursor:default}
    .dash-donut:hover{filter:brightness(1.02)}
    .dash-legend li{padding:2px 4px;border-radius:7px;transition:background .12s}
    .dash-legend li:hover{background:#f1f5f9}
</style>

<!-- ================= HERO HEADER ================= -->
<div class="dash-hero mb-3">
    <div class="dash-hero-left">
        <div class="dash-hero-icon"><i class="bi bi-speedometer2"></i></div>
        <div>
            <h4 class="dash-hero-title">CRM Dashboard</h4>
            <div class="dash-hero-sub">Clients, visits &amp; leads</div>
        </div>
    </div>
    <div class="dash-hero-right">
        <span class="dash-hero-chip"><i class="bi bi-people me-1"></i>@Model.ActiveUsers/@Model.TotalUsers users</span>
        <span class="dash-hero-updated"><i class="bi bi-clock me-1"></i>Updated: @Model.GeneratedOn.ToString("dd MMM yyyy, hh:mm tt")</span>
        <a href="/Dashboard" class="btn dash-hero-btn"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</a>
    </div>
</div>

<!-- ================= SECTION: CLIENTS & VISITS ================= -->
<div class="dash-sec-title"><i class="bi bi-building"></i>Clients &amp; Visits</div>
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="dash-kpi" style="--acc:#f59e0b">
            <div>
                <div class="dash-kpi-label">Total Clients</div>
                <div class="dash-kpi-value">@Model.TotalClients</div>
                <div class="dash-kpi-sub">+@Model.NewClientsThisMonth this month</div>
            </div>
            <div class="dash-kpi-icon"><i class="bi bi-building"></i></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="dash-kpi" style="--acc:#ef4444">
            <div>
                <div class="dash-kpi-label">Active Clients</div>
                <div class="dash-kpi-value">@Model.ActiveClients</div>
                <div class="dash-kpi-sub">visited at least once</div>
            </div>
            <div class="dash-kpi-icon"><i class="bi bi-person-check"></i></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="dash-kpi" style="--acc:#8b5cf6">
            <div>
                <div class="dash-kpi-label">Total Visits</div>
                <div class="dash-kpi-value">@Model.TotalVisits</div>
                <div class="dash-kpi-sub">@Model.VisitsThisMonth this month</div>
            </div>
            <div class="dash-kpi-icon"><i class="bi bi-signpost-split"></i></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="dash-kpi" style="--acc:#10b981">
            <div>
                <div class="dash-kpi-label">Today's Visits</div>
                <div class="dash-kpi-value">@Model.VisitsToday</div>
                <div class="dash-kpi-sub">as of now</div>
            </div>
            <div class="dash-kpi-icon"><i class="bi bi-calendar-check"></i></div>
        </div>
    </div>
</div>

<!-- ================= KPI: LEADS ================= -->
<div class="dash-sec-title"><i class="bi bi-person-lines-fill"></i>Leads Pipeline</div>
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="dash-kpi" style="--acc:#4f6ef2">
            <div>
                <div class="dash-kpi-label">Total Leads</div>
                <div class="dash-kpi-value">@Model.TotalLeads</div>
                <div class="dash-kpi-sub">+@Model.NewLeadsThisMonth this month</div>
            </div>
            <div class="dash-kpi-icon"><i class="bi bi-person-lines-fill"></i></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="dash-kpi" style="--acc:#f59e0b">
            <div>
                <div class="dash-kpi-label">Open Leads</div>
                <div class="dash-kpi-value" style="color:#f59e0b;">@Model.OpenLeads</div>
                <div class="dash-kpi-sub">in pipeline</div>
            </div>
            <div class="dash-kpi-icon"><i class="bi bi-hourglass-split"></i></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="dash-kpi" style="--acc:#10b981">
            <div>
                <div class="dash-kpi-label">Converted</div>
                <div class="dash-kpi-value" style="color:#198754;">@Model.ConvertedLeads</div>
                <div class="dash-kpi-sub">became clients</div>
            </div>
            <div class="dash-kpi-icon"><i class="bi bi-check-circle"></i></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="dash-kpi" style="--acc:#8b5cf6">
            <div>
                <div class="dash-kpi-label">Open Pipeline Value</div>
                <div class="dash-kpi-value" style="color:#6f42c1;font-size:22px;">@("₹" + Model.PipelineValue.ToString("N0"))</div>
                <div class="dash-kpi-sub">deal value in progress</div>
            </div>
            <div class="dash-kpi-icon"><i class="bi bi-cash-stack"></i></div>
        </div>
    </div>
</div>

<!-- ================= CHARTS ROW 1 ================= -->
<div class="row g-3 mb-3">
    @* Monthly visits bar *@
    <div class="col-lg-6 col-md-6">
        <div class="dash-card">
            <div class="dash-card-head"><i class="bi bi-bar-chart-fill me-2" style="color:#4f6ef2;"></i>Visits - Last 6 Months</div>
            <div class="dash-card-body">
                @if (Model.MonthlyVisits.Count > 0)
                {
                    var max = MaxValue(Model.MonthlyVisits);
                    <div class="dash-bars">
                        @foreach (var item in Model.MonthlyVisits)
                        {
                            <div class="dash-bar" data-tip="@item.Name — @item.Value visits">
                                <span class="dash-bar-val">@item.Value</span>
                                <div class="dash-bar-fill" style="height:@(BarHeight(item.Value, max))%;"></div>
                                <span class="dash-bar-lbl">@item.Name</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="dash-empty"><i class="bi bi-bar-chart"></i>No visit data yet.</div>
                }
            </div>
        </div>
    </div>

    @* Leads by status donut *@
    <div class="col-lg-6 col-md-12">
        <div class="dash-card">
            <div class="dash-card-head"><i class="bi bi-funnel-fill me-2" style="color:#2ec5ce;"></i>Leads by Status</div>
            <div class="dash-card-body">
                @if (Model.LeadStatuses.Count > 0)
                {
                    var tot = Sum(Model.LeadStatuses);
                    <div class="dash-donut" data-segments="@SegmentsJson(Model.LeadStatuses, tot)" style="@DonutStyle(Model.LeadStatuses, tot)">
                        <div class="dash-donut-center">
                            <span class="dash-donut-num">@tot</span>
                            <span class="dash-donut-lbl">Leads</span>
                        </div>
                    </div>
                    <ul class="dash-legend">
                        @for (int i = 0; i < Model.LeadStatuses.Count; i++)
                        {
                            <li data-tip="@LegendTip(Model.LeadStatuses[i].Name, Model.LeadStatuses[i].Value, tot)">
                                <span class="dot" style="background:@Color(i);"></span>
                                <span class="ln">@Model.LeadStatuses[i].Name</span>
                                <span class="cnt">@Model.LeadStatuses[i].Value</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="dash-empty"><i class="bi bi-funnel"></i>No leads yet.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ================= CHARTS ROW 2 ================= -->
<div class="row g-3 mb-3">
    @* Top clients hbar *@
    <div class="col-lg-6 col-md-12">
        <div class="dash-card">
            <div class="dash-card-head"><i class="bi bi-trophy-fill me-2" style="color:#f59e0b;"></i>Top 5 Clients by Visits</div>
            <div class="dash-card-body">
                @if (Model.TopClients.Count > 0)
                {
                    var max = MaxValue(Model.TopClients);
                    @for (int i = 0; i < Model.TopClients.Count; i++)
                    {
                        <div class="dash-hrow" data-tip="@Model.TopClients[i].Name — @Model.TopClients[i].Value visits">
                            <div class="dash-hrow-top">
                                <span class="nm">@(i + 1). @Model.TopClients[i].Name</span>
                                <span><b>@Model.TopClients[i].Value</b> visits</span>
                            </div>
                            <div class="dash-hrow-track">
                                <div class="dash-hrow-fill" style="width:@(HBarWidth(Model.TopClients[i].Value, max))%;background:@Color(i);">
                                    @if (HBarWidth(Model.TopClients[i].Value, max) > 15) { @Model.TopClients[i].Value }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="dash-empty"><i class="bi bi-trophy"></i>No visits recorded yet.</div>
                }
            </div>
        </div>
    </div>

    @* Leads by city hbar *@
    <div class="col-lg-6 col-md-12">
        <div class="dash-card">
            <div class="dash-card-head"><i class="bi bi-geo-alt-fill me-2" style="color:#8b5cf6;"></i>Top Cities by Leads</div>
            <div class="dash-card-body">
                @if (Model.LeadCities.Count > 0)
                {
                    var max = MaxValue(Model.LeadCities);
                    @for (int i = 0; i < Model.LeadCities.Count; i++)
                    {
                        <div class="dash-hrow" data-tip="@Model.LeadCities[i].Name — @Model.LeadCities[i].Value leads">
                            <div class="dash-hrow-top">
                                <span class="nm">@Model.LeadCities[i].Name</span>
                                <span><b>@Model.LeadCities[i].Value</b> leads</span>
                            </div>
                            <div class="dash-hrow-track">
                                <div class="dash-hrow-fill" style="width:@(HBarWidth(Model.LeadCities[i].Value, max))%;background:@Color(i);">
                                    @if (HBarWidth(Model.LeadCities[i].Value, max) > 15) { @Model.LeadCities[i].Value }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="dash-empty"><i class="bi bi-geo-alt"></i>No leads yet.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ================= RECENT LEADS ================= -->
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="dash-card">
            <div class="dash-card-head d-flex justify-content-between align-items-center">
                <span><i class="bi bi-person-lines-fill me-2" style="color:#4f6ef2;"></i>Recent Leads</span>
                <a href="/Leads" class="dash-chip text-decoration-none" style="font-size:11px;">View all <i class="bi bi-arrow-right-short"></i></a>
            </div>
            <div class="dash-card-body p-0">
                @if (Model.RecentLeads.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table dash-recent mb-0">
                            <thead>
                                <tr>
                                    <th>Lead</th>
                                    <th>Company</th>
                                    <th>City</th>
                                    <th>Status</th>
                                    <th>Deal Value</th>
                                    <th>Added</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in Model.RecentLeads)
                                {
                                    <tr>
                                        <td class="fw-semibold" style="color:#0f172a;">@(string.IsNullOrWhiteSpace(l.LeadPerson) ? "—" : l.LeadPerson)</td>
                                        <td>@(string.IsNullOrWhiteSpace(l.Company) ? "—" : l.Company)</td>
                                        <td>@(string.IsNullOrWhiteSpace(l.City) ? "—" : l.City)</td>
                                        <td>
                                            @if (l.IsConverted)
                                            {
                                                <span class="dash-badge" style="background:#dcfce7;color:#15803d;">Converted</span>
                                            }
                                            else
                                            {
                                                <span class="dash-badge" style="background:#eef2f7;color:#475569;">@(string.IsNullOrWhiteSpace(l.Status) ? "New" : l.Status)</span>
                                            }
                                        </td>
                                        <td>@(l.DealValue > 0 ? "₹" + l.DealValue.ToString("N0") : "—")</td>
                                        <td class="text-muted">@(string.IsNullOrWhiteSpace(l.CreatedOn) ? "—" : l.CreatedOn)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="dash-empty"><i class="bi bi-inbox"></i>No leads yet.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ================= HOVER TOOLTIP ================= -->
<div id="dashTip" class="dash-tip" role="tooltip" aria-hidden="true"></div>

<script>
    /* Dashboard charts: hover pe data tooltip.
       Document-level listeners sirf ek baar bind hote hain (AJAX navigation
       pe scripts dobara chalte hain, is liye guard lagaya hai). */
    (function () {
        if (window.__dashTipsBound) return;
        window.__dashTipsBound = true;

        function tipEl() { return document.getElementById("dashTip"); }

        function esc(s) {
            return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) {
                return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
            });
        }

        function place(t, x, y) {
            var pad = 14, w = t.offsetWidth, h = t.offsetHeight;
            var left = x + pad, top = y - h - pad;
            if (left + w > window.innerWidth - 8) left = x - w - pad;
            if (left < 8) left = 8;
            if (top < 8) top = y + pad;
            t.style.left = left + "px";
            t.style.top = top + "px";
        }

        function show(t, html, x, y) {
            if (t.__last !== html) { t.innerHTML = html; t.__last = html; }
            if (!t.classList.contains("show")) t.classList.add("show");
            place(t, x, y);
        }

        function hide(t) {
            if (!t) return;
            t.__last = null;
            t.classList.remove("show");
        }

        /* Donut: cursor ke angle se kaunsa segment hai, wo nikalta hai. */
        function donutHit(donut, ev) {
            var segs = [];
            try { segs = JSON.parse(donut.getAttribute("data-segments") || "[]"); } catch (e) { return null; }
            if (!segs.length) return null;

            var rect = donut.getBoundingClientRect();
            var cx = rect.left + rect.width / 2, cy = rect.top + rect.height / 2;
            var dx = ev.clientX - cx, dy = ev.clientY - cy;
            var dist = Math.sqrt(dx * dx + dy * dy);
            var outer = rect.width / 2;
            if (dist > outer || dist < outer * 0.82) return null;   /* sirf ring */

            var ang = (Math.atan2(dy, dx) * 180 / Math.PI + 90 + 360) % 360;  /* 0 = top, clockwise */
            var cum = 0;
            for (var i = 0; i < segs.length; i++) {
                var start = cum;
                cum += segs[i].pct;
                if (ang >= start && ang < cum) return segs[i];
            }
            return null;
        }

        document.addEventListener("mousemove", function (ev) {
            var t = tipEl();
            if (!t || !ev.target || !ev.target.closest) return;

            /* 1) donut segments */
            var donut = ev.target.closest(".dash-donut[data-segments]");
            if (donut) {
                var seg = donutHit(donut, ev);
                if (seg) {
                    show(t, "<b>" + esc(seg.name) + "</b> &nbsp; " + esc(seg.value) +
                            " <span class=\"t-mut\">(" + seg.pct.toFixed(1) + "%)</span>",
                         ev.clientX, ev.clientY);
                    return;
                }
            }

            /* 2) koi bhi element jis pe data-tip ho */
            var el = ev.target.closest("[data-tip]");
            if (el) {
                show(t, esc(el.getAttribute("data-tip")), ev.clientX, ev.clientY);
                return;
            }

            hide(t);
        }, { passive: true });

        /* Mouse window se bahar ya page chhodne pe tip chhupa do */
        document.addEventListener("mouseleave", function () { hide(tipEl()); });
        window.addEventListener("blur", function () { hide(tipEl()); });
    })();
</script>