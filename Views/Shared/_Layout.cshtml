<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Client Visit Management</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/import.css" />
</head>
<body>

    @* Har page par antiforgery token - Ajax.post() / delete links ise padhte hain *@
    @Html.AntiForgeryToken()

    <!-- =====================================================
         SIDEBAR
         ===================================================== -->
    <div class="sidebar">
        <!-- SIDEBAR HEADER -->
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <div class="sidebar-logo" id="sidebarToggle" role="button" tabindex="0" title="Collapse / Expand Menu">
                    <i class="bi bi-grid-1x2-fill"></i>
                </div>
                <div class="sidebar-brand-text">
                    <span class="sidebar-brand-name">CRM</span>
                    <span class="sidebar-brand-sub">Customer Relationship Management</span>
                </div>
            </div>
        </div>

        <!-- =================================================
             OVERVIEW
             ================================================= -->
        <div class="sidebar-section-title">
            <span>OVERVIEW</span>
        </div>

        <!-- CRM DASHBOARD -->
        <a class="nav-link nav-dashboard" href="/Dashboard">
            <i class="bi bi-speedometer2 ic-dash"></i>
            <span>Dashboard</span>
        </a>

        <!-- LOGGED-IN USER (compact profile card, Dashboard ke niche) -->
        @{
            var _fullName = Context.Session.GetString("FullName");
            var _loggedInUser = string.IsNullOrWhiteSpace(_fullName) ? User.Identity?.Name : _fullName;
            var _userRole = Context.Session.GetString("Role");
            var _initial = string.IsNullOrWhiteSpace(_loggedInUser) ? "U" : _loggedInUser!.Trim().Substring(0, 1).ToUpper();
        }
        <div class="sidebar-user" title="@_loggedInUser (@_userRole)">
            <div class="sidebar-avatar">@_initial</div>
            <div class="sidebar-user-text">
                <span class="sidebar-user-name">@_loggedInUser</span>
                <span class="sidebar-user-role">@(string.IsNullOrWhiteSpace(_userRole) ? "User" : _userRole)</span>
            </div>
        </div>

        <!-- =================================================
             MASTER MODULES
             ================================================= -->
        <div class="nav-group" data-nav-group>
            <button type="button" class="sidebar-section-title nav-group-toggle" aria-expanded="true">
                <span>MASTER MODULES</span>
                <i class="bi bi-chevron-down nav-group-caret"></i>
            </button>
            <div class="nav-group-items">
                <!-- CLIENT MASTER -->
                <a class="nav-link" href="/Client">
                    <i class="bi bi-building ic-client"></i>
                    <span>Client Master</span>
                </a>

                <!-- USER MASTER -->
                <a class="nav-link" href="/User">
                    <i class="bi bi-people-fill ic-user"></i>
                    <span>User Master</span>
                </a>

                <!-- STATE MASTER -->
                <a class="nav-link" href="/StateMaster">
                    <i class="bi bi-geo-alt-fill ic-state"></i>
                    <span>State Master</span>
                </a>
            </div>
        </div>

        <!-- =================================================
             CRM
             ================================================= -->
        <div class="nav-group" data-nav-group>
            <button type="button" class="sidebar-section-title nav-group-toggle" aria-expanded="true">
                <span>CRM</span>
                <i class="bi bi-chevron-down nav-group-caret"></i>
            </button>
            <div class="nav-group-items">
                <!-- LEADS -->
                <a class="nav-link" href="/Leads">
                    <i class="bi bi-person-lines-fill ic-vreport"></i>
                    <span>Leads</span>
                </a>

                <!-- DAILY FOLLOW UP -->
                <a class="nav-link" href="/DailyFollowUp">
                    <i class="bi bi-calendar2-check-fill ic-followup"></i>
                    <span>Daily Follow Up</span>
                </a>

                <!-- DAILY REPORT -->
                <a class="nav-link" href="/DailyReport">
                    <i class="bi bi-clipboard-data-fill ic-dss"></i>
                    <span>Daily Report</span>
                </a>
            </div>
        </div>

        <!-- =================================================
             TRANSACTION MODULES
             ================================================= -->
        <div class="nav-group" data-nav-group>
            <button type="button" class="sidebar-section-title nav-group-toggle" aria-expanded="true">
                <span>TRANSACTION MODULES</span>
                <i class="bi bi-chevron-down nav-group-caret"></i>
            </button>
            <div class="nav-group-items">
                <!-- CLIENT VISIT DETAILS - YE AAPKA DASHBOARD HAI -->
                <a class="nav-link" href="/ClientVisit">
                    <i class="bi bi-signpost-split-fill ic-visit"></i>
                    <span>Client Visit Details</span>
                </a>

                <!-- DAILY SUPPORT SYSTEM - FIX KIYA -->
                <a class="nav-link" href="/DailySupport">
                    <i class="bi bi-headset ic-support"></i>
                    <span>Daily Support System</span>
                </a>
            </div>
        </div>

        <!-- =================================================
             ANALYTICS & REPORTS
             ================================================= -->
        <div class="nav-group" data-nav-group>
            <button type="button" class="sidebar-section-title nav-group-toggle" aria-expanded="true">
                <span>ANALYTICS &amp; REPORTS</span>
                <i class="bi bi-chevron-down nav-group-caret"></i>
            </button>
            <div class="nav-group-items">
                <!-- CLIENT VISIT REPORT - YE FULL REPORT HAI -->
                <a class="nav-link" href="/ClientVisit/ClientVisitReport">
                    <i class="bi bi-file-earmark-bar-graph-fill ic-vreport"></i>
                    <span>Client Visit Report</span>
                </a>

                <!-- MIS REPORTS - DSS Reports bhi DailySupport se -->
                <a class="nav-link" href="/DailySupport/DSSReports">
                    <i class="bi bi-bar-chart-line-fill ic-dss"></i>
                    <span>DSS Reports</span>
                </a>
            </div>
        </div>

        <!-- =================================================
             TOOLS
             ================================================= -->
        <div class="nav-group" data-nav-group data-nav-default="closed">
            <button type="button" class="sidebar-section-title nav-group-toggle" aria-expanded="false">
                <span>TOOLS</span>
                <i class="bi bi-chevron-down nav-group-caret"></i>
            </button>
            <div class="nav-group-items">
                <!-- IMPORT EXCEL / CSV -->
                <a class="nav-link" href="/Import">
                    <i class="bi bi-file-earmark-spreadsheet-fill ic-import"></i>
                    <span>Import</span>
                </a>
            </div>
        </div>

        <!-- SIDEBAR FOOTER : LOGOUT at bottom -->
        <div class="sidebar-footer">
            <a href="/Account/Logout" class="logout-btn sidebar-logout">
                <i class="bi bi-box-arrow-right"></i>
                <span class="logout-text">Logout</span>
            </a>
        </div>
    </div>

    <!-- =====================================================
         MAIN CONTENT - Yahi par DailySupport ka Index.cshtml Render Hoga
         ===================================================== -->
    <div class="main-content" id="mainContentArea">
        @RenderBody()
    </div>

    <!-- =====================================================
         SHARED FORM MODAL
         Add / Edit forms poore page ki jagah yahan popup me khulte hain
         ===================================================== -->
    <div class="modal fade" id="appFormModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" style="max-width:900px;">
            <div class="modal-content" style="border-radius:14px; overflow:hidden;">
                <div class="modal-header align-items-center">
                    <button type="button" class="btn btn-sm btn-light border" id="appFormModalBack">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </button>
                    <h6 class="modal-title fw-bold ms-3 me-auto" id="appFormModalTitle">Form</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="appFormModalBody">
                    <div class="text-center py-5 text-muted">Loading…</div>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Compact look inside the shared form modal */
        #appFormModal .modal-header { padding: .45rem .85rem; }
        #appFormModal .modal-title { font-size: .9rem; }
        #appFormModal .modal-body { font-size: 12.5px; padding: 12px 16px; }
        #appFormModal .form-label { font-size: 11.5px; margin-bottom: 2px; }
        #appFormModal .form-control,
        #appFormModal .form-select { font-size: 12.5px; padding: .26rem .5rem; height: auto; min-width: 0; }
        #appFormModal .form-control-sm,
        #appFormModal .form-select-sm { font-size: 12px; padding: .2rem .45rem; }
        #appFormModal textarea.form-control { min-height: 56px; }
        #appFormModal h4 { font-size: 1rem; margin-bottom: .5rem !important; }
        #appFormModal h5 { font-size: .95rem; }
        #appFormModal h6 { font-size: .85rem; margin-bottom: .35rem; }
        #appFormModal .mb-3 { margin-bottom: .5rem !important; }
        #appFormModal .card-section { padding: .65rem !important; }
        #appFormModal .card-body { padding: .75rem !important; }
        #appFormModal .row { --bs-gutter-x: .6rem; --bs-gutter-y: .6rem; }
        /* Flex columns shrink ho sakein -> modal me horizontal scroll na aaye */
        #appFormModal [class*="col-"] { min-width: 0; }
        #appFormModal .ss-wrap,
        #appFormModal .ss-input { max-width: 100%; }
        /* Wider modal for detail popups (Lead view, etc.) so everything is visible */
        #appFormModal .modal-dialog.app-modal-wide { max-width: 1100px; }
        /* Compact modal for pipeline quick actions */
        #appFormModal .modal-dialog.app-modal-narrow { max-width: 520px; }
    </style>

    <!-- =====================================================
         SCRIPTS
         ===================================================== -->
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/js/page-loader.js"></script>
    <script src="~/js/ajax-helper.js"></script>
    <script src="~/js/searchable-select.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- =====================================================
         SIDEBAR TOGGLE
         ===================================================== -->
    <script>
        const sidebarToggle = document.getElementById("sidebarToggle");
        sidebarToggle.addEventListener("click", function () {
            document.body.classList.toggle("sidebar-collapsed");
        });
        sidebarToggle.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                document.body.classList.toggle("sidebar-collapsed");
            }
        });
    </script>

    <!-- =====================================================
         AJAX NAVIGATION - Sidebar /Client, /User, /StateMaster
         ===================================================== -->
    <script>
        (function () {
            var masterPaths = ["/Dashboard", "/Client", "/User", "/StateMaster", "/Leads", "/DailyFollowUp", "/DailyReport", "/ClientVisit", "/DailySupport", "/FollowUp", "/ClientVisit/ClientVisitReport", "/DailySupport/DSSReports", "/Import"];

            function reExecuteScripts(container) {
                container.querySelectorAll("script").forEach(function (oldScript) {
                    var freshScript = document.createElement("script");
                    if (oldScript.src) {
                        freshScript.src = oldScript.src;
                    } else {
                        freshScript.textContent = oldScript.textContent;
                    }
                    oldScript.replaceWith(freshScript);
                });
            }

            function loadPage(url, label) {
                var text = label ? "Loading " + label + "\u2026" : "Loading\u2026";
                PageLoader.show(text);

                // FIX: modal ke andar se Edit/jaisi navigation karne par modal
                // khula reh jata tha aur Bootstrap ka dark backdrop poore page
                // ko dark bana deta tha. Yaha saare open modals + backdrop hata dete hain.
                document.querySelectorAll(".modal.show").forEach(function (m) {
                    var inst = (window.bootstrap && bootstrap.Modal.getInstance) ? bootstrap.Modal.getInstance(m) : null;
                    if (inst) { try { inst.hide(); } catch (e) { } try { inst.dispose(); } catch (e) { } }
                    m.classList.remove("show");
                    m.classList.remove("fade");
                    m.style.display = "none";
                    m.setAttribute("aria-hidden", "true");
                    m.removeAttribute("aria-modal");
                });
                document.querySelectorAll(".modal-backdrop").forEach(function (b) { b.remove(); });
                document.body.classList.remove("modal-open");
                document.body.style.removeProperty("overflow");
                document.body.style.removeProperty("padding-right");

                return fetch(url, {
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                })
                .then(function (response) {
                    if (!response.ok) throw new Error("HTTP " + response.status);
                    return response.text();
                })
                .then(function (html) {
                    var main = document.getElementById("mainContentArea");
                    if (!main) { PageLoader.hide(true); window.location.href = url; return; }
                    main.innerHTML = html;
                    reExecuteScripts(main);
                    window.history.pushState({ url: url }, "", url);
                    window.scrollTo(0, 0);
                    PageLoader.hide();
                })
                .catch(function (err) {
                    console.error("AJAX navigation failed:", err);
                    PageLoader.hide(true);
                    window.location.href = url;
                });
            }

            document.addEventListener("click", function (event) {
                if (event.defaultPrevented || event.button !== 0 ||
                    event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                    return;
                }
                var link = event.target.closest("a.nav-link");
                if (!link) return;
                var href = link.getAttribute("href");
                if (!href) return;
                var path = href.split("?")[0];
                if (masterPaths.indexOf(path) === -1) return;
                event.preventDefault();

                var text = link.querySelector("span");
                loadPage(href, text ? text.textContent.trim() : null);
            });

            window.addEventListener("popstate", function () {
                loadPage(window.location.pathname + window.location.search);
            });

            window.loadPage = loadPage;
        })();
    </script>

    <!-- =====================================================
         CLEAN PRINT — sirf table/data print ho, Actions column na aaye
         (Company page jaisa: naye window me sirf table likh ke print)
         ===================================================== -->
    <script>
        window.printTable = function (containerId, title) {
            var container = document.getElementById(containerId);
            var table = container ? container.querySelector("table") : null;
            if (!table) { window.print(); return; }

            var clone = table.cloneNode(true);

            // Actions column (view/edit/delete buttons) print nahi honi chahiye
            clone.querySelectorAll(".actions-col, .actions-cell, .no-print").forEach(function (n) { n.remove(); });
            clone.querySelectorAll("button, select, .dropdown, .pagination, .records-per-page").forEach(function (n) { n.remove(); });

            // Fixed widths hata do taaki table poori width me fit ho
            var cg = clone.querySelector("colgroup");
            if (cg) cg.remove();
            clone.style.width = "100%";
            clone.style.tableLayout = "auto";
            clone.querySelectorAll("th, td").forEach(function (c) {
                c.style.width = "";
                c.style.maxWidth = "";
                c.style.minWidth = "";
                c.removeAttribute("width");
            });

            var w = window.open("", "", "width=1100,height=800");
            if (!w) { window.print(); return; }

            // COMPACT PRINT - chhota font, kam padding, landscape (bade grid bhi ek page me)
            var css =
                "<style>" +
                "@@page{size:landscape;margin:8mm}" +
                "body{font-family:'Segoe UI',Arial,sans-serif;padding:10px;color:#0f172a;-webkit-print-color-adjust:exact;print-color-adjust:exact}" +
                "h4{margin:0 0 8px;font-size:14px;font-weight:700}" +
                "table{width:100%;border-collapse:collapse;font-size:10.5px}" +
                "thead th{background:#eef2f7;border:1px solid #cbd5e1;padding:4px 6px;text-align:left;font-weight:700;white-space:nowrap}" +
                "tbody td{border:1px solid #dfe6ee;padding:3px 6px;text-align:left;vertical-align:middle;white-space:normal!important;word-break:break-word}" +
                "tbody tr:nth-child(even){background:#f8fafc}" +
                "tbody tr{page-break-inside:avoid}" +
                // DSS report ke priority badges print me bhi rang me dikhein
                ".badge-pri-Urgent{background:#fee2e2;color:#dc2626;border:1px solid #fecaca;border-radius:5px;font-size:10px;padding:1px 5px;font-weight:600}" +
                ".badge-pri-High{background:#ffedd5;color:#ea580c;border:1px solid #fed7aa;border-radius:5px;font-size:10px;padding:1px 5px;font-weight:600}" +
                ".badge-pri-Medium{background:#fef3c7;color:#d97706;border:1px solid #fde68a;border-radius:5px;font-size:10px;padding:1px 5px;font-weight:600}" +
                ".badge-pri-Low{background:#dcfce7;color:#16a34a;border:1px solid #bbf7d0;border-radius:5px;font-size:10px;padding:1px 5px;font-weight:600}" +
                "</style>";

            w.document.write(
                "<html><head><meta charset='utf-8'><title>" + (title || "Print") + "</title>" + css + "</head><body>" +
                "<h4>" + (title || "") + "</h4>" + clone.outerHTML +
                "</body></html>"
            );
            w.document.close();
            w.focus();
            setTimeout(function () { w.print(); w.close(); }, 400);
        };
    </script>

    <!-- =====================================================
         SIDEBAR DROPDOWN GROUPS (collapsible)
         ===================================================== -->
    <script>
        (function () {
            var groups = Array.prototype.slice.call(document.querySelectorAll("[data-nav-group]"));
            if (!groups.length) return;

            function setOpen(group, open) {
                group.classList.toggle("collapsed", !open);
                var btn = group.querySelector(".nav-group-toggle");
                if (btn) btn.setAttribute("aria-expanded", open ? "true" : "false");
            }

            // Default: saare groups band, sirf jinme data-nav-default="open" ho wo khule
            groups.forEach(function (group) {
                setOpen(group, group.getAttribute("data-nav-default") === "open");
                var btn = group.querySelector(".nav-group-toggle");
                if (!btn) return;
                btn.addEventListener("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    setOpen(group, group.classList.contains("collapsed"));
                });
            });
        })();
    </script>

    <!-- =====================================================
         FORM MODAL (Add / Edit forms popup)
         ===================================================== -->
    <script src="~/js/form-modal.js" asp-append-version="true"></script>

</body>
</html>
